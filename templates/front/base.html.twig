<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>{% block title %}GéoMonkey{% endblock %}</title>

        {# ===================================================== #}
        {# SEO : description, canonical, Open Graph, Twitter     #}
        {# Chaque template peut surcharger n'importe quel bloc. #}
        {# ===================================================== #}
        <meta name="description" content="{% block meta_description %}GéoMonkey, association culturelle et conviviale : événements, ateliers et rencontres. Rejoins-nous !{% endblock %}">

        <link rel="canonical" href="{% block canonical %}{{ app.request.uri }}{% endblock %}">

        {# Open Graph (partages Facebook, WhatsApp, LinkedIn...) #}
        <meta property="og:type" content="{% block og_type %}website{% endblock %}">
        <meta property="og:site_name" content="GéoMonkey">
        <meta property="og:title" content="{{ block('title') }}">
        <meta property="og:description" content="{{ block('meta_description') }}">
        <meta property="og:url" content="{{ block('canonical') }}">
        <meta property="og:image" content="{% block og_image %}{{ absolute_url(asset('images/logo.png')) }}{% endblock %}">
        <meta property="og:locale" content="fr_FR">

        {# Twitter / X #}
        <meta name="twitter:card" content="summary_large_image">
        <meta name="twitter:title" content="{{ block('title') }}">
        <meta name="twitter:description" content="{{ block('meta_description') }}">
        <meta name="twitter:image" content="{{ block('og_image') }}">

        {# Bootstrap Icons #}
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.min.css">

        {# Favicon #}
        <link rel="icon" href="{{ asset('favicon.ico') }}">

        {% block stylesheets %}
            <style>
                /* Hero background image (ne peut pas être dans CSS statique) */
                .hero-section {
                    background-image: url('{{ asset("images/background.jpg") }}');
                }
            </style>
        {% endblock %}

        {# Données structurées : organisation (JSON-LD) #}
        <script type="application/ld+json">
        {
            "@context": "https://schema.org",
            "@type": "Organization",
            "name": "GéoMonkey",
            "url": "{{ url('app_home') }}",
            "logo": "{{ absolute_url(asset('images/logo.png')) }}",
            "description": "Association culturelle et conviviale : événements, ateliers et rencontres."
        }
        </script>
        {# FullCalendar — bundles globaux auto-hébergés (assets/vendor/fullcalendar/).
            La v6 injecte son CSS elle-même : pas de <link> CSS à charger.
            Scripts BLOQUANTS placés AVANT l'importmap : garantie absolue que
            window.FullCalendar (et sa locale fr) existent avant Stimulus. #}
        <script src="{{ asset('vendor/fullcalendar/index.global.min.js') }}"></script>
        <script src="{{ asset('vendor/fullcalendar/daygrid.global.min.js') }}"></script>
        <script src="{{ asset('vendor/fullcalendar/locales-fr.global.min.js') }}"></script>

        {# Importmap chargé dans HEAD pour éviter les conflits #}
        {% block importmap %}{{ importmap('app') }}{% endblock %}
    </head>
    <body data-turbo="false">
        {# Messages flash #}
        <div class="container mt-3">
            {% for type, messages in app.flashes %}
                {% for message in messages %}
                    <div class="alert alert-{{ type }} alert-dismissible fade show" role="alert">
                        {{ message }}
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                {% endfor %}
            {% endfor %}
        </div>

        {% block body %}{% endblock %}
        <footer class="bg-gm-surface text-center text-gm-warning py-3 mt-5">
            <div class="container">
                <p class="mb-1">&copy; {{ 'now'|date('Y') }} GéoMonkey - Tous droits réservés</p>
                <p class="mb-0 small">
                    <a href="{{ path('app_cgu') }}" class="text-gm-warning text-decoration-none">Conditions Générales d'Adhésion</a>
                    <span class="text-gm-muted mx-2">·</span>
                    <a href="{{ path('app_privacy') }}" class="text-gm-warning text-decoration-none">Politique de Confidentialité</a>
                </p>
            </div>
        </footer>

        {% block javascripts %}
        {% endblock %}
    </body>
</html>
