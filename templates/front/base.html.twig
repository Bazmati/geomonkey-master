<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>{% block title %}GéoMonkey{% endblock %}</title>
        
        {# Bootstrap Icons #}
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.min.css">
        
        {# Favicon #}
        <link rel="icon" href="{{ asset('favicon.ico') }}">
        
        {% block stylesheets %}{% endblock %}
        
        <style>
            .hero-section {
                background: linear-gradient(135deg, rgba(0,0,0,0.8) 0%, rgba(0,0,0,0.6) 100%),
                            url('{{ asset("images/background.jpg") }}') center/cover no-repeat;
                min-height: 70vh;
            }
            .hero-logo {
                max-width: 100%;
                height: auto;
            }
            .bg-surface {
                background-color: #f8f9fa;
            }
        </style>
    </head>
    <body>
        {# Messages flash #}
        <div class="container mt-3">
            {% for type, messages in app.flashes %}
                {% for message in messages %}
                    <div class="alert alert-{{ type }} alert-dismissible fade show" role="alert">
                        {{ message }}
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                {% endfor %}
            {% endfor %}
        </div>
        
        {% block body %}{% endblock %}
        <footer class="bg-dark text-center text-warning py-3 mt-5">
            <div class="container">
                <p class="mb-1">&copy; {{ 'now'|date('Y') }} GéoMonkey - Tous droits réservés</p>
                <p class="mb-0 small">
                    <a href="{{ path('app_cgu') }}" class="text-warning text-decoration-none">Conditions Générales d'Adhésion</a>
                    <span class="text-muted mx-2">·</span>
                    <a href="{{ path('app_privacy') }}" class="text-warning text-decoration-none">Politique de Confidentialité</a>
                </p>
            </div>
        </footer>
        
        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </body>
</html>
