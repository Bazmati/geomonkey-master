{% extends 'front/base.html.twig' %}

{% block title %}{{ 'nav.newsletter'|trans }} - GéoMonkey{% endblock %}

{% block body %}
    {% include 'partials/_navbar.html.twig' %}

    <div class="container py-5">
        <div class="row justify-content-center">
            <div class="col-lg-6">
                <div class="gm-legal-card text-center">
                    {% if status == 'ok' %}
                        <div style="font-size: 48px;">🐵</div>
                        <h1 class="h4 text-white mt-2">{{ 'newsletter.ok_title'|trans }}</h1>
                        <p class="mt-3">
                            {{ 'newsletter.ok_text'|trans({'%email%': email})|raw }}
                        </p>
                        <a href="{{ path('app_home') }}#newsletter" class="btn btn-gm-green mt-3">
                            <i class="bi bi-arrow-counterclockwise me-2"></i>{{ 'newsletter.resubscribe'|trans }}
                        </a>
                    {% elseif status == 'already' %}
                        <div style="font-size: 48px;">🐵</div>
                        <h1 class="h4 text-white mt-2">{{ 'newsletter.already_title'|trans }}</h1>
                        <p class="mt-3">
                            {{ 'newsletter.already_text'|trans({'%email%': email})|raw }}
                        </p>
                        <a href="{{ path('app_home') }}" class="btn btn-gm-surface mt-3">
                            <i class="bi bi-arrow-left me-2"></i>{{ 'legal.back_home'|trans }}
                        </a>
                    {% else %}
                        <div style="font-size: 48px;">🤔</div>
                        <h1 class="h4 text-white mt-2">{{ 'newsletter.unknown_title'|trans }}</h1>
                        <p class="mt-3">
                            {{ 'newsletter.unknown_text'|trans }}
                        </p>
                        <a href="{{ path('app_home') }}" class="btn btn-gm-surface mt-3">
                            <i class="bi bi-arrow-left me-2"></i>{{ 'legal.back_home'|trans }}
                        </a>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
{% endblock %}
