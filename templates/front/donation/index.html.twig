{% extends 'front/base.html.twig' %}

{% block title %}Faire un don - GéoMonkey{% endblock %}

{% block meta %}
    <meta name="description" content="Soutenir l'association GéoMonkey : chaque don finance directement nos événements culturels et nos projets collectifs. Merci !">
{% endblock %}

{% block body %}
{% include 'partials/_navbar.html.twig' %}

{# ===== Fond vidéo en boucle (fallback : aurores animées CSS) ===== #}
<div class="gm-join-bg" aria-hidden="true">
    <div class="gm-join-aurora gm-join-aurora-green"></div>
    <div class="gm-join-aurora gm-join-aurora-yellow"></div>
    <video class="gm-join-video" autoplay muted loop playsinline preload="metadata" tabindex="-1">
        <source src="{{ asset('videos/don.mp4') }}" type="video/mp4">
        <source src="{{ asset('videos/adhesion.mp4') }}" type="video/mp4">
    </video>
    <div class="gm-join-veil"></div>
</div>

<main class="gm-join position-relative">
    <div class="container py-5">
        <div class="row g-5 align-items-center justify-content-center min-vh-90 py-4">

            {# ===== Colonne pitch : pourquoi donner ===== #}
            <div class="col-lg-5 text-center text-lg-start">
                <span class="badge home-hero-badge mb-3">
                    <i class="bi bi-heart-fill me-1"></i> Faire un don
                </span>
                <h1 class="gm-join-title mb-3">Un petit geste,<br>une grande aventure</h1>
                <p class="gm-join-sub mb-4">
                    GéoMonkey est une association à but non lucratif : chaque
                    euro donné part directement dans les projets, le matériel
                    et les événements. Pas de salaires, pas de frais cachés —
                    juste des idées qui prennent vie.
                </p>

                <ul class="list-unstyled gm-join-benefits">
                    <li>
                        <i class="bi bi-tools"></i>
                        <div><strong>Matériel &amp; constructions</strong><br>
                        <span class="small">Bois, outils, consommables pour les chantiers collectifs</span></div>
                    </li>
                    <li>
                        <i class="bi bi-calendar-event"></i>
                        <div><strong>Événements accessibles</strong><br>
                        <span class="small">Les dons aident à garder les sorties et ateliers à petit prix</span></div>
                    </li>
                    <li>
                        <i class="bi bi-piggy-bank"></i>
                        <div><strong>100 % investi localement</strong><br>
                        <span class="small">Une gestion par des bénévoles, présentée en assemblée générale</span></div>
                    </li>
                    <li>
                        <i class="bi bi-receipt"></i>
                        <div><strong>Reçu de don</strong><br>
                        <span class="small">Un accusé de réception vous est délivré pour votre comptabilité</span></div>
                    </li>
                </ul>

                <p class="text-gm-muted small mb-0">
                    <i class="bi bi-info-circle me-1"></i>
                    GéoMonkey n'étant pas un organisme d'intérêt général, les dons
                    n'ouvrent pas droit à une réduction d'impôt.
                </p>
            </div>

            {# ===== Colonne formulaire : carte verre dépoli ===== #}
            <div class="col-lg-6 col-md-9">
                <div class="gm-join-card">
                    <h2 class="gm-join-card-title">
                        <i class="bi bi-heart-fill me-2"></i>Soutenir GéoMonkey
                    </h2>
                    <p class="text-gm-muted small mb-4">
                        Choisis un montant — ou laisse parler ton cœur. 🐒
                    </p>

                    {% for message in app.flashes('error') %}
                        <div class="alert alert-gm-danger">{{ message }}</div>
                    {% endfor %}

                    {# Montants suggérés : remplissent le champ montant #}
                    <div class="d-flex justify-content-center gap-2 mb-4 flex-wrap">
                        {% for preset in [5, 10, 20, 50] %}
                            <button type="button"
                                    class="btn btn-outline-gm-green donation-preset"
                                    data-amount="{{ preset }}">
                                {{ preset }}€
                            </button>
                        {% endfor %}
                    </div>

                    {{ form_start(form) }}
                        <div class="mb-3">
                            {{ form_row(form.amount) }}
                        </div>
                        <div class="mb-3">
                            {{ form_row(form.donorName) }}
                        </div>
                        <div class="mb-3">
                            {{ form_row(form.donorEmail) }}
                        </div>
                        <div class="mb-3">
                            {{ form_row(form.message) }}
                        </div>

                        <div class="d-grid">
                            <button type="submit" class="btn btn-gm-green btn-lg py-3">
                                <i class="bi bi-heart-fill me-2"></i>Donner
                            </button>
                        </div>
                    {{ form_end(form) }}

                    <p class="text-center small text-gm-muted mt-3 mb-0">
                        <i class="bi bi-shield-check me-1"></i>
                        Paiement sécurisé par Stripe. Tu peux donner anonymement :
                        nom, email et message sont optionnels.
                    </p>
                </div>
            </div>
        </div>
    </div>
</main>

<script>
    // Les boutons de montant suggéré remplissent le champ du formulaire
    document.querySelectorAll('.donation-preset').forEach(function (btn) {
        btn.addEventListener('click', function () {
            document.querySelector('.donation-amount-input').value = btn.dataset.amount;
            document.querySelectorAll('.donation-preset').forEach(function (b) {
                b.classList.remove('active');
            });
            btn.classList.add('active');
        });
    });

    // Fond vidéo : n'apparaît que si le fichier charge réellement,
    // et respecte prefers-reduced-motion
    (function () {
        var v = document.querySelector('.gm-join-video');
        if (!v) { return; }
        v.addEventListener('canplay', function () { v.classList.add('is-playing'); }, { once: true });
        if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
            v.pause();
            v.removeAttribute('autoplay');
            v.classList.remove('is-playing');
        }
    })();
</script>
{% endblock %}
