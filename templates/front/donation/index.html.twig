{% extends 'front/base.html.twig' %}

{% block title %}{{ 'donation.title'|trans }} - GéoMonkey{% endblock %}

{% block meta %}
    <meta name="description" content="{{ 'donation.meta'|trans }}">
{% endblock %}

{% block body %}
{% include 'partials/_navbar.html.twig' %}

{# ===== Fond vidéo en boucle (fallback : aurores animées CSS) ===== #}
<div class="gm-join-bg" aria-hidden="true">
    <div class="gm-join-aurora gm-join-aurora-green"></div>
    <div class="gm-join-aurora gm-join-aurora-yellow"></div>
    <video class="gm-join-video" autoplay muted loop playsinline preload="metadata" tabindex="-1" data-controller="video-background">
        <source src="{{ asset('videos/don.mp4') }}" type="video/mp4">
        <source src="{{ asset('videos/adhesion.mp4') }}" type="video/mp4">
    </video>
    <div class="gm-join-veil"></div>
</div>

<main class="gm-join position-relative">
    <div class="container py-5">
        <div class="row g-5 align-items-center justify-content-center min-vh-90 py-4">

            {# ===== Colonne pitch : pourquoi donner ===== #}
            <div class="col-lg-5 text-center text-lg-start">
                <span class="badge home-hero-badge mb-3">
                    <i class="bi bi-heart-fill me-1"></i> {{ 'donation.badge'|trans }}
                </span>
                <h1 class="gm-join-title mb-3">{{ 'donation.title_a'|trans }}<br>{{ 'donation.title_b'|trans }}</h1>
                <p class="gm-join-sub mb-4">
                    {{ 'donation.sub'|trans }}
                </p>

                <ul class="list-unstyled gm-join-benefits">
                    <li>
                        <i class="bi bi-tools"></i>
                        <div><strong>{{ 'donation.b1t'|trans }}</strong><br>
                        <span class="small">{{ 'donation.b1s'|trans }}</span></div>
                    </li>
                    <li>
                        <i class="bi bi-calendar-event"></i>
                        <div><strong>{{ 'donation.b2t'|trans }}</strong><br>
                        <span class="small">{{ 'donation.b2s'|trans }}</span></div>
                    </li>
                    <li>
                        <i class="bi bi-piggy-bank"></i>
                        <div><strong>{{ 'donation.b3t'|trans }}</strong><br>
                        <span class="small">{{ 'donation.b3s'|trans }}</span></div>
                    </li>
                    <li>
                        <i class="bi bi-receipt"></i>
                        <div><strong>{{ 'donation.b4t'|trans }}</strong><br>
                        <span class="small">{{ 'donation.b4s'|trans }}</span></div>
                    </li>
                </ul>

                <p class="text-gm-muted small mb-0">
                    <i class="bi bi-info-circle me-1"></i>
                    {{ 'donation.tax_note'|trans }}
                </p>
            </div>

            {# ===== Colonne formulaire : carte verre dépoli ===== #}
            <div class="col-lg-6 col-md-9">
                <div class="gm-join-card" data-controller="donation-presets">
                    <h2 class="gm-join-card-title">
                        <i class="bi bi-heart-fill me-2"></i>{{ 'donation.card_title'|trans }}
                    </h2>
                    <p class="text-gm-muted small mb-4">
                        {{ 'donation.card_sub'|trans }}
                    </p>

                    {% for message in app.flashes('error') %}
                        <div class="alert alert-gm-danger">{{ message }}</div>
                    {% endfor %}

                    {# Montants suggérés : remplissent le champ montant #}
                    <div class="d-flex justify-content-center gap-2 mb-4 flex-wrap">
                        {% for preset in [5, 10, 20, 50] %}
                            <button type="button"
                                    class="btn btn-outline-gm-green donation-preset"
                                    data-action="donation-presets#select"
                                    data-amount="{{ preset }}">
                                {{ preset }}€
                            </button>
                        {% endfor %}
                    </div>

                    {{ form_start(form) }}
                        <div class="mb-3">
                            {{ form_row(form.amount) }}
                        </div>
                        <div class="mb-3">
                            {{ form_row(form.donorName) }}
                        </div>
                        <div class="mb-3">
                            {{ form_row(form.donorEmail) }}
                        </div>
                        <div class="mb-3">
                            {{ form_row(form.message) }}
                        </div>

                        <div class="d-grid">
                            <button type="submit" class="btn btn-gm-green btn-lg py-3">
                                <i class="bi bi-heart-fill me-2"></i>{{ 'donation.submit'|trans }}
                            </button>
                        </div>
                    {{ form_end(form) }}

                    <p class="text-center small text-gm-muted mt-3 mb-0">
                        <i class="bi bi-shield-check me-1"></i>
                        {{ 'donation.secure_note'|trans }}
                    </p>
                </div>
            </div>
        </div>
    </div>
</main>


{% endblock %}
