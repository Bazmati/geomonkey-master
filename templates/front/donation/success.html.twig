{# templates/front/donation/success.html.twig #}
{% extends 'front/base.html.twig' %}

{% block title %}{{ 'donation.ok.page_title'|trans }} - GéoMonkey{% endblock %}

{% block body %}
    {% include 'partials/_navbar.html.twig' %}

    <div class="container py-5">
        <div class="row justify-content-center">
            <div class="col-lg-6 col-md-8 text-center">
                <div class="card shadow-sm border-gm-green">
                    <div class="card-header bg-gm-green text-gm-white">
                        <h2 class="mb-0"><i class="bi bi-heart-fill me-2"></i>{{ 'donation.ok.header'|trans }}</h2>
                    </div>
                    <div class="card-body">
                        {# Marque : logo + wordmark commun au site #}
                        <img src="{{ asset('images/Logo_geomonkey.png') }}" alt="Logo GéoMonkey" class="mx-auto d-block mb-2 rounded-circle" width="56" height="56">
                        <div class="fw-bold mb-2">Géo<span class="text-gm-yellow">Monkey</span></div>
                        <div class="py-4">
                            <i class="bi bi-emoji-heart-fill text-gm-green display-4"></i>
                            <h3 class="mt-3 text-gm-green">{{ 'donation.ok.h3'|trans }}</h3>
                            <p class="lead text-gm-muted">
                                {{ 'donation.ok.p1'|trans }}
                            </p>
                            <p class="text-gm-muted">
                                {{ 'donation.ok.p2'|trans }}
                            </p>
                            <div class="alert alert-gm-info">
                                <i class="bi bi-envelope me-2"></i>
                                {{ 'donation.ok.email_note'|trans }}
                            </div>
                        </div>
                        <a href="{{ path('app_home') }}" class="btn btn-gm-green btn-lg px-4">
                            <i class="bi bi-house me-2"></i> {{ 'legal.back_home'|trans }}
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
