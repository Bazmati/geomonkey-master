{% extends 'front/base.html.twig' %}

{% block title %}{{ 'nav.blog'|trans }} — {{ parent() }}{% endblock %}

{% block meta %}
    <meta name="description" content="Actualités et articles de l'association GéoMonkey : projets, constructions, festivals et vie de l'association.">
{% endblock %}

{% block body %}
{% include 'partials/_navbar.html.twig' %}

{# ===== Hero de section ===== #}
<header class="pres-hero">
    <div class="container position-relative text-center">
        <span class="badge home-hero-badge mb-3">
            <i class="bi bi-newspaper me-1"></i> {{ 'nav.blog'|trans }}
        </span>
        <h1 class="pres-hero-title">{{ 'blog.hero.title'|trans }}</h1>
        <p class="home-hero-sub mx-auto mb-0">
            {{ 'blog.hero.sub'|trans }}
        </p>
    </div>
</header>

<main class="container py-5">
    {{ breadcrumb() }}

    <div class="row g-5">
        {# ===== Colonne principale : articles ===== #}
        <div class="col-lg-8">
            {% if currentTag is defined and currentTag %}
                <div class="alert alert-dark d-flex align-items-center justify-content-between">
                    <span><i class="bi bi-tag me-1 text-gm-yellow"></i> {{ 'blog.tagged'|trans }} <strong class="text-gm-yellow">#{{ currentTag.name }}</strong></span>
                    <a href="{{ path('app_blog_index') }}" class="btn btn-sm btn-outline-light">{{ 'blog.tagged_all'|trans }}</a>
                </div>
            {% endif %}

            {% include 'front/blog/_list.html.twig' with {'posts': posts} %}
        </div>

        {# ===== Colonne latérale : derniers articles + filtres ===== #}
        <div class="col-lg-4">
            {% include 'front/blog/_sidebar.html.twig' %}
        </div>
    </div>
</main>
{% endblock %}
