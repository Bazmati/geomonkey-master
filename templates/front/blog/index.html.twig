{% extends 'front/base.html.twig' %}

{% block title %}Blog — {{ parent() }}{% endblock %}

{% block body %}
{% include 'partials/_navbar.html.twig' %}
<section class="py-5">
    <div class="container">
        <h1 class="mb-4"><i class="bi bi-newspaper"></i> Le blog de l'association</h1>

        {% if posts is empty %}
            <div class="alert alert-info">
                <i class="bi bi-info-circle"></i> Aucun article publié pour le moment. Revenez bientôt !
            </div>
        {% else %}
            <div class="row g-4">
                {% for post in posts %}
                    <div class="col-md-6 col-lg-4">
                        <div class="card h-100 shadow-sm">
                            {% if post.hasImage %}
                                <img src="{{ asset('uploads/blog_posts/' ~ post.image) }}"
                                     class="card-img-top" alt="Illustration de l'article {{ post.title }}">
                            {% endif %}
                            <div class="card-body d-flex flex-column">
                                <h5 class="card-title">{{ post.title }}</h5>
                                <p class="card-text text-muted">{{ post.excerpt }}</p>
                                <div class="mt-auto">
                                    <p class="text-muted small mb-2">
                                        <i class="bi bi-person"></i>
                                        {{ post.author ? (post.author.firstName ~ ' ' ~ post.author.lastName) : 'Bureau' }}
                                        — <i class="bi bi-calendar"></i>
                                        {{ (post.publishedAt ?? post.createdAt)|date('d/m/Y') }}
                                    </p>
                                    <a href="{{ path('app_blog_show', {'slug': post.slug}) }}"
                                       class="btn btn-success btn-sm">
                                        Lire l'article <i class="bi bi-arrow-right"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% endif %}
    </div>
</section>
{% endblock %}