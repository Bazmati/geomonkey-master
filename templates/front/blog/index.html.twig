{% extends 'front/base.html.twig' %}

{% block title %}Blog — {{ parent() }}{% endblock %}

{% block meta %}
    <meta name="description" content="Actualités et articles de l'association GéoMonkey : projets, constructions, festivals et vie de l'association.">
{% endblock %}

{% block body %}
{% include 'partials/_navbar.html.twig' %}
<section class="py-5">
    <div class="container">
        
        {{ breadcrumb() }}

        <h1 class="mb-4"><i class="bi bi-newspaper"></i> Le blog de l'association</h1>

        {% if posts is empty %}
            <div class="alert alert-info">
                <i class="bi bi-info-circle"></i> Aucun article publié pour le moment. Revenez bientôt !
            </div>
        {% else %}
            {% include 'front/blog/_list.html.twig' with {'posts': posts} %}
        {% endif %}
    </div>
        {% if tags|length > 0 %}
            <hr class="my-5">
            <h3><i class="bi bi-tags"></i> Tags</h3>
            <p>
                {% for tag in tags %}
                    <a href="{{ path('app_blog_tag', {'slug': tag.slug}) }}"
                       class="badge bg-secondary text-decoration-none me-1 mb-1">#{{ tag.name }}</a>
                {% endfor %}
            </p>
        {% endif %}
</section>
{% endblock %}