{% extends 'front/base.html.twig' %}

{% block title %}Actualités — {{ parent() }}{% endblock %}

{% block meta %}
    <meta name="description" content="Actualités et articles de l'association GéoMonkey : projets, constructions, festivals et vie de l'association.">
{% endblock %}

{% block body %}
{% include 'partials/_navbar.html.twig' %}

{# ===== Hero de section ===== #}
<header class="pres-hero">
    <div class="container position-relative text-center">
        <span class="badge home-hero-badge mb-3">
            <i class="bi bi-newspaper me-1"></i> Actualités
        </span>
        <h1 class="pres-hero-title">La vie de l'assoc', en direct</h1>
        <p class="home-hero-sub mx-auto mb-0">
            Coulisses des chantiers, retours des événements, annonces et
            petites histoires : chaque article est une invitation à plonger
            dans l'univers GéoMonkey. Bonne lecture !
        </p>
    </div>
</header>

<main class="container py-5">
    {{ breadcrumb() }}

    {% include 'front/blog/_list.html.twig' with {'posts': posts} %}

    {% if tags|length > 0 %}
        <hr class="my-5">
        <h2 class="h4 mb-3"><i class="bi bi-tags text-gm-yellow"></i> Explorer par tag</h2>
        <p class="mb-0">
            {% for tag in tags %}
                <a href="{{ path('app_blog_tag', {'slug': tag.slug}) }}"
                   class="badge gm-tag-pill text-decoration-none me-1 mb-1">#{{ tag.name }}</a>
            {% endfor %}
        </p>
    {% endif %}
</main>
{% endblock %}
