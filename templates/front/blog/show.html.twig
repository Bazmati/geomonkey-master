{% extends 'front/base.html.twig' %}

{% import 'partials/_breadcrumb.html.twig' as breadcrumb_macros %}

{% block title %}{{ post.title }} — {{ parent() }}{% endblock %}
{% block meta %}
    <meta name="description" content="{{ post.metaDescription }}">
    {# Meta Open Graph : base du partage Facebook / WhatsApp / LinkedIn #}
    <meta property="og:type" content="article">
    <meta property="og:title" content="{{ post.title }}">
    <meta property="og:description" content="{{ post.metaDescription }}">
    <meta property="og:url" content="{{ app.request.uri }}">
    {% if image_url %}
        <meta property="og:image" content="{{ absolute_url(asset(image_url)) }}">
    {% endif %}
    <meta name="twitter:card" content="summary_large_image">
{% endblock %}

{% block body %}
{% include 'partials/_navbar.html.twig' %}
<article class="py-5">
    <div class="container" style="max-width: 800px;">
        <nav aria-label="Fil d'Ariane">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="{{ path('app_home') }}">Accueil</a></li>
                <li class="breadcrumb-item"><a href="{{ path('app_blog_index') }}">Blog</a></li>
                <li class="breadcrumb-item active" aria-current="page">{{ post.title }}</li>
            </ol>
        </nav>

        <p class="mb-2">
            {% if post.category %}
                <a href="{{ path('app_blog_category', {'slug': post.category.slug}) }}"
                   class="badge bg-success text-decoration-none">{{ post.category.name }}</a>
            {% endif %}
            {% for tag in post.tags %}
                <a href="{{ path('app_blog_tag', {'slug': tag.slug}) }}"
                   class="badge bg-secondary text-decoration-none">#{{ tag.name }}</a>
            {% endfor %}
        </p>

        <h1 class="mb-3">{{ post.title }}</h1>

        <p class="text-muted">
            <i class="bi bi-person"></i>
            {{ post.author ? (post.author.firstName ~ ' ' ~ post.author.lastName) : 'Bureau' }}
            — publié le {{ (post.publishedAt ?? post.createdAt)|date('d/m/Y') }}
            {% if post.updatedAt and post.updatedAt > post.createdAt %}
                · modifié le {{ post.updatedAt|date('d/m/Y') }}
            {% endif %}
        </p>

        {% if post.hasImage %}
            {{ image_tag(post, 'large', 'Illustration de l\'article ' ~ post.title, 'img-fluid rounded mb-4') }}
        {% endif %}

        {# Mise en forme sécurisée (H2/H3, listes, citations) + images positionnées.
           Le filtre échappe chaque fragment — pas de |raw dangereux. #}
        <div class="article-content">
            {{ post.content|content_with_images(post.images|filter(i => i.galleryImage.isPublished)) }}
        </div>

                {% if post.events|length > 0 %}
            <div class="card bg-light border-0 mt-4">
                <div class="card-body">
                    <h3 class="h6 mb-2"><i class="bi bi-calendar-event"></i> Événements liés</h3>
                    <ul class="list-unstyled mb-0">
                        {% for event in post.events %}
                            <li>
                                <i class="bi bi-calendar"></i>
                                <a href="{{ path('app_event_show', {'id': event.id}) }}">{{ event.title }}</a>
                                <small class="text-muted">— {{ event.startDate|date('d/m/Y') }}</small>
                            </li>
                        {% endfor %}
                    </ul>
                </div>
            </div>
        {% endif %}

        {# Boutons de partage social — aucun token requis #}
        {{ include('front/blog/_share_buttons.html.twig', {'post': post}) }}

        {% if post.galleryImages|length > 0 %}
            <hr class="my-5">
            <h3><i class="bi bi-images"></i> Images de l'article</h3>
            <div class="row g-3">
                {% for image in post.galleryImages %}
                    {% if image.isPublished %}
                        <div class="col-md-4">
                            {{ image_tag(image, 'medium', image.alt, 'img-fluid rounded') }}
                        </div>
                    {% endif %}
                {% endfor %}
            </div>
        {% endif %}
    </div>
</article>
{% endblock %}