{% extends 'front/base.html.twig' %}

{% block title %}{{ post.title }} — {{ parent() }}{% endblock %}
{% block meta %}
    <meta name="description" content="{{ post.metaDescription }}">
    {# Meta Open Graph : base du partage Facebook / WhatsApp / LinkedIn / réseaux sociaux #}
    <meta property="og:type" content="article">
    <meta property="og:title" content="{{ post.title }}">
    <meta property="og:description" content="{{ post.metaDescription }}">
    <meta property="og:url" content="{{ app.request.uri }}">
    {% if image_url %}
        <meta property="og:image" content="{{ absolute_url(asset(image_url)) }}">
    {% endif %}
    <meta name="twitter:card" content="summary_large_image">
{% endblock %}

{% block body %}
{% include 'partials/_navbar.html.twig' %}

{% set read_time = ((post.content|striptags|split(' ')|length) / 200)|round(1, 'ceil') %}

{# ===== Hero : image de fond + titre par-dessus (arrivée depuis les réseaux) ===== #}
<header class="pres-show-hero {{ image_url ? '' : 'pres-hero' }}">
    {% if image_url %}
        <div class="pres-show-hero-bg" style="background-image: url('{{ image_url }}')"></div>
        <div class="pres-show-hero-overlay"></div>
    {% endif %}
    <div class="container position-relative">
        <p class="mb-2">
            {% if post.category %}
                <a href="{{ path('app_blog_category', {'slug': post.category.slug}) }}"
                   class="badge bg-gm-green text-gm-white text-decoration-none">{{ post.category.name }}</a>
            {% endif %}
            <span class="badge bg-gm-surface border-gm-yellow text-gm-text">
                <i class="bi bi-clock me-1"></i> {{ read_time }} min de lecture
            </span>
        </p>
        <h1 class="pres-show-hero-title">{{ post.title }}</h1>
        <p class="pres-show-hero-excerpt mb-0">
            <i class="bi bi-person-circle me-1"></i>
            {{ post.author ? (post.author.firstName ~ ' ' ~ post.author.lastName) : 'Bureau' }}
            — {{ (post.publishedAt ?? post.createdAt)|date('d/m/Y') }}
        </p>
    </div>
</header>

<main class="container py-5">
    {{ breadcrumb() }}

    <div class="row justify-content-center">
        <div class="col-lg-8">

            {# Accroche : résumé pour donner envie d'aller au bout #}
            {% if post.summary %}
                <p class="blog-lead fst-italic mb-4">{{ post.summary }}</p>
            {% endif %}

            {# Mise en forme sécurisée (H2/H3, listes, citations) + images positionnées.
               Le filtre échappe chaque fragment — pas de |raw dangereux. #}
            <article class="pres-show-content">
                <div class="article-content mb-0">
                    {{ post.content|content_with_images(post.images|filter(i => i.galleryImage.isPublished)) }}
                </div>

                <p class="text-muted small mt-4 mb-0">
                    {% if post.updatedAt and post.updatedAt > post.createdAt %}
                        <i class="bi bi-pencil me-1"></i> Article mis à jour le {{ post.updatedAt|date('d/m/Y') }}
                    {% else %}
                        <i class="bi bi-check2-circle me-1"></i> Merci d'avoir lu jusqu'ici !
                    {% endif %}
                </p>
            </article>

            {# Événements liés #}
            {% if post.events|length > 0 %}
                <section class="mt-5">
                    <h2 class="h4 mb-3"><i class="bi bi-calendar-event text-gm-green"></i> Événements liés</h2>
                    {% for event in post.events %}
                        <a href="{{ path('app_event_show', {'slug': event.slug}) }}" class="proj-related mb-2">
                            <i class="bi bi-calendar-event fs-5 text-gm-green"></i>
                            <span class="flex-grow-1">
                                <strong>{{ event.title }}</strong><br>
                                <span class="text-muted small">{{ event.startDate|date('d/m/Y') }}</span>
                            </span>
                            <i class="bi bi-arrow-right"></i>
                        </a>
                    {% endfor %}
                </section>
            {% endif %}

            {# Galerie de l'article #}
            {% set gallery = post.galleryImages|filter(i => i.isPublished) %}
            {% if gallery|length > 0 %}
                <section class="mt-5">
                    <h2 class="h4 mb-3"><i class="bi bi-images text-gm-yellow"></i> En images</h2>
                    <div class="row g-3">
                        {% for image in gallery %}
                            <div class="col-6 col-md-4">
                                {{ image_tag(image, 'medium', image.alt, 'home-mosaic w-100') }}
                            </div>
                        {% endfor %}
                    </div>
                </section>
            {% endif %}

            {# Fin d'article : partage + adhésion #}
            <div class="blog-end text-center mt-5 p-4">
                <p class="h5 mb-1"><i class="bi bi-heart text-gm-yellow"></i> Tu as aimé cet article ?</p>
                <p class="text-muted small mb-0">Partage-le autour de toi, ou viens vivre la suite avec nous.</p>
                <div class="mt-3 d-flex flex-wrap justify-content-center gap-2">
                    <a href="{{ path('app_membership_register') }}" class="btn btn-gm-green">
                        <i class="bi bi-people me-1"></i> Rejoindre l'association
                    </a>
                    <a href="{{ path('app_project_index') }}" class="btn btn-outline-gm-green">
                        <i class="bi bi-kanban me-1"></i> Voir nos projets
                    </a>
                </div>
            </div>

            {# Boutons de partage social — aucun token requis #}
            {{ include('front/blog/_share_buttons.html.twig', {'post': post}) }}

            {# À lire aussi #}
            {% if related|length > 0 %}
                <section class="mt-5">
                    <h2 class="h4 mb-3"><i class="bi bi-bookmarks text-gm-green"></i> À lire aussi</h2>
                    <div class="row g-4">
                        {% for r in related %}
                            {% set r_img = image_url(r, 'medium') %}
                            <div class="col-md-4">
                                <a href="{{ path('app_blog_show', {'slug': r.slug}) }}"
                                   class="text-decoration-none h-100 d-block">
                                    <article class="blog-card blog-card-mini h-100 {{ r_img ? '' : 'blog-card-noimg' }}"
                                             {% if r_img %}style="background-image: url('{{ r_img }}')"{% endif %}>
                                        <div class="blog-card-overlay">
                                            <h3 class="blog-card-title h6">{{ r.title }}</h3>
                                            <span class="proj-card-cta">
                                                Lire <i class="bi bi-arrow-right"></i>
                                            </span>
                                        </div>
                                    </article>
                                </a>
                            </div>
                        {% endfor %}
                    </div>
                </section>
            {% endif %}
        </div>
    </div>
</main>
{% endblock %}
