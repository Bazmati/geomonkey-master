{# Liste d'articles réutilisable : reçoit "posts" #}
{% if posts is empty %}
    <div class="alert alert-info">
        <i class="bi bi-info-circle"></i> Aucun article publié pour le moment. Revenez bientôt !
    </div>
{% else %}
    <div class="row g-4">
        {% for post in posts %}
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 shadow-sm">
                    {% if post.hasImage %}
                        <img src="{{ asset('uploads/blog_posts/' ~ post.image) }}"
                             class="card-img-top" alt="Illustration de l'article {{ post.title }}">
                    {% endif %}
                    <div class="card-body d-flex flex-column">
                        {% if post.category %}
                            <a href="{{ path('app_blog_category', {'slug': post.category.slug}) }}"
                               class="badge bg-success text-decoration-none mb-1">{{ post.category.name }}</a>
                        {% endif %}
                        <h5 class="card-title">{{ post.title }}</h5>
                        <p class="card-text text-muted">{{ post.summary ?? post.excerpt }}</p>
                        <div class="mt-auto">
                            <p class="text-muted small mb-2">
                                <i class="bi bi-person"></i>
                                {{ post.author ? (post.author.firstName ~ ' ' ~ post.author.lastName) : 'Bureau' }}
                                — <i class="bi bi-calendar"></i>
                                {{ (post.publishedAt ?? post.createdAt)|date('d/m/Y') }}
                            </p>
                            <a href="{{ path('app_blog_show', {'slug': post.slug}) }}"
                               class="btn btn-success btn-sm">
                                Lire l'article <i class="bi bi-arrow-right"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>
{% endif %}