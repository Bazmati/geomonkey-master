{# Boutons de partage social — liens publics officiels, aucun token requis.
   Les réseaux "actifs" depuis Paramètres → Réseaux sociaux filtreront
   cette liste à l'étape suivante (variable share_targets). #}
{% set url = app.request.uri %}
{% set text = post.title %}

<div class="share-buttons mt-5">
    <h5 class="mb-3"><i class="bi bi-share"></i> Partager cet article</h5>
    <div class="d-flex flex-wrap gap-2">

        <a href="https://www.facebook.com/sharer/sharer.php?u={{ url|url_encode }}"
           target="_blank" rel="noopener noreferrer"
           class="btn btn-sm btn-outline-primary" title="Partager sur Facebook">
            <i class="bi bi-facebook"></i> Facebook
        </a>

        <a href="https://twitter.com/intent/tweet?url={{ url|url_encode }}&text={{ text|url_encode }}"
           target="_blank" rel="noopener noreferrer"
           class="btn btn-sm btn-outline-dark" title="Partager sur X (Twitter)">
            <i class="bi bi-twitter-x"></i> X
        </a>

        <a href="https://api.whatsapp.com/send?text={{ (text ~ ' — ' ~ url)|url_encode }}"
           target="_blank" rel="noopener noreferrer"
           class="btn btn-sm btn-outline-success" title="Partager sur WhatsApp">
            <i class="bi bi-whatsapp"></i> WhatsApp
        </a>

        <a href="https://www.linkedin.com/sharing/share-offsite/?url={{ url|url_encode }}"
           target="_blank" rel="noopener noreferrer"
           class="btn btn-sm btn-outline-primary" title="Partager sur LinkedIn">
            <i class="bi bi-linkedin"></i> LinkedIn
        </a>

        <button type="button" class="btn btn-sm btn-outline-secondary copy-link-btn"
                data-url="{{ url }}" title="Copier le lien">
            <i class="bi bi-link-45deg"></i> Copier le lien
        </button>

    </div>
</div>

<script>
    // Copier le lien dans le presse-papiers
    document.querySelectorAll('.copy-link-btn').forEach(btn => {
        btn.addEventListener('click', async () => {
            try {
                await navigator.clipboard.writeText(btn.dataset.url);
                const original = btn.innerHTML;
                btn.innerHTML = '<i class="bi bi-check-lg"></i> Copié !';
                setTimeout(() => btn.innerHTML = original, 2000);
            } catch (e) {
                // Fallback silencieux : rien de critique
            }
        });
    });
</script>