{% extends 'front/base.html.twig' %}

{% block title %}{{ 'blog.category.title'|trans }} — {{ category.name }} — {{ parent() }}{% endblock %}
{% block meta %}
    <meta name="description" content="{{ 'blog.category.meta'|trans({'%category%': category.name}) }}">
{% endblock %}

{% block body %}
{% include 'partials/_navbar.html.twig' %}

{# ===== Hero de section ===== #}
<header class="pres-hero">
    <div class="container position-relative text-center">
        <span class="badge home-hero-badge mb-3">
            <i class="bi bi-folder2-open me-1"></i> {{ 'blog.category.badge'|trans }}
        </span>
        <h1 class="pres-hero-title">{{ category.name }}</h1>
        <p class="home-hero-sub mx-auto mb-0">
            {{ 'blog.category.sub'|trans({'%category%': category.name}) }}
        </p>
    </div>
</header>

<main class="container py-5">
    {{ breadcrumb() }}

    <div class="row g-5">
        {# ===== Colonne principale : articles de la catégorie ===== #}
        <div class="col-lg-8">
            {% include 'front/blog/_list.html.twig' with {'posts': posts} %}
        </div>

        {# ===== Colonne latérale : derniers articles + filtres ===== #}
        <div class="col-lg-4">
            {% include 'front/blog/_sidebar.html.twig' %}
        </div>
    </div>
</main>
{% endblock %}
