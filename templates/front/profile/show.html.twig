{% extends 'front/base.html.twig' %}

{% block title %}{{ 'nav.profile'|trans }} — GéoMonkey{% endblock %}
{% block meta_description %}{{ 'profile.meta'|trans }}{% endblock %}

{% block body %}
    {% include 'partials/_navbar.html.twig' %}

    <section class="py-5">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-lg-8">

                    <h1 class="text-warning fw-bold mb-4">
                        <i class="bi bi-person-vcard me-2"></i>{{ 'nav.profile'|trans }}
                    </h1>

                    {# ===== Identité ===== #}
                    <div class="card bg-gm-surface border-warning mb-4">
                        <div class="card-body p-4">
                            <h2 class="h6 text-gm-muted text-uppercase mb-3">{{ 'profile.info'|trans }}</h2>

                            <div class="row mb-2">
                                <div class="col-sm-4 text-gm-muted">{{ 'register.ph_firstname'|trans }}</div>
                                <div class="col-sm-8">{{ app.user.firstName ?? '—' }}</div>
                            </div>
                            <div class="row mb-2">
                                <div class="col-sm-4 text-gm-muted">{{ 'register.ph_lastname'|trans }}</div>
                                <div class="col-sm-8">{{ app.user.lastName ?? '—' }}</div>
                            </div>
                            <div class="row mb-2">
                                <div class="col-sm-4 text-gm-muted">{{ 'form.email'|trans }}</div>
                                <div class="col-sm-8">{{ app.user.email }}</div>
                            </div>

                            <p class="small text-gm-muted mb-0">
                                <i class="bi bi-info-circle me-1"></i>
                                {{ 'profile.email_note'|trans }}
                            </p>
                        </div>
                    </div>

                    {# ===== Statut ===== #}
                    <div class="card bg-gm-surface border-warning mb-4">
                        <div class="card-body p-4">
                            <h2 class="h6 text-gm-muted text-uppercase mb-3">{{ 'profile.status'|trans }}</h2>

                            <div class="row mb-2">
                                <div class="col-sm-4 text-gm-muted">{{ 'profile.function'|trans }}</div>
                                <div class="col-sm-8">
                                    {% if app.user.officeFunctionLabel %}
                                        <span class="badge bg-success">{{ app.user.officeFunctionLabel }}</span>
                                    {% else %}
                                        <span class="badge bg-secondary">{{ 'badge.visitor'|trans }}</span>
                                    {% endif %}
                                </div>
                            </div>
                            <div class="row mb-2">
                                <div class="col-sm-4 text-gm-muted">{{ 'register.badge'|trans }}</div>
                                <div class="col-sm-8">
                                    {% if app.user.hasActiveMembership() %}
                                        <span class="badge bg-success">
                                            {{ 'profile.member_until'|trans({'%date%': app.user.membershipValidDate|date('d/m/Y')})|raw }}
                                        </span>
                                    {% else %}
                                        <span class="badge bg-secondary">{{ 'profile.no_membership'|trans }}</span>
                                    {% endif %}
                                </div>
                            </div>
                            <div class="row mb-2">
                                <div class="col-sm-4 text-gm-muted">{{ 'profile.member_since'|trans }}</div>
                                <div class="col-sm-8">{{ app.user.createdAt|date('d/m/Y') }}</div>
                            </div>
                            <div class="row mb-2">
                                <div class="col-sm-4 text-gm-muted">{{ 'profile.image_rights'|trans }}</div>
                                <div class="col-sm-8">
                                    {% if app.user.imageConsent %}
                                        <span class="text-success"><i class="bi bi-check-circle me-1"></i>{{ 'profile.consent.yes'|trans }}</span>
                                    {% else %}
                                        <span class="text-gm-muted"><i class="bi bi-x-circle me-1"></i>{{ 'profile.consent.no'|trans }}</span>
                                    {% endif %}
                                </div>
                            </div>

                            <p class="small text-gm-muted mb-0">
                                <i class="bi bi-shield-check me-1"></i>
                                {{ 'profile.pwd_prefix'|trans }}
                                <a href="{{ path('app_login') }}" class="link-warning">{{ 'profile.login_page'|trans }}</a>.
                            </p>
                        </div>
                    </div>

                    <div class="d-flex flex-wrap gap-2">
                        <a href="{{ path('app_profile_edit') }}" class="btn btn-gm-yellow fw-semibold">
                            <i class="bi bi-pencil me-2"></i>{{ 'profile.edit_btn'|trans }}
                        </a>
                        <a href="{{ path('app_home') }}" class="btn btn-outline-gm-yellow">
                            <i class="bi bi-house me-2"></i>{{ 'legal.back_home'|trans }}
                        </a>
                    </div>

                </div>
            </div>
        </div>
    </section>
{% endblock %}
