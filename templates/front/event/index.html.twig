{% extends 'front/base.html.twig' %}

{% import 'partials/_breadcrumb.html.twig' as breadcrumb_macros %}

{% block title %}Événements — {{ parent() }}{% endblock %}
{% block meta %}
    <meta name="description" content="Découvrez les événements de l'association GéoMonkey : ateliers, constructions, festivals et rencontres.">
{% endblock %}

{% block body %}
{% include 'partials/_navbar.html.twig' %}
<section class="py-5 bg-surface">
    <div class="container">
        <nav aria-label="Fil d'Ariane">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="{{ path('app_home') }}">Accueil</a></li>
                <li class="breadcrumb-item active" aria-current="page">Événements</li>
            </ol>
        </nav>

        <h1 class="mb-4"><i class="bi bi-calendar-event"></i> Nos événements</h1>

        {% if events is empty %}
            <div class="alert alert-info">
                <i class="bi bi-info-circle"></i> Aucun événement à afficher pour le moment. Revenez bientôt !
            </div>
        {% else %}
            <div class="row g-4">
                {% for event in events %}
                    <div class="col-md-6 col-lg-4">
                        <div class="card h-100 shadow-sm">
                            {% if event.hasImage %}
                                <img src="{{ asset('uploads/events/' ~ event.image) }}"
                                     class="card-img-top" alt="Illustration de l'événement {{ event.title }}">
                            {% endif %}
                            <div class="card-body d-flex flex-column">
                                <div class="mb-2">
                                    {% if event.isMembersOnly %}
                                        <span class="badge bg-warning text-dark">
                                            <i class="bi bi-people"></i> Réservé aux membres
                                        </span>
                                    {% endif %}
                                    <span class="badge bg-{{ event.endDate|date('U') >= 'now'|date('U') ? 'success' : 'secondary' }} text-light">
                                        {{ event.endDate|date('U') >= 'now'|date('U') ? 'À venir' : 'Passé' }}
                                    </span>
                                </div>
                                <h5 class="card-title">{{ event.title }}</h5>
                                <p class="card-text text-muted small mb-1">
                                    <i class="bi bi-calendar"></i>
                                    {{ event.startDate|date('d/m/Y H:i') }}
                                    — {{ event.endDate|date('d/m/Y H:i') }}
                                </p>
                                <p class="card-text text-muted small">
                                    <i class="bi bi-geo-alt"></i> {{ event.location }}
                                </p>
                                <div class="mt-auto">
                                    <a href="{{ path('app_event_show', {'id': event.id}) }}"
                                       class="btn btn-success btn-sm">
                                        Voir l'événement <i class="bi bi-arrow-right"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% endif %}
    </div>
</section>
{% endblock %}