{% extends 'front/base.html.twig' %}

{% block title %}Événements — {{ parent() }}{% endblock %}

{% block meta_description %}Découvrez les événements de l'association GéoMonkey : ateliers, constructions, festivals et rencontres.{% endblock %}

{% block stylesheets %}
    {{ parent() }}
{% endblock %}

{% block javascripts %}
    {{ parent() }}
{% endblock %}

{% block body %}
{% include 'partials/_navbar.html.twig' %}
<section class="py-5 ">
    <div class="container">

        {{ breadcrumb() }}

        <h1 class="mb-4"><i class="bi bi-calendar-event"></i> Nos événements</h1>

        {# ============================================================
           FILTRE (visible partout : agit sur la liste mobile,
           le calendrier desktop affiche lui l'intégralité)
           ============================================================ #}
        <div class="btn-group mb-4 gm-filter-group" role="group" aria-label="Filtrer les événements">
            <a href="{{ path('app_event_index', {'filtre': 'tous'}) }}"
               class="btn btn-sm {{ filter == 'tous' ? 'btn-warning' : 'btn-outline-gm-yellow' }}">Tous</a>
            <a href="{{ path('app_event_index', {'filtre': 'a-venir'}) }}"
               class="btn btn-sm {{ filter == 'a-venir' ? 'btn-warning' : 'btn-outline-gm-yellow' }}">À venir</a>
            <a href="{{ path('app_event_index', {'filtre': 'passes'}) }}"
               class="btn btn-sm {{ filter == 'passes' ? 'btn-warning' : 'btn-outline-gm-yellow' }}">Passés</a>
        </div>

        {# ============================================================
           DESKTOP (>= lg) : calendrier FullCalendar alimenté par le feed JSON
           ============================================================ #}
        <div class="d-none d-lg-block gm-calendar gm-calendar-container"
             data-controller="event-calendar"
             data-event-calendar-feed-url-value="{{ path('app_event_data') }}"></div>

        {# ============================================================
           MOBILE (< lg) : cartes d'événements
           ============================================================ #}
        <div class="d-lg-none">
            {% if events is empty %}
                <div class="alert alert-gm-info">
                    <i class="bi bi-info-circle"></i> Aucun événement à afficher pour ce filtre. Revenez bientôt !
                </div>
            {% else %}
                <div class="row g-4">
                    {% for event in events %}
                        <div class="col-12 col-md-6">
                            <div class="card h-100 shadow-sm">
                                {% if event.hasImage %}
                                    <img src="{{ asset('uploads/events/' ~ event.image) }}"
                                         class="card-img-top" alt="Illustration de l'événement {{ event.title }}" loading="lazy">
                                {% endif %}
                                <div class="card-body d-flex flex-column">
                                    <div class="mb-2">
                                        {% if event.isMembersOnly %}
                                            <span class="badge bg-warning text-dark">
                                                <i class="bi bi-people"></i> Réservé aux membres
                                            </span>
                                        {% endif %}
                                        <span class="badge bg-{{ event.endDate|date('U') >= 'now'|date('U') ? 'success' : 'secondary' }} text-light">
                                            {{ event.endDate|date('U') >= 'now'|date('U') ? 'À venir' : 'Passé' }}
                                        </span>
                                    </div>
                                    <h5 class="card-title">{{ event.title }}</h5>
                                    <p class="card-text text-muted small mb-1">
                                        <i class="bi bi-calendar"></i>
                                        {{ event.startDate|date('d/m/Y H:i') }}
                                        — {{ event.endDate|date('d/m/Y H:i') }}
                                    </p>
                                    <p class="card-text text-muted small">
                                        <i class="bi bi-geo-alt"></i> {{ event.location }}
                                    </p>
                                    <div class="mt-auto">
                                        <a href="{{ path('app_event_show', {'id': event.id}) }}"
                                           class="btn btn-success btn-sm">
                                            Voir l'événement <i class="bi bi-arrow-right"></i>
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            {% endif %}
        </div>
    </div>
</section>
{% endblock %}
