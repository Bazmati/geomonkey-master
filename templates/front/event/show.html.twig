{% extends 'front/base.html.twig' %}

{% import 'partials/_breadcrumb.html.twig' as breadcrumb_macros %}

{% block title %}{{ event.title }} — {{ parent() }}{% endblock %}
{% block meta %}
    <meta name="description" content="{{ event.description|striptags|slice(0, 155) }}">
    <meta property="og:type" content="event">
    <meta property="og:title" content="{{ event.title }}">
    <meta property="og:description" content="{{ event.description|striptags|slice(0, 155) }}">
    <meta property="og:url" content="{{ app.request.uri }}">
    {% if image_url %}
        <meta property="og:image" content="{{ absolute_url(asset(image_url)) }}">
    {% endif %}
    <meta name="twitter:card" content="summary_large_image">
{% endblock %}

{% block body %}
{% include 'partials/_navbar.html.twig' %}
<article class="py-5">
    <div class="container max-w-800">
        {{ breadcrumb() }}

        <h1 class="mb-3">{{ event.title }}</h1>

        <p class="text-muted">
            <i class="bi bi-calendar"></i>
            {{ event.startDate|date('d/m/Y H:i') }} — {{ event.endDate|date('d/m/Y H:i') }}
            &nbsp;·&nbsp; <i class="bi bi-geo-alt"></i>
            {% if event.location %}
                <a href="https://www.google.com/maps/search/?api=1&amp;query={{ event.location|url_encode }}"
                   target="_blank" rel="noopener">
                    {{ event.location }}
                </a>
            {% endif %}
            {% if event.isMembersOnly %}
                &nbsp;·&nbsp; <span class="badge bg-warning text-dark"><i class="bi bi-people"></i> Réservé aux membres</span>
            {% endif %}
        </p>

        {% if event.hasImage %}
            {{ image_tag(event, 'large', "Illustration de l'événement " ~ event.title, 'img-fluid rounded mb-4') }}
        {% endif %}

        <div class="article-content">
            {{ event.description|nl2br }}
        </div>

        {% if not isPast %}
            <div class="card bg-gm-surface border-gm-yellow mt-4">
                <div class="card-body">
                    <div class="d-flex flex-wrap justify-content-between align-items-center mb-2">
                        <h2 class="h6 mb-0"><i class="bi bi-person-check"></i> Inscription</h2>
                        {% if event.capacity %}
                            <span class="text-muted small">{{ participantCount }} / {{ event.capacity }} places</span>
                        {% elseif participantCount > 0 %}
                            <span class="text-muted small">{{ participantCount }} inscrit{{ participantCount > 1 ? 's' : '' }}</span>
                        {% endif %}
                    </div>

                    {% if event.capacity %}
                        {% set gauge = (participantCount / event.capacity * 100)|round %}
                        <div class="progress mb-3" role="progressbar" aria-label="Places occupées"
                             aria-valuenow="{{ gauge }}" aria-valuemin="0" aria-valuemax="100">
                            <div class="progress-bar {{ gauge >= 100 ? 'bg-danger' : 'bg-gm-green' }}"
                                 style="width: {{ gauge }}%"></div>
                        </div>
                    {% endif %}

                    {% if isRegistered %}
                        <span class="badge bg-gm-green text-white mb-2"><i class="bi bi-check-circle"></i> Vous êtes inscrit</span>
                        <form method="post" action="{{ path('app_event_unregister', {id: event.id}) }}"
                              class="d-inline">
                            <input type="hidden" name="_token" value="{{ csrf_token('unregister' ~ event.id) }}">
                            <button type="submit" class="btn btn-outline-gm-green btn-sm">
                                <i class="bi bi-x-circle"></i> Annuler mon inscription
                            </button>
                        </form>
                    {% elseif not app.user %}
                        <a href="{{ path('app_login') }}" class="btn btn-gm-green">
                            <i class="bi bi-box-arrow-in-right"></i> Se connecter pour participer
                        </a>
                    {% elseif event.isMembersOnly and not is_active_member %}
                        <button type="button" class="btn btn-gm-green" disabled>
                            <i class="bi bi-person-plus"></i> Je participe
                        </button>
                        <p class="text-muted small mt-2 mb-0">Réservé aux membres actifs de l'association.</p>
                    {% elseif isFull %}
                        <button type="button" class="btn btn-gm-green" disabled>
                            <i class="bi bi-person-x"></i> Complet
                        </button>
                    {% else %}
                        <form method="post" action="{{ path('app_event_register', {id: event.id}) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('register' ~ event.id) }}">
                            <button type="submit" class="btn btn-gm-green">
                                <i class="bi bi-person-plus"></i> Je participe
                            </button>
                        </form>
                    {% endif %}
                </div>
            </div>
        {% endif %}

        <a href="{{ path('app_event_ics', {id: event.id}) }}" class="btn btn-outline-gm-green mt-3">
            <i class="bi bi-calendar-plus"></i> Ajouter à mon calendrier (.ics)
        </a>

        {% if event.galleryImages|length > 0 %}
            <hr class="my-5">
            <h3><i class="bi bi-images"></i> Images de l'événement</h3>
            <div class="row g-3">
                {% for image in event.galleryImages %}
                    {% if image.isPublished %}
                        <div class="col-md-4">
                            {{ image_tag(image, 'medium', image.alt, 'img-fluid rounded') }}
                        </div>
                    {% endif %}
                {% endfor %}
            </div>
        {% endif %}

        {% if event.blogPosts|length > 0 %}
            <hr class="my-5">
            <h3><i class="bi bi-newspaper"></i> Articles liés</h3>
            <ul class="list-unstyled">
                {% for post in event.blogPosts|filter(post => post.isPublished)%}
                    <li><i class="bi bi-file-text"></i>
                        <a href="{{ path('app_blog_show', {'slug': post.slug}) }}">{{ post.title }}</a></li>
                {% endfor %}
            </ul>
        {% endif %}
    </div>
</article>
{% endblock %}
