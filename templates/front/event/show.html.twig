{% extends 'front/base.html.twig' %}

{% block title %}{{ event.title }} — {{ parent() }}{% endblock %}
{% block meta %}
    <meta name="description" content="{{ event.description|striptags|slice(0, 155) }}">
    <meta property="og:type" content="event">
    <meta property="og:title" content="{{ event.title }}">
    <meta property="og:description" content="{{ event.description|striptags|slice(0, 155) }}">
    <meta property="og:url" content="{{ app.request.uri }}">
    {% set hero_img = image_url(event, 'large') %}
    {% if hero_img %}
        <meta property="og:image" content="{{ absolute_url(asset(hero_img)) }}">
    {% endif %}
    <meta name="twitter:card" content="summary_large_image">
{% endblock %}

{% block body %}
{% include 'partials/_navbar.html.twig' %}

{% set hero_img = image_url(event, 'large') %}

{# ===== Hero : image de fond + titre par-dessus ===== #}
<header class="pres-show-hero {{ hero_img ? '' : 'pres-hero' }}">
    {% if hero_img %}
        <div class="pres-show-hero-bg" style="background-image: url('{{ hero_img }}')"></div>
        <div class="pres-show-hero-overlay"></div>
    {% endif %}
    <div class="container position-relative">
        <p class="mb-2">
            {% if event.isMembersOnly %}
                <span class="badge bg-gm-yellow text-gm-bg"><i class="bi bi-people me-1"></i> Réservé aux membres</span>
            {% endif %}
            {% if isPast %}
                <span class="badge bg-secondary text-white"><i class="bi bi-clock-history me-1"></i> Événement passé</span>
            {% else %}
                <span class="badge bg-gm-green text-gm-white"><i class="bi bi-stars me-1"></i> À venir</span>
            {% endif %}
        </p>
        <h1 class="pres-show-hero-title">{{ event.title }}</h1>
        <p class="pres-show-hero-excerpt mb-0">
            <i class="bi bi-calendar me-1"></i>
            {{ event.startDate|date('d/m/Y à H\\h i') }} — {{ event.endDate|date('d/m/Y à H\\h i') }}
            {% if event.location %}&nbsp;·&nbsp; <i class="bi bi-geo-alt me-1"></i>{{ event.location }}{% endif %}
        </p>
    </div>
</header>

<main class="container py-5">
    {{ breadcrumb() }}

    <div class="row g-4">
        {# ===== Colonne principale : description + contenus liés ===== #}
        <div class="col-lg-8">
            <article class="pres-show-content">
                <div class="article-content mb-0">
                    {{ event.description|nl2br }}
                </div>
            </article>

            {% set gallery = event.galleryImages|filter(i => i.isPublished) %}
            {% if gallery|length > 0 %}
                <section class="mt-5">
                    <h2 class="h4 mb-3"><i class="bi bi-images text-gm-yellow"></i> En images</h2>
                    <div class="row g-3">
                        {% for image in gallery %}
                            <div class="col-6 col-md-4">
                                {{ image_tag(image, 'medium', image.alt, 'home-mosaic w-100') }}
                            </div>
                        {% endfor %}
                    </div>
                </section>
            {% endif %}

            {% set related_projects = event.projects|filter(p => p.isPublished) %}
            {% if related_projects|length > 0 %}
                <section class="mt-5">
                    <h2 class="h4 mb-3"><i class="bi bi-kanban text-gm-green"></i> Projets liés</h2>
                    {% for project in related_projects %}
                        <a href="{{ path('app_project_show', {'slug': project.slug}) }}" class="proj-related mb-2">
                            <i class="bi bi-kanban fs-5 text-gm-green"></i>
                            <span class="flex-grow-1"><strong>{{ project.title }}</strong></span>
                            <i class="bi bi-arrow-right"></i>
                        </a>
                    {% endfor %}
                </section>
            {% endif %}

            {% set related_posts = event.blogPosts|filter(p => p.isPublished) %}
            {% if related_posts|length > 0 %}
                <section class="mt-5">
                    <h2 class="h4 mb-3"><i class="bi bi-newspaper text-gm-yellow"></i> Articles liés</h2>
                    {% for post in related_posts %}
                        <a href="{{ path('app_blog_show', {'slug': post.slug}) }}" class="proj-related mb-2">
                            <i class="bi bi-newspaper fs-5 text-gm-yellow"></i>
                            <span class="flex-grow-1"><strong>{{ post.title }}</strong></span>
                            <i class="bi bi-arrow-right"></i>
                        </a>
                    {% endfor %}
                </section>
            {% endif %}
        </div>

        {# ===== Colonne latérale : infos + inscription ===== #}
        <aside class="col-lg-4">
            <div class="gm-event-aside">
                {% if not isPast %}
                    <div class="bg-gm-surface border-gm-green rounded p-3 mb-3 text-center">
                        {% if event.startDate|date('U') >= 'now'|date('U') %}
                            <p class="small text-muted mb-1"><i class="bi bi-hourglass-split me-1"></i> Ça commence dans</p>
                            <span class="gm-countdown badge bg-gm-surface border-gm-yellow text-gm-yellow fs-6 w-100 py-2"
                                  data-start="{{ event.startDate|date(constant('DATE_ATOM')) }}">…</span>
                        {% else %}
                            <p class="mb-0 small text-muted"><i class="bi bi-lightning-charge me-1 text-gm-yellow"></i> L'événement est en cours !</p>
                        {% endif %}
                    </div>
                {% endif %}

                <div class="bg-gm-surface border-gm-yellow rounded p-3">
                    <h2 class="h6 mb-3"><i class="bi bi-person-check"></i> Inscription</h2>

                    {% if event.capacity %}
                        <div class="d-flex justify-content-between small mb-1">
                            <span class="text-muted">Places</span>
                            <strong>{{ participantCount }} / {{ event.capacity }}</strong>
                        </div>
                        {% set gauge = (participantCount / event.capacity * 100)|round %}
                        <div class="progress mb-3" role="progressbar" aria-label="Places occupées"
                             aria-valuenow="{{ gauge }}" aria-valuemin="0" aria-valuemax="100">
                            <div class="progress-bar {{ gauge >= 100 ? 'bg-danger' : 'bg-gm-green' }}"
                                 style="width: {{ gauge }}%"></div>
                        </div>
                    {% elseif participantCount > 0 %}
                        <p class="text-muted small mb-3">
                            {{ participantCount }} inscrit{{ participantCount > 1 ? 's' : '' }}
                        </p>
                    {% endif %}

                    {% if isPast %}
                        <p class="text-muted small mb-0"><i class="bi bi-clock-history me-1"></i> Inscriptions closes : cet événement est terminé.</p>
                    {% elseif isRegistered %}
                        <span class="badge bg-gm-green text-white mb-2"><i class="bi bi-check-circle"></i> Vous êtes inscrit</span>
                        <form method="post" action="{{ path('app_event_unregister', {id: event.id}) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('unregister' ~ event.id) }}">
                            <button type="submit" class="btn btn-outline-gm-green btn-sm w-100">
                                <i class="bi bi-x-circle"></i> Annuler mon inscription
                            </button>
                        </form>
                    {% elseif not app.user %}
                        <a href="{{ path('app_login') }}" class="btn btn-gm-green w-100">
                            <i class="bi bi-box-arrow-in-right"></i> Se connecter pour participer
                        </a>
                    {% elseif event.isMembersOnly and not is_active_member %}
                        <button type="button" class="btn btn-gm-green w-100" disabled>
                            <i class="bi bi-person-plus"></i> Je participe
                        </button>
                        <p class="text-muted small mt-2 mb-0">Réservé aux membres actifs — <a href="{{ path('app_membership_register') }}">rejoins l'assoc'</a> pour participer !</p>
                    {% elseif isFull %}
                        <button type="button" class="btn btn-gm-green w-100" disabled>
                            <i class="bi bi-person-x"></i> Complet
                        </button>
                    {% else %}
                        <form method="post" action="{{ path('app_event_register', {id: event.id}) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('register' ~ event.id) }}">
                            <button type="submit" class="btn btn-gm-green w-100">
                                <i class="bi bi-person-plus"></i> Je participe
                            </button>
                        </form>
                    {% endif %}
                </div>

                <div class="bg-gm-surface border-gm-yellow rounded p-3 mt-3">
                    <h2 class="h6 mb-3"><i class="bi bi-pin-map"></i> Infos pratiques</h2>
                    <p class="small mb-2">
                        <i class="bi bi-calendar text-gm-green me-1"></i>
                        {{ event.startDate|date('d/m/Y à H\\h i') }}<br>
                        <i class="bi bi-calendar-check text-gm-green me-1"></i>
                        {{ event.endDate|date('d/m/Y à H\\h i') }}
                    </p>
                    {% if event.location %}
                        <p class="small mb-2">
                            <i class="bi bi-geo-alt text-gm-green me-1"></i>
                            <a href="https://www.google.com/maps/search/?api=1&amp;query={{ event.location|url_encode }}"
                               target="_blank" rel="noopener">{{ event.location }}</a>
                        </p>
                    {% endif %}
                    <a href="{{ path('app_event_ics', {id: event.id}) }}" class="btn btn-outline-gm-green btn-sm w-100 mt-2">
                        <i class="bi bi-calendar-plus"></i> Ajouter à mon calendrier (.ics)
                    </a>
                </div>
            </div>
        </aside>
    </div>
</main>

<script>
(function () {
    var el = document.querySelector('.gm-countdown[data-start]');
    if (!el) { return; }
    var start = new Date(el.dataset.start).getTime();

    function pad(n) { return n < 10 ? '0' + n : '' + n; }

    function tick() {
        var diff = start - Date.now();
        if (isNaN(start) || diff <= 0) {
            el.innerHTML = '<i class="bi bi-lightning-charge me-1"></i> ' + "C'est parti !";
            return;
        }
        var d = Math.floor(diff / 86400000);
        var h = Math.floor(diff / 3600000) % 24;
        var m = Math.floor(diff / 60000) % 60;
        var s = Math.floor(diff / 1000) % 60;
        el.innerHTML = '<i class="bi bi-hourglass-split me-1"></i> ' +
            (d > 0 ? 'J-' + d + ' · ' : '') + pad(h) + 'h ' + pad(m) + 'min ' + pad(s) + 's';
        setTimeout(tick, 1000);
    }

    tick();
})();
</script>
{% endblock %}
