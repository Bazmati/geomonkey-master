{% extends 'front/base.html.twig' %}

{% import 'partials/_breadcrumb.html.twig' as breadcrumb_macros %}

{% block title %}{{ event.title }} — {{ parent() }}{% endblock %}
{% block meta %}
    <meta name="description" content="{{ event.description|striptags|slice(0, 155) }}">
    <meta property="og:type" content="event">
    <meta property="og:title" content="{{ event.title }}">
    <meta property="og:description" content="{{ event.description|striptags|slice(0, 155) }}">
    <meta property="og:url" content="{{ app.request.uri }}">
    {% if image_url %}
        <meta property="og:image" content="{{ absolute_url(asset(image_url)) }}">
    {% endif %}
    <meta name="twitter:card" content="summary_large_image">
{% endblock %}

{% block body %}
{% include 'partials/_navbar.html.twig' %}
<article class="py-5">
    <div class="container" style="max-width: 800px;">
        {{ breadcrumb() }}

        <h1 class="mb-3">{{ event.title }}</h1>

        <p class="text-muted">
            <i class="bi bi-calendar"></i>
            {{ event.startDate|date('d/m/Y H:i') }} — {{ event.endDate|date('d/m/Y H:i') }}
            &nbsp;·&nbsp; <i class="bi bi-geo-alt"></i> {{ event.location }}
            {% if event.isMembersOnly %}
                &nbsp;·&nbsp; <span class="badge bg-warning text-dark"><i class="bi bi-people"></i> Réservé aux membres</span>
            {% endif %}
        </p>

        {% if event.hasImage %}
            {{ image_tag(event, 'large', "Illustration de l'événement " ~ event.title, 'img-fluid rounded mb-4') }}
        {% endif %}

        <div class="article-content">
            {{ event.description|nl2br }}
        </div>

        {% if event.galleryImages|length > 0 %}
            <hr class="my-5">
            <h3><i class="bi bi-images"></i> Images de l'événement</h3>
            <div class="row g-3">
                {% for image in event.galleryImages %}
                    {% if image.isPublished %}
                        <div class="col-md-4">
                            {{ image_tag(image, 'medium', image.alt, 'img-fluid rounded') }}
                        </div>
                    {% endif %}
                {% endfor %}
            </div>
        {% endif %}
    </div>
</article>
{% if event.blogPosts|length > 0 %}
    <div class="card bg-light border-0 mt-4">
        <div class="card-body">
            <h3 class="h6 mb-2"><i class="bi bi-newspaper"></i> Articles liés</h3>
            <ul class="list-unstyled mb-0">
                {% for post in event.blogPosts|filter(post => post.isPublished)%}
                    <li><i class="bi bi-file-text"></i>
                        <a href="{{ path('app_blog_show', {'slug': post.slug}) }}">{{ post.title }}</a></li>
                {% endfor %}
            </ul>
        </div>
    </div>
{% endif %}
{% endblock %}