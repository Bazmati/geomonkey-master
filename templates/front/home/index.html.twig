{% extends 'front/base.html.twig' %}

{# SEO (title, meta) volontairement figé en français : URLs et contenu uniques. #}
{% block title %}GéoMonkey — Créer des événements culturels qui font rêver{% endblock %}
{% block meta_description %}GéoMonkey : association culturelle et conviviale. Concerts, ateliers, rencontres et projets créatifs, pour les jeunes et les moins jeunes. Rejoins-nous !{% endblock %}

{% block body %}
    {% include 'partials/_navbar.html.twig' %}

    {# ================= HERO : l'envie de rêve ================= #}
    <header class="home-hero">
        <div class="home-hero-overlay"></div>
        <div class="container position-relative">
            <div class="row align-items-center justify-content-center text-center">
                <div class="col-lg-9">
                    <span class="badge home-hero-badge mb-4">
                        <i class="bi bi-stars me-1"></i> {{ 'home.hero.badge'|trans }}
                    </span>
                    <h1 class="home-hero-title mb-4">
                        {{ 'home.hero.title_a'|trans }}
                        <span class="home-hero-highlight">{{ 'home.hero.title_b'|trans }}</span>
                    </h1>
                    <p class="home-hero-sub mb-4">{{ 'home.hero.sub'|trans }}</p>
                    <div class="d-flex flex-wrap justify-content-center gap-3">
                        <a href="{{ path('app_event_index') }}" class="btn btn-warning btn-lg fw-semibold px-4">
                            <i class="bi bi-calendar2-event me-2"></i>{{ 'home.hero.events_btn'|trans }}
                        </a>
                        <a href="{{ path('app_membership_register') }}" class="btn btn-success btn-lg fw-semibold px-4">
                            <i class="bi bi-person-plus me-2"></i>{{ 'home.hero.join_btn'|trans }}
                        </a>
                    </div>
                    <p class="home-hero-hint mt-4 mb-0">
                        <i class="bi bi-emoji-smile me-1"></i>
                        {{ 'home.hero.hint'|trans }}
                    </p>
                </div>
            </div>
        </div>
    </header>

    {# ================= PILIERS : ce qui nous anime ================= #}
    <section class="py-5">
        <div class="container">
            <div class="row g-4 home-fade-group text-center">
                <div class="col-md-4">
                    <div class="home-pillar">
                        <div class="home-pillar-icon text-success"><i class="bi bi-palette2"></i></div>
                        <h2 class="h4 text-warning">{{ 'home.pillar.create.title'|trans }}</h2>
                        <p class="text-muted mb-0">{{ 'home.pillar.create.text'|trans }}</p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="home-pillar">
                        <div class="home-pillar-icon text-warning"><i class="bi bi-people-fill"></i></div>
                        <h2 class="h4 text-warning">{{ 'home.pillar.share.title'|trans }}</h2>
                        <p class="text-muted mb-0">{{ 'home.pillar.share.text'|trans }}</p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="home-pillar">
                        <div class="home-pillar-icon text-danger"><i class="bi bi-balloon-heart-fill"></i></div>
                        <h2 class="h4 text-warning">{{ 'home.pillar.party.title'|trans }}</h2>
                        <p class="text-muted mb-0">{{ 'home.pillar.party.text'|trans }}</p>
                    </div>
                </div>
            </div>

            {# Chiffres clés animés #}
            <div class="row row-cols-2 row-cols-lg-4 g-3 mt-4 text-center">
                <div class="col">
                    <p class="home-stat-value text-success" data-count="{{ stats.events }}">0</p>
                    <p class="home-stat-label">{{ 'home.stat.events'|trans }}</p>
                </div>
                <div class="col">
                    <p class="home-stat-value text-warning" data-count="{{ stats.projects }}">0</p>
                    <p class="home-stat-label">{{ 'home.stat.projects'|trans }}</p>
                </div>
                <div class="col">
                    <p class="home-stat-value text-warning" data-count="{{ stats.members }}">0</p>
                    <p class="home-stat-label">{{ 'home.stat.members'|trans }}</p>
                </div>
                <div class="col">
                    <p class="home-stat-value text-success" data-count="{{ stats.posts }}">0</p>
                    <p class="home-stat-label">{{ 'home.stat.posts'|trans }}</p>
                </div>
            </div>
        </div>
    </section>

    {# ================= PROCHAINS ÉVÉNEMENTS ================= #}
    <section class="py-5 home-alt">
        <div class="container">
            <div class="d-flex flex-wrap justify-content-between align-items-end mb-4 gap-2">
                <div>
                    <h2 class="text-warning fw-bold mb-1">{{ 'home.upcoming.title'|trans }}</h2>
                    <p class="text-muted mb-0">{{ 'home.upcoming.sub'|trans }}</p>
                </div>
                <a href="{{ path('app_event_index') }}" class="btn btn-outline-warning btn-sm">
                    {{ 'home.upcoming.all'|trans }} <i class="bi bi-arrow-right ms-1"></i>
                </a>
            </div>

            {% if upcomingEvents is empty %}
                <div class="text-center py-5 text-muted">
                    <i class="bi bi-moon-stars fs-1"></i>
                    <p class="mt-2 mb-0">{{ 'home.upcoming.empty_a'|trans }}<br>
                    <a href="{{ path('app_membership_register') }}" class="link-warning">{{ 'home.upcoming.join'|trans }}</a> {{ 'home.upcoming.empty_b'|trans }}</p>
                </div>
            {% else %}
                <div class="row g-4">
                    {% for event in upcomingEvents %}
                        <div class="col-md-6 col-lg-4">
                            <a href="{{ path('app_event_show', {slug: event.slug}) }}" class="text-decoration-none">
                                <article class="home-card h-100">
                                    {% set media = image_url(event, 'medium') ?? (event.galleryImages is not empty ? image_url(event.galleryImages|first, 'medium') : null) %}
                                    {% if media %}
                                        <img src="{{ media }}" alt="" loading="lazy" class="home-card-img">
                                    {% else %}
                                        <div class="home-card-img home-card-img-empty">
                                            <i class="bi bi-calendar2-event"></i>
                                        </div>
                                    {% endif %}
                                    <div class="home-card-body">
                                        <div class="d-flex justify-content-between align-items-start gap-2">
                                            <h3 class="h5 text-light mb-1">{{ event.title }}</h3>
                                            <span class="home-date-chip">
                                                <span class="fw-bold">{{ event.startDate ? event.startDate|date('d') }}</span>
                                                <span class="small">{{ event.startDate ? event.startDate|date('M')|upper : '?' }}</span>
                                            </span>
                                        </div>
                                        <p class="text-muted small mb-2">
                                            <i class="bi bi-clock me-1"></i>{{ event.startDate ? event.startDate|date('d/m/Y H:i') : '—' }}
                                            {% if event.location %} · <i class="bi bi-geo-alt me-1"></i>{{ event.location }}{% endif %}
                                        </p>
                                        {% if event.isMembersOnly %}
                                            <span class="badge border-warning text-warning"><i class="bi bi-lock me-1"></i>{{ 'badge.members'|trans }}</span>
                                        {% else %}
                                            <span class="badge border-success text-success"><i class="bi bi-unlock me-1"></i>{{ 'badge.open_all'|trans }}</span>
                                        {% endif %}
                                    </div>
                                </article>
                            </a>
                        </div>
                    {% endfor %}
                </div>
            {% endif %}
        </div>
    </section>

    {# ================= PROJETS EN COURS ================= #}
    {% if ongoingProjects is not empty %}
        <section class="py-5">
            <div class="container">
                <div class="d-flex flex-wrap justify-content-between align-items-end mb-4 gap-2">
                    <div>
                        <h2 class="text-warning fw-bold mb-1">{{ 'home.projects.title'|trans }}</h2>
                        <p class="text-muted mb-0">{{ 'home.projects.sub'|trans }}</p>
                    </div>
                    <a href="{{ path('app_project_index') }}" class="btn btn-outline-warning btn-sm">
                        {{ 'home.projects.all'|trans }} <i class="bi bi-arrow-right ms-1"></i>
                    </a>
                </div>
                <div class="row g-4">
                    {% for project in ongoingProjects %}
                        <div class="col-md-6 col-lg-4">
                            <a href="{{ path('app_project_show', {slug: project.slug}) }}" class="text-decoration-none">
                                <article class="home-card h-100">
                                    {% set media = image_url(project, 'medium') %}
                                    {% if not media %}
                                        {% for task in project.tasks %}
                                            {% if not media and task.galleryImages is not empty %}
                                                {% set media = image_url(task.galleryImages|first, 'medium') %}
                                            {% endif %}
                                        {% endfor %}
                                    {% endif %}
                                    {% if media %}
                                        <img src="{{ media }}" alt="" loading="lazy" class="home-card-img">
                                    {% else %}
                                        <div class="home-card-img home-card-img-empty"><i class="bi bi-kanban"></i></div>
                                    {% endif %}
                                    <div class="home-card-body">
                                        <span class="badge {{ project.status.badgeClass }} mb-2">{{ project.status.label }}</span>
                                        <h3 class="h5 text-light mb-2">{{ project.title }}</h3>
                                        <p class="text-muted small mb-0">{{ project.status.publicTeaser }}</p>
                                    </div>
                                </article>
                            </a>
                        </div>
                    {% endfor %}
                </div>
            </div>
        </section>
    {% endif %}

    {# ================= DERNIÈRES ACTUS ================= #}
    {% if recentPosts is not empty %}
        <section class="py-5 home-alt">
            <div class="container">
                <div class="d-flex flex-wrap justify-content-between align-items-end mb-4 gap-2">
                    <div>
                        <h2 class="text-warning fw-bold mb-1">{{ 'home.news.title'|trans }}</h2>
                        <p class="text-muted mb-0">{{ 'home.news.sub'|trans }}</p>
                    </div>
                    <a href="{{ path('app_blog_index') }}" class="btn btn-outline-warning btn-sm">
                        {{ 'home.news.all'|trans }} <i class="bi bi-arrow-right ms-1"></i>
                    </a>
                </div>
                <div class="row g-4">
                    {% for post in recentPosts %}
                        <div class="col-md-6 col-lg-4">
                            <a href="{{ path('app_blog_show', {slug: post.slug}) }}" class="text-decoration-none">
                                <article class="home-card h-100">
                                    {% set media = image_url(post, 'medium') ?? (post.galleryImages is not empty ? image_url(post.galleryImages|first, 'medium') : null) %}
                                    {% if media %}
                                        <img src="{{ media }}" alt="" loading="lazy" class="home-card-img">
                                    {% else %}
                                        <div class="home-card-img home-card-img-empty"><i class="bi bi-journal-text"></i></div>
                                    {% endif %}
                                    <div class="home-card-body">
                                        {% if post.category %}
                                            <span class="badge bg-success mb-2">{{ post.category.name }}</span>
                                        {% endif %}
                                        <h3 class="h5 text-light mb-2">{{ post.title }}</h3>
                                        <p class="text-muted small mb-2">{{ post.summary ?? post.excerpt(120) }}</p>
                                        <p class="small text-secondary mb-0">
                                            <i class="bi bi-person me-1"></i>{{ post.author ? (post.author.firstName ~ ' ' ~ post.author.lastName) : 'home.author_bureau'|trans }}
                                            · {{ (post.publishedAt ?? post.createdAt)|date('d/m/Y') }}
                                        </p>
                                    </div>
                                </article>
                            </a>
                        </div>
                    {% endfor %}
                </div>
            </div>
        </section>
    {% endif %}

    {# ================= GALERIE ================= #}
    {% if galleryImages is not empty %}
        <section class="py-5">
            <div class="container">
                <div class="d-flex flex-wrap justify-content-between align-items-end mb-4 gap-2">
                    <div>
                        <h2 class="text-warning fw-bold mb-1">{{ 'home.gallery.title'|trans }}</h2>
                        <p class="text-muted mb-0">{{ 'home.gallery.sub'|trans }}</p>
                    </div>
                    <a href="{{ path('app_gallery_index') }}" class="btn btn-outline-warning btn-sm">
                        {{ 'home.gallery.all'|trans }} <i class="bi bi-images ms-1"></i>
                    </a>
                </div>
                <div class="row g-2 g-md-3">
                    {% for image in galleryImages %}
                        <div class="col-4 col-md-2">
                            <a href="{{ path('app_gallery_index') }}">
                                <img src="{{ image_url(image, 'medium') }}" alt="{{ image.alt }}" loading="lazy" class="home-mosaic">
                            </a>
                        </div>
                    {% endfor %}
                </div>
            </div>
        </section>
    {% endif %}

    {# ================= CTA ADHÉSION : le grand rêve ================= #}
    <section class="home-cta">
        <div class="container py-5 text-center">
            <p class="home-cta-kicker mb-2">{{ 'home.cta.kicker'|trans }}</p>
            <h2 class="display-6 fw-bold text-white mb-3">
                {{ 'home.cta.title_a'|trans }} <span class="text-warning">{{ 'home.cta.title_b'|trans }}</span>
            </h2>
            <p class="text-white-50 mb-4 col-lg-8 mx-auto">{{ 'home.cta.sub'|trans }}</p>
            <div class="d-flex flex-wrap justify-content-center gap-3">
                <a href="{{ path('app_membership_register') }}" class="btn btn-warning btn-lg fw-semibold px-4">
                    <i class="bi bi-person-plus me-2"></i>{{ 'home.cta.join'|trans }}
                </a>
                <a href="{{ path('app_donation') }}" class="btn btn-outline-light btn-lg px-4">
                    <i class="bi bi-heart me-2"></i>{{ 'home.cta.support'|trans }}
                </a>
            </div>
        </div>
    </section>

    {# ================= NEWSLETTER ================= #}
    <section class="py-5 home-alt">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-lg-5" id="newsletter">
                    <div class="card bg-dark text-light border-success shadow-sm">
                        <div class="card-body p-4">
                            <h2 class="text-warning fw-bold"><i class="bi bi-envelope-paper-heart me-2"></i>{{ 'nav.newsletter'|trans }}</h2>
                            <p class="text-muted">{{ 'home.newsletter.sub'|trans }}</p>
                            <form method="post" action="{{ path('app_newsletter_subscribe') }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('newsletter_subscribe') }}">
                                <div class="mb-3">
                                    <label for="newsletter_email" class="form-label">{{ 'form.email'|trans }}</label>
                                    <input type="email" class="form-control" id="newsletter_email" name="email" placeholder="{{ 'home.newsletter.placeholder'|trans }}" required>
                                </div>
                                <button type="submit" class="btn btn-success w-100 fw-semibold">
                                    <i class="bi bi-send me-1"></i>{{ 'home.newsletter.subscribe'|trans }}
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
{% endblock %}
