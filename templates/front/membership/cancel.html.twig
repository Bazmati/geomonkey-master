{# templates/front/membership/cancel.html.twig #}
{% extends 'front/base.html.twig' %}

{% block title %}Paiement annulé - GéoMonkey{% endblock %}

{% block body %}
    {% include 'partials/_navbar.html.twig' %}
    
    <div class="container py-5">
        <div class="row justify-content-center">
            <div class="col-lg-6 col-md-8 text-center">
                <div class="card shadow-sm border-gm-yellow">
                    <div class="card-header bg-gm-yellow text-gm-bg">
                        <h2 class="mb-0"><i class="bi bi-exclamation-triangle me-2"></i>Paiement annulé</h2>
                    </div>
                    <div class="card-body">
                        <div class="py-4">
                            <i class="bi bi-x-circle text-gm-yellow display-4"></i>
                            <h3 class="mt-3 text-gm-yellow">Paiement non effectué</h3>
                            <p class="lead text-gm-muted">
                                Tu as annulé le processus de paiement.
                            </p>
                            <p class="text-gm-muted">
                                Ton adhésion n'a pas été finalisée. Tu peux réessayer plus tard.
                            </p>
                            <div class="alert alert-gm-info">
                                <i class="bi bi-info-circle me-2"></i>
                                <strong>Pas de frais :</strong> Aucun montant ne t'a été prélevé.
                            </div>
                        </div>
                        <div class="d-flex gap-3 justify-content-center">
                            <a href="{{ path('app_membership_payment_required') }}" class="btn btn-gm-green">
                                <i class="bi bi-arrow-clockwise me-2"></i> Réessayer le paiement
                            </a>
                            <a href="{{ path('app_home') }}" class="btn btn-gm-green btn-outline">
                                <i class="bi bi-house me-2"></i> Retour à l'accueil
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
