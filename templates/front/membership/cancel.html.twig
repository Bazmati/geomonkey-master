{# templates/front/membership/cancel.html.twig #}
{% extends 'front/base.html.twig' %}

{% block title %}Paiement annulé - GéoMonkey{% endblock %}

{% block body %}
    <div class="container py-5">
        <div class="row justify-content-center">
            <div class="col-lg-6 col-md-8 text-center">
                <div class="card shadow-sm border-warning">
                    <div class="card-header bg-warning text-dark">
                        <h2 class="mb-0"><i class="bi bi-exclamation-triangle me-2"></i>Paiement annulé</h2>
                    </div>
                    <div class="card-body">
                        <div class="py-4">
                            <i class="bi bi-x-circle text-warning display-4"></i>
                            <h3 class="mt-3 text-warning">Paiement non effectué</h3>
                            <p class="lead text-muted">
                                Tu as annulé le processus de paiement.
                            </p>
                            <p class="text-muted">
                                Ton adhésion n'a pas été finalisée. Tu peux réessayer plus tard.
                            </p>
                            <div class="alert alert-info">
                                <i class="bi bi-info-circle me-2"></i>
                                <strong>Pas de frais :</strong> Aucun montant ne t'a été prélevé.
                            </div>
                        </div>
                        <div class="d-flex gap-3 justify-content-center">
                            <a href="{{ path('app_membership_payment_required') }}" class="btn btn-success">
                                <i class="bi bi-arrow-clockwise me-2"></i> Réessayer le paiement
                            </a>
                            <a href="{{ path('app_home') }}" class="btn btn-secondary">
                                <i class="bi bi-house me-2"></i> Retour à l'accueil
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
