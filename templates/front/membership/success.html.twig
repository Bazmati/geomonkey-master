{# templates/front/membership/success.html.twig #}
{% extends 'front/base.html.twig' %}

{% block title %}Adhésion confirmée - GéoMonkey{% endblock %}

{% block body %}
    {% include 'partials/_navbar.html.twig' %}
    
    <div class="container py-5">
        <div class="row justify-content-center">
            <div class="col-lg-6 col-md-8 text-center">
                <div class="card shadow-sm border-gm-green">
                    <div class="card-header bg-gm-green text-gm-white">
                        <h2 class="mb-0"><i class="bi bi-check-circle-fill me-2"></i>Adhésion confirmée !</h2>
                    </div>
                    <div class="card-body">
                        <div class="py-4">
                            <i class="bi bi-emoji-smile text-gm-green display-4"></i>
                            <h3 class="mt-3 text-gm-green">Bienvenue officiellement chez GéoMonkey ! 🎉</h3>
                            <p class="lead text-gm-muted">
                                Ton adhésion a été confirmée avec succès.
                            </p>
                            <p class="text-gm-muted">
                                Tu as maintenant accès à tous les contenus réservés aux membres actifs.
                            </p>
                            <div class="alert alert-gm-info">
                                <i class="bi bi-envelope me-2"></i>
                                Un email de confirmation t'a été envoyé à ton adresse email.
                            </div>
                        </div>
                        <a href="{{ path('app_home') }}" class="btn btn-gm-green btn-lg px-4">
                            <i class="bi bi-house me-2"></i> Retour à l'accueil
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
