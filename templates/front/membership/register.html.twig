{# templates/front/membership/register.html.twig #}
{% extends 'front/base.html.twig' %}

{% block title %}{{ 'register.title'|trans }}{% endblock %}

{% block meta %}
    <meta name="description" content="{{ 'register.meta'|trans }}">
{% endblock %}

{% block body %}
{% include 'partials/_navbar.html.twig' %}

{# ===== Fond vidéo en boucle (fallback : aurores animées CSS) ===== #}
<div class="gm-join-bg" aria-hidden="true">
    <div class="gm-join-aurora gm-join-aurora-green"></div>
    <div class="gm-join-aurora gm-join-aurora-yellow"></div>
    <video class="gm-join-video" autoplay muted loop playsinline preload="metadata" tabindex="-1" data-controller="video-background">
        <source src="{{ asset('videos/adhesion.mp4') }}" type="video/mp4">
        <source src="{{ asset('videos/adhesion.webm') }}" type="video/webm">
    </video>
    <div class="gm-join-veil"></div>
</div>

<main class="gm-join position-relative">
    <div class="container py-5">
        <div class="row g-5 align-items-center justify-content-center min-vh-90 py-4">

            {# ===== Colonne pitch : pourquoi rejoindre ===== #}
            <div class="col-lg-5 text-center text-lg-start">
                <span class="badge home-hero-badge mb-3">
                    <i class="bi bi-stars me-1"></i> {{ 'register.badge'|trans }}
                </span>
                <h1 class="gm-join-title mb-3">{{ 'register.title_a'|trans }}<br>{{ 'register.title_b'|trans }}</h1>
                <p class="gm-join-sub mb-4">
                    {{ 'register.sub'|trans }}
                </p>

                <ul class="list-unstyled gm-join-benefits">
                    <li>
                        <i class="bi bi-calendar-event"></i>
                        <div><strong>{{ 'register.b1t'|trans }}</strong><br>
                        <span class="small">{{ 'register.b1s'|trans }}</span></div>
                    </li>
                    <li>
                        <i class="bi bi-kanban"></i>
                        <div><strong>{{ 'register.b2t'|trans }}</strong><br>
                        <span class="small">{{ 'register.b2s'|trans }}</span></div>
                    </li>
                    <li>
                        <i class="bi bi-images"></i>
                        <div><strong>{{ 'register.b3t'|trans }}</strong><br>
                        <span class="small">{{ 'register.b3s'|trans }}</span></div>
                    </li>
                    <li>
                        <i class="bi bi-people"></i>
                        <div><strong>{{ 'register.b4t'|trans }}</strong><br>
                        <span class="small">{{ 'register.b4s'|trans }}</span></div>
                    </li>
                </ul>

                {# ===== Timeline : comment ça marche ===== #}
                <div class="gm-join-steps mt-4">
                    <p class="small text-uppercase fw-semibold text-gm-muted mb-2">
                        <i class="bi bi-signpost-split me-1"></i>{{ 'register.steps_title'|trans }}
                    </p>
                    <ol class="list-unstyled gm-join-benefits m-0">
                        <li>
                            <i class="bi bi-1-circle-fill"></i>
                            <div><strong>{{ 'register.step1t'|trans }}</strong><br>
                            <span class="small">{{ 'register.step1s'|trans }}</span></div>
                        </li>
                        <li>
                            <i class="bi bi-2-circle-fill"></i>
                            <div><strong>{{ 'register.step2t'|trans }}</strong><br>
                            <span class="small">{{ 'register.step2s'|trans }}</span></div>
                        </li>
                        <li>
                            <i class="bi bi-3-circle-fill"></i>
                            <div><strong>{{ 'register.step3t'|trans }}</strong><br>
                            <span class="small">{{ 'register.step3s'|trans }}</span></div>
                        </li>
                        <li>
                            <i class="bi bi-4-circle-fill"></i>
                            <div><strong>{{ 'register.step4t'|trans }}</strong><br>
                            <span class="small">{{ 'register.step4s'|trans }}</span></div>
                        </li>
                    </ol>
                </div>

                <div class="gm-join-price mt-4">
                    <span class="gm-join-price-value">{{ "%.2f"|format(membershipFee) }}&nbsp;€</span>
                    <span class="gm-join-price-label">{{ 'register.price_label'|trans|raw }}</span>
                </div>

                <p class="text-gm-muted small mt-2 mb-0">
                    <i class="bi bi-cash-coin me-1"></i>
                    {{ 'register.offline_note'|trans }}
                    <a href="mailto:contact@geomonkey.fr" class="text-gm-warning">{{ 'register.offline_contact'|trans }}</a>.
                </p>
            </div>

            {# ===== Colonne formulaire : carte verre dépoli ===== #}
            <div class="col-lg-6 col-md-9">
                <div class="gm-join-card">
                    <h2 class="gm-join-card-title">
                        <i class="bi bi-person-plus me-2"></i>{{ 'register.card_title'|trans }}
                    </h2>
                    <p class="text-gm-muted small mb-4">
                        {{ 'register.card_sub'|trans }}
                    </p>

                    {% for message in app.flashes('warning') %}
                        <div class="alert alert-gm-warning">{{ message }}</div>
                    {% endfor %}
                    {% for message in app.flashes('danger') %}
                        <div class="alert alert-gm-danger">{{ message }}</div>
                    {% endfor %}

                    {{ form_start(form) }}
                        <div class="row g-3">
                            <div class="col-md-6 mb-3">
                                {{ form_label(form.firstName, null, {'label_attr': {'class': 'form-label fw-semibold'}}) }}
                                <div class="input-group">
                                    <span class="input-group-text bg-gm-light"><i class="bi bi-person text-gm-text"></i></span>
                                    {{ form_widget(form.firstName, {'attr': {'class': 'form-control form-control-lg', 'placeholder': 'register.ph_firstname'|trans}}) }}
                                </div>
                                <div class="text-gm-danger">{{ form_errors(form.firstName) }}</div>
                            </div>

                            <div class="col-md-6 mb-3">
                                {{ form_label(form.lastName, null, {'label_attr': {'class': 'form-label fw-semibold'}}) }}
                                <div class="input-group">
                                    <span class="input-group-text bg-gm-light"><i class="bi bi-person text-gm-text"></i></span>
                                    {{ form_widget(form.lastName, {'attr': {'class': 'form-control form-control-lg', 'placeholder': 'register.ph_lastname'|trans}}) }}
                                </div>
                                <div class="text-gm-danger">{{ form_errors(form.lastName) }}</div>
                            </div>

                            <div class="col-12 mb-3">
                                {{ form_label(form.email, null, {'label_attr': {'class': 'form-label fw-semibold'}}) }}
                                <div class="input-group">
                                    <span class="input-group-text bg-gm-light"><i class="bi bi-envelope text-gm-text"></i></span>
                                    {{ form_widget(form.email, {'attr': {'class': 'form-control form-control-lg', 'placeholder': 'auth.ph_email'|trans}}) }}
                                </div>
                                <div class="text-gm-danger">{{ form_errors(form.email) }}</div>
                            </div>

                            <div class="col-12 mb-3">
                                {{ form_label(form.plainPassword, null, {'label_attr': {'class': 'form-label fw-semibold'}}) }}
                                <div class="input-group" data-controller="password-toggle">
                                    <span class="input-group-text bg-gm-light"><i class="bi bi-lock text-gm-text"></i></span>
                                    {{ form_widget(form.plainPassword, {'attr': {'class': 'form-control form-control-lg', 'placeholder': 'register.ph_password'|trans, 'data-password-toggle-target': 'input'}}) }}
                                    <button class="btn btn-outline-secondary" type="button"
                                        data-action="password-toggle#toggle"
                                        aria-label="{{ 'auth.show_password'|trans }}">
                                        <i class="bi bi-eye" data-password-toggle-target="icon"></i>
                                    </button>
                                </div>
                                <div class="form-text">{{ 'register.pw_hint'|trans }}</div>
                                <div class="text-gm-danger">{{ form_errors(form.plainPassword) }}</div>
                            </div>

                            <div class="col-12 mb-3">
                                {{ form_label(form.requestedFunction, null, {'label_attr': {'class': 'form-label fw-semibold'}}) }}
                                {{ form_widget(form.requestedFunction) }}
                                <div class="text-gm-danger">{{ form_errors(form.requestedFunction) }}</div>
                            </div>

                            <div class="col-12 mb-3">
                                <div class="form-check">
                                    {{ form_widget(form.agreeTerms, {'attr': {'class': 'form-check-input'}}) }}
                                    {{ form_label(form.agreeTerms, null, {'label_attr': {'class': 'form-check-label ms-2'}}) }}
                                </div>
                                <div class="text-gm-danger">{{ form_errors(form.agreeTerms) }}</div>
                            </div>

                            <div class="col-12 mb-3">
                                <div class="form-check">
                                    {{ form_widget(form.imageConsent, {'attr': {'class': 'form-check-input'}}) }}
                                    {{ form_label(form.imageConsent, null, {'label_attr': {'class': 'form-check-label ms-2 text-gm-muted'}}) }}
                                </div>
                                <div class="text-gm-danger">{{ form_errors(form.imageConsent) }}</div>
                            </div>

                            <div class="col-12 mb-4">
                                {# Cloudflare Turnstile CAPTCHA #}
                                {{ form_widget(form.cf_turnstile_response) }}
                                <div class="text-gm-danger">{{ form_errors(form.cf_turnstile_response) }}</div>
                            </div>

                            <div class="col-12">
                                <button type="submit" class="btn btn-warning btn-lg w-100 fw-bold py-3 border-radius-8">
                                    <i class="bi bi-person-plus-fill me-2"></i> {{ 'register.submit'|trans }}
                                </button>
                            </div>
                        </div>
                    {{ form_end(form) }}

                    <div class="mt-4 text-center">
                        <p class="text-gm-muted small mb-0">
                            {{ 'register.has_account'|trans }} <a href="{{ path('app_login') }}" class="text-gm-warning">{{ 'auth.submit'|trans }}</a>
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</main>


{% endblock %}
