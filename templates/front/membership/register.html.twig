{# templates/front/membership/register.html.twig #}
{% extends 'front/base.html.twig' %}

{% block title %}Inscription - GéoMonkey{% endblock %}

{% block body %}
    {% include 'partials/_navbar.html.twig' %}
    
    <div class="container py-5">
        <div class="row justify-content-center">
            <div class="col-lg-6 col-md-8">
                <div class="card shadow-sm border-warning">
                    <div class="card-header bg-warning text-dark text-center">
                        <h2 class="mb-0"><i class="bi bi-person-plus me-2"></i>Rejoindre GéoMonkey</h2>
                    </div>
                    
                    <div class="card-body">
                        <div class="alert alert-info mb-4">
                            <i class="bi bi-info-circle me-2"></i>
                            <strong>Bienvenue !</strong> L'adhésion annuelle à GéoMonkey coûte 
                            <strong>{{ "%.2f"|format(membershipFee) }} €</strong>.
                        </div>

                        {{ form_start(form) }}
                            <div class="row g-3">
                                <div class="col-md-6">
                                    {{ form_label(form.firstName) }}
                                    <div class="input-group">
                                        <span class="input-group-text bg-light">
                                            <i class="bi bi-person text-dark"></i>
                                        </span>
                                        {{ form_widget(form.firstName, {'attr': {'class': 'form-control', 'placeholder': 'Prénom'}}) }}
                                    </div>
                                    <div class="text-danger">
                                        {{ form_errors(form.firstName) }}
                                    </div>
                                </div>
                                
                                <div class="col-md-6">
                                    {{ form_label(form.lastName) }}
                                    <div class="input-group">
                                        <span class="input-group-text bg-light">
                                            <i class="bi bi-person text-dark"></i>
                                        </span>
                                        {{ form_widget(form.lastName, {'attr': {'class': 'form-control', 'placeholder': 'Nom'}}) }}
                                    </div>
                                    <div class="text-danger">
                                        {{ form_errors(form.lastName) }}
                                    </div>
                                </div>
                                
                                <div class="col-12">
                                    {{ form_label(form.email) }}
                                    <div class="input-group">
                                        <span class="input-group-text bg-light">
                                            <i class="bi bi-envelope text-dark"></i>
                                        </span>
                                        {{ form_widget(form.email, {'attr': {'class': 'form-control', 'placeholder': 'votre@email.com'}}) }}
                                    </div>
                                    <div class="text-danger">
                                        {{ form_errors(form.email) }}
                                    </div>
                                </div>
                                
                                <div class="col-12">
                                    {{ form_label(form.plainPassword) }}
                                    <div class="input-group">
                                        <span class="input-group-text bg-light">
                                            <i class="bi bi-lock text-dark"></i>
                                        </span>
                                        {{ form_widget(form.plainPassword, {'attr': {'class': 'form-control', 'placeholder': 'Mot de passe'}}) }}
                                    </div>
                                    <div class="text-danger">
                                        {{ form_errors(form.plainPassword) }}
                                    </div>
                                </div>
                                
                                <div class="col-12">
                                    {{ form_label(form.requestedFunction) }}
                                    <div class="card border-light mb-3">
                                        <div class="card-body p-3">
                                            <div class="form-check">
                                                {{ form_widget(form.requestedFunction, {'attr': {'class': 'form-check-input'}}) }}
                                                <label class="form-check-label ms-2" for="registration_requestedFunction">
                                                    <strong>Simple visiteur</strong> <span class="badge bg-secondary">Gratuit</span>
                                                    <br>
                                                    <small class="text-muted">Accès aux contenus publics uniquement</small>
                                                </label>
                                            </div>
                                            <div class="form-check mt-2">
                                                <input type="radio" class="form-check-input" id="membre_actif" 
                                                       name="registration[requestedFunction]" value="membre_actif">
                                                <label class="form-check-label ms-2" for="membre_actif">
                                                    <strong>Membre actif</strong> <span class="badge bg-success">{{ "%.2f"|format(membershipFee) }} €/an</span>
                                                    <br>
                                                    <small class="text-muted">Accès complet + participation aux événements. Validation du bureau nécessaire.</small>
                                                </label>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="text-danger">
                                        {{ form_errors(form.requestedFunction) }}
                                    </div>
                                </div>
                                
                                <div class="col-12">
                                    <div class="form-check">
                                        {{ form_widget(form.agreeTerms, {'attr': {'class': 'form-check-input'}}) }}
                                        {{ form_label(form.agreeTerms, null, {'label_attr': {'class': 'form-check-label ms-2'}}) }}
                                    </div>
                                    <div class="text-danger">
                                        {{ form_errors(form.agreeTerms) }}
                                    </div>
                                </div>
                                
                                <div class="col-12">
                                    <button type="submit" class="btn btn-warning btn-lg w-100">
                                        <i class="bi bi-person-plus-fill me-2"></i> S'inscrire
                                    </button>
                                </div>
                            </div>
                        {{ form_end(form) }}

                        <div class="mt-4 text-center">
                            <p class="text-muted small">
                                Déjà un compte ? <a href="{{ path('app_login') }}" class="text-warning">Se connecter</a>
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
