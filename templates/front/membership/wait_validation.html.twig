{# templates/front/membership/wait_validation.html.twig #}
{% extends 'front/base.html.twig' %}

{% block title %}{{ 'register.wait.page_title'|trans }} - GéoMonkey{% endblock %}

{% block body %}
    {% include 'partials/_navbar.html.twig' %}
    
    <div class="container py-5">
        <div class="row justify-content-center">
            <div class="col-lg-6 col-md-8 text-center">
                <div class="card shadow-sm border-gm-info">
                    <div class="card-header bg-gm-info text-gm-bg">
                        <h2 class="mb-0"><i class="bi bi-clock-history me-2"></i>{{ 'register.wait.header'|trans }}</h2>
                    </div>
                    <div class="card-body">
                        {# Marque : logo + wordmark commun au site #}
                        <img src="{{ asset('images/Logo_geomonkey.png') }}" alt="Logo GéoMonkey" class="mx-auto d-block mb-2 rounded-circle" width="56" height="56">
                        <div class="fw-bold mb-2">Géo<span class="text-gm-yellow">Monkey</span></div>
                        <div class="py-4">
                            <i class="bi bi-envelope-paper text-gm-info display-4"></i>
                            <h3 class="mt-3 text-gm-info">{{ 'register.wait.h3'|trans }}</h3>
                            <p class="lead text-gm-muted">
                                {{ 'register.wait.p1'|trans }}
                            </p>
                            <p class="text-gm-muted">
                                {{ 'register.wait.p2'|trans }}
                            </p>
                            <p class="text-gm-muted">
                                {{ 'register.wait.p3'|trans }}
                            </p>
                        </div>
                        <div class="alert alert-gm-warning">
                            <i class="bi bi-exclamation-triangle me-2"></i>
                            {{ 'register.wait.important'|trans|raw }}
                        </div>
                        <a href="{{ path('app_home') }}" class="btn btn-gm-info">
                            <i class="bi bi-house me-2"></i> {{ 'legal.back_home'|trans }}
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
