{% extends 'front/base.html.twig' %}

{% block title %}Connexion - GéoMonkey{% endblock %}

{% block body %}
    {% include 'partials/_navbar.html.twig' %}

    <div class="min-vh-100 d-flex flex-column bg-gm-bg">
        {# Lien de retour en haut #}
        <div class="p-3">
            <a href="{{ path('app_home') }}" class="btn btn-outline-warning btn-sm">
                <i class="bi bi-arrow-left"></i> Retour à l'accueil
            </a>
        </div>

    {# Contenu principal #}
    <div class="flex-grow-1 d-flex align-items-center justify-content-center p-4">
        <div class="col-lg-4 col-md-6 col-sm-8">
            {# Card de connexion #}
            <div class="card border-warning shadow-lg border-radius-15 overflow-hidden">
                {# En-tête avec logo #}
                <div class="card-header bg-gm-warning text-gm-bg text-center py-4">
                    <img src="{{ asset('images/logo.png') }}" alt="GéoMonkey" class="img-fluid rounded-circle border border-3 border-gm-bg img-avatar">
                    <h2 class="h4 mt-3 mb-0 fw-bold">GéoMonkey</h2>
                    <p class="mb-0 small">Espace membre</p>
                </div>

                {# Corps de la card #}
                <div class="card-body bg-gm-surface text-gm-text">
                    {% if app.user %}
                        <div class="alert alert-info mb-4">
                            Vous êtes déjà connecté en tant que <strong>{{ app.user.userIdentifier }}</strong>, 
                            <a href="{{ logout_path() }}" class="alert-link text-gm-green">Se déconnecter</a>
                        </div>
                    {% endif %}

                    {% if error %}
                        <div class="alert alert-danger mb-4">
                            <strong>Erreur :</strong> {{ error.messageKey|trans(error.messageData, 'security') }}
                        </div>
                    {% endif %}

                    <form method="post" class="needs-validation" novalidate>
                        {# Champ Email #}
                        <div class="mb-4">
                            <label for="inputEmail" class="form-label fw-semibold">Email</label>
                            <div class="input-group">
                                <span class="input-group-text bg-gm-light text-gm-text border-0">
                                    <i class="bi bi-envelope"></i>
                                </span>
                                <input type="email" id="inputEmail" name="_username"
                                    class="form-control form-control-lg"
                                    autocomplete="email" placeholder="votre@email.com"
                                    value="{{ last_username }}" required autofocus>
                            </div>
                        </div>

                        {# Champ Mot de passe #}
                        <div class="mb-4">
                            <label for="inputPassword" class="form-label fw-semibold">Mot de passe</label>
                            <div class="input-group">
                                <span class="input-group-text bg-gm-light text-gm-text border-0">
                                    <i class="bi bi-lock"></i>
                                </span>
                                <input type="password" id="inputPassword" name="_password"
                                    class="form-control form-control-lg"
                                    autocomplete="current-password" placeholder="••••••••" required>
                            </div>
                        </div>

                        {# Protection CSRF (indispensable si enable_csrf_protection: true dans security.yaml) #}
                        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                        {# Option Se souvenir de moi — à activer seulement si "remember_me" est configuré dans security.yaml #}
                        
                        <div class="mb-4 form-check">
                            <input type="checkbox" id="rememberMe" name="_remember_me" class="form-check-input">
                            <label for="rememberMe" class="form-check-label">Se souvenir de moi</label>
                        </div>
                       

                        {# Bouton de connexion #}
                        <button class="btn btn-warning btn-lg w-100 fw-bold py-3 border-radius-8" type="submit">
                            <i class="bi bi-box-arrow-in-right me-2"></i> Se connecter
                        </button>
                    </form>



                    {# Lien mot de passe oublié - placeholder #}
                    <div class="mt-4 text-center">
                        <small class="text-gm-muted">
                            <a href="#" class="text-gm-warning text-decoration-none">Mot de passe oublié ?</a>
                        </small>
                    </div>
                </div>

                {# Pied de la card #}
                <div class="card-footer bg-gm-warning text-gm-bg text-center py-2 small">
                    <p class="mb-0">Pas encore membre ? <a href="{{ path('app_membership_register') }}" class="fw-bold text-gm-bg">Rejoignez-nous</a></p>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
