{# templates/front/security/reset_password.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Réinitialiser mot de passe - GéoMonkey{% endblock %}

{% block body %}
<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h2 class="card-title mb-0">🔐 Réinitialiser votre mot de passe</h2>
                </div>
                <div class="card-body">
                    <div class="text-center mb-4">
                        <i class="fas fa-lock fa-4x text-primary mb-3"></i>
                    </div>
                    
                    <p class="text-muted mb-4">
                        Entrez votre nouveau mot de passe (minimum 12 caractères).
                    </p>
                    
                    {% for message in app.flashes('error') %}
                        <div class="alert alert-danger">
                            {{ message }}
                        </div>
                    {% endfor %}
                    
                    <form method="post" action="" class="needs-validation">
                        <div class="mb-3">
                            <label for="plainPassword" class="form-label">Nouveau mot de passe</label>
                            <input type="password" 
                                   class="form-control form-control-lg" 
                                   id="plainPassword" 
                                   name="plainPassword" 
                                   placeholder="Min. 12 caractères"
                                   required
                                   autocomplete="new-password"
                                   minlength="12">
                            <div class="invalid-feedback">
                                Le mot de passe doit faire au moins 12 caractères.
                            </div>
                            <small class="form-text text-muted">
                                Utilisez majuscules, minuscules, chiffres et symboles pour plus de sécurité.
                            </small>
                        </div>
                        
                        <div class="mb-4">
                            <label for="confirmPassword" class="form-label">Confirmer le mot de passe</label>
                            <input type="password" 
                                   class="form-control form-control-lg" 
                                   id="confirmPassword" 
                                   name="confirmPassword" 
                                   placeholder="Confirmez votre mot de passe"
                                   required
                                   autocomplete="new-password">
                            <div class="invalid-feedback">
                                Les mots de passe ne correspondent pas.
                            </div>
                        </div>
                        
                        <button type="submit" class="btn btn-primary btn-lg w-100">
                            <i class="fas fa-sync-alt me-2"></i> Réinitialiser le mot de passe
                        </button>
                    </form>
                    
                    <hr>
                    
                    <div class="text-center">
                        <p class="mb-0">
                            <a href="{{ path('app_login') }}" class="text-decoration-none">
                                <i class="fas fa-arrow-left me-2"></i> Retour à la connexion
                            </a>
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
