{# templates/front/security/reset_password.html.twig #}
{% extends 'front/base.html.twig' %}

{% block title %}{{ 'auth.reset.title'|trans }} - GéoMonkey{% endblock %}

{% block body %}
{% include 'partials/_navbar.html.twig' %}
<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow">
                <div class="card-header bg-gm-green text-gm-white">
                    <h2 class="card-title mb-0">🔐 {{ 'auth.reset.title'|trans }}</h2>
                </div>
                <div class="card-body">
                    <div class="text-center mb-4">
                        <i class="bi bi-lock-fill fs-1 text-gm-green mb-3"></i>
                    </div>
                    
                    <p class="text-gm-muted mb-4">
                        {{ 'auth.reset.sub'|trans }}
                    </p>
                    
                    {% for message in app.flashes('error') %}
                        <div class="alert alert-gm-danger">
                            {{ message }}
                        </div>
                    {% endfor %}
                    
                    <form method="post" action="" class="needs-validation">
                        <div class="mb-3">
                            <label for="plainPassword" class="form-label">{{ 'auth.reset.label_new'|trans }}</label>
                            <input type="password" 
                                   class="form-control form-control-lg" 
                                   id="plainPassword" 
                                   name="plainPassword" 
                                   placeholder="{{ 'auth.reset.ph_new'|trans }}"
                                   required
                                   autocomplete="new-password"
                                   minlength="12">
                            <div class="invalid-feedback">
                                {{ 'auth.reset.invalid'|trans }}
                            </div>
                            <small class="form-text text-gm-muted">
                                {{ 'auth.reset.hint'|trans }}
                            </small>
                        </div>
                        
                        <div class="mb-4">
                            <label for="confirmPassword" class="form-label">{{ 'auth.reset.label_confirm'|trans }}</label>
                            <input type="password" 
                                   class="form-control form-control-lg" 
                                   id="confirmPassword" 
                                   name="confirmPassword" 
                                   placeholder="{{ 'auth.reset.ph_confirm'|trans }}"
                                   required
                                   autocomplete="new-password">
                            <div class="invalid-feedback">
                                {{ 'auth.reset.invalid_match'|trans }}
                            </div>
                        </div>
                        
                        <button type="submit" class="btn btn-gm-green btn-lg w-100">
                            <i class="bi bi-arrow-clockwise me-2"></i> {{ 'auth.reset.submit'|trans }}
                        </button>
                    </form>
                    
                    <hr>
                    
                    <div class="text-center">
                        <p class="mb-0">
                            <a href="{{ path('app_login') }}" class="text-gm-warning text-decoration-none">
                                <i class="bi bi-arrow-left me-2"></i> {{ 'auth.back_login'|trans }}
                            </a>
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
