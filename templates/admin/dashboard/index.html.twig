{% extends 'admin/base.html.twig' %}

{% block admin_content %}
    <div class="p-4">
        <h1 class="text-dark mb-4">Tableau de bord</h1>

        {# Cartes statistiques #}
        {% include 'admin/partials/_stats.html.twig' with {'stats': stats} %}

        {# Prochains événements #}
        <div class="card mt-4 shadow-sm">
            <div class="card-header bg-dark text-light d-flex justify-content-between align-items-center">
                <h5 class="mb-0"><i class="bi bi-calendar-event"></i> Prochains événements</h5>
                <a href="{{ path('admin_events_index') }}" class="btn btn-sm btn-warning">
                    <i class="bi bi-list"></i> Tous les événements
                </a>
            </div>
            <div class="card-body">
                {% if upcomingEvents is empty %}
                    <div class="text-center text-muted py-4">
                        <i class="bi bi-inbox fs-1"></i>
                        <p class="mt-2">Aucun événement à venir</p>
                    </div>
                {% else %}
                    {% for event in upcomingEvents %}
                        <div class="mb-3 p-3 bg-light rounded border">
                            <h6 class="text-dark">{{ event.title }}</h6>
                            <p class="mb-1 text-dark"><i class="bi bi-calendar"></i> {{ event.date }}</p>
                            <p class="mb-0 text-dark"><i class="bi bi-geo-alt"></i> {{ event.location }}</p>
                        </div>
                    {% endfor %}
                {% endif %}
            </div>
        </div>
    </div>
{% endblock %}
