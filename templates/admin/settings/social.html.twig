{% extends 'admin/base.html.twig' %}

{% block admin_content %}
    <div class="p-4">
        <h1 class="text-success mb-4"><i class="bi bi-share"></i> Paramètres — Réseaux sociaux</h1>

        <div class="alert alert-info" role="alert">
            <i class="bi bi-info-circle"></i>
            <strong>Activer</strong> un réseau affiche son bouton de partage sur les articles publiés.
            <strong>Publication automatique</strong> diffuse en plus chaque article mis en ligne sur ce
            réseau (disponible pour Facebook, Instagram, LinkedIn et X ; les tokens d'API sont
            configurés sur le serveur, jamais ici).
        </div>

        <div class="card shadow-sm">
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-striped table-hover table-light align-middle">
                        <thead class="table-dark text-light">
                            <tr>
                                <th>Réseau</th>
                                <th>Statut</th>
                                <th>Partage</th>
                                <th>Publication auto</th>
                                <th>Identifiant cible</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for platform, setting in settings %}
                                {% set icon = setting.platform.icon() %}
                                {% set label = setting.platform.label() %}
                                <tr>
                                    <td><i class="bi {{ icon }} fs-4"></i> <strong>{{ label }}</strong></td>
                                    <td>
                                        <span class="badge bg-{{ setting.enabled ? 'success' : 'secondary' }}">
                                            {{ setting.enabled ? 'Activé' : 'Désactivé' }}
                                        </span>
                                    </td>
                                    <td>
                                        {% if platform.supportsShareUrl is defined %}
                                            {# placeholder non utilisé : voir share_buttons #}
                                        {% endif %}
                                        <span class="text-muted small">
                                            {% if setting.enabled %}
                                                Bouton visible sur les articles
                                            {% else %}
                                                Masqué
                                            {% endif %}
                                        </span>
                                    </td>
                                    <td>
                                        {% if not setting.platform.supportsAutoPublish() %}
                                            <span class="text-muted small">Non disponible sur ce réseau</span>
                                        {% else %}
                                            <form method="post"
                                                  action="{{ path('app_admin_social_toggle_auto', {'id': setting.id}) }}"
                                                  class="d-inline">
                                                <input type="hidden" name="_token"
                                                       value="{{ csrf_token('social-auto' ~ setting.id) }}">
                                                <button class="btn btn-sm btn-{{ setting.autoPublish ? 'success' : 'outline-secondary' }}"
                                                        type="submit"
                                                        {{ not setting.enabled ? 'disabled' }}>
                                                    <i class="bi bi-{{ setting.autoPublish ? 'check-circle-fill' : 'circle' }}"></i>
                                                    {{ setting.autoPublish ? 'Activée' : 'Désactivée' }}
                                                </button>
                                            </form>
                                            {% if setting.autoPublish and not setting.isAutoPublishReady %}
                                                <div class="text-danger small mt-1">
                                                    <i class="bi bi-exclamation-triangle"></i>
                                                    Identifiant manquant
                                                </div>
                                            {% endif %}
                                        {% endif %}
                                    </td>
                                    <td>
                                        <form method="post"
                                              action="{{ path('app_admin_social_external_id', {'id': setting.id}) }}"
                                              class="d-flex gap-1">
                                            <input type="hidden" name="_token"
                                                   value="{{ csrf_token('social-ext' ~ setting.id) }}">
                                            <input type="text" name="external_id" class="form-control form-control-sm"
                                                   style="max-width: 220px;"
                                                   value="{{ setting.externalId }}"
                                                   placeholder="ID page, URN…">
                                            <button class="btn btn-sm btn-outline-primary" type="submit" title="Enregistrer">
                                                <i class="bi bi-save"></i>
                                            </button>
                                        </form>
                                    </td>
                                    <td>
                                        <form method="post"
                                              action="{{ path('app_admin_social_toggle', {'id': setting.id}) }}"
                                              class="d-inline">
                                            <input type="hidden" name="_token"
                                                   value="{{ csrf_token('social-toggle' ~ setting.id) }}">
                                            <button class="btn btn-sm btn-{{ setting.enabled ? 'outline-danger' : 'outline-success' }}"
                                                    type="submit">
                                                <i class="bi bi-{{ setting.enabled ? 'x-circle' : 'check-circle' }}"></i>
                                                {{ setting.enabled ? 'Désactiver' : 'Activer' }}
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
{% endblock %}