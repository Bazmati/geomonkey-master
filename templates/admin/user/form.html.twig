{% extends 'admin/base.html.twig' %}

{% block title %}{{ title }} - GéoMonkey{% endblock %}

{% block admin_content %}
<h1 class="h3 mb-4"><i class="bi bi-person-plus me-2"></i>{{ title }}</h1>

<div class="card bg-dark border-warning">
    <div class="card-body">
        {{ form_start(form, {'attr': {'class': 'row g-3'}}) }}
        <div class="col-md-6">{{ form_row(form.firstName) }}</div>
        <div class="col-md-6">{{ form_row(form.lastName) }}</div>
        <div class="col-md-6">{{ form_row(form.email) }}</div>
        <div class="col-md-6">{{ form_row(form.plainPassword) }}</div>
        <div class="col-md-4">{{ form_row(form.officeFunction) }}</div>
        <div class="col-md-4">{{ form_row(form.membershipValidUntil) }}</div>
        <div class="col-md-4 d-flex align-items-end">
            <div class="form-check form-switch mb-2">
                {{ form_widget(form.isAdmin) }}
                {{ form_label(form.isAdmin) }}
            </div>
        </div>
        <div class="col-12 d-flex gap-2 mt-4">
            <button class="btn btn-warning fw-semibold">
                <i class="bi bi-check-lg"></i> Enregistrer
            </button>
            <a href="{{ path('app_admin_user_index') }}" class="btn btn-outline-secondary">Annuler</a>
        </div>
        {{ form_end(form) }}
    </div>
</div>
{% endblock %}