{% extends 'admin/base.html.twig' %}

{% set page_title = 'Utilisateurs' %}

{% block admin_content %}
<div class="p-4">

    
    <h1 class="text-gm-green mb-4"><i class="bi bi-people me-2"></i>Utilisateurs</h1>

    <div class="d-flex justify-content-end gap-2 mb-3">
        <a href="{{ path('app_admin_export_users') }}" class="btn btn-gm-yellow" title="Exporter tous les utilisateurs">
            <i class="bi bi-download"></i> Export CSV
        </a>
        <a href="{{ path('app_admin_export_users', {members: 1}) }}" class="btn btn-outline-gm-yellow" title="Uniquement les adhérents avec adhésion active">
            <i class="bi bi-download"></i> Membres actifs
        </a>
        <a href="{{ path('app_admin_user_new') }}" class="btn btn-gm-green">
            <i class="bi bi-plus-circle"></i> Nouvel utilisateur
        </a>
    </div>
</div>

<div class="table-responsive">
    <table class="table-mobile-cards table table-gm table-hover align-middle">
        <thead>
            <tr>
                <th>Nom</th>
                <th>Email</th>
                <th>Fonction</th>
                <th>Rôle</th>
                <th>Adhésion</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
        {% for user in users %}
            <tr>
                <td data-label="Nom">
                {% include 'admin/partials/_card_media.html.twig' with {media: null, icon: 'bi-person-badge'} %}
                {{ user.lastName }} {{ user.firstName }}
            </td>
                <td data-label="Email">{{ user.email }}</td>
                <td data-label="Fonction">{{ user.officeFunction.value }}</td>
                <td data-label="Rôle">
                    {% if 'ROLE_ADMIN' in user.roles %}
                        <span class="badge bg-gm-warning text-gm-bg">Admin</span>
                    {% else %}
                        <span class="badge bg-gm-gray-600 text-gm-white">Membre</span>
                    {% endif %}
                </td>
                <td data-label="Adhésion">
                    {% if user.hasActiveMembership() %}
                        <span class="badge bg-gm-green text-gm-white">Valide jusqu'au {{ user.membershipValidUntil|date('d/m/Y') }}</span>
                    {% else %}
                        <span class="badge bg-gm-danger text-gm-white">Expirée</span>
                    {% endif %}
                </td>
                <td class="text-end" data-label="Actions">
                    <a href="{{ path('app_admin_user_edit', {id: user.id}) }}"
                       class="btn btn-sm btn-outline-gm-yellow"><i class="bi bi-pencil"></i></a>
                    {% include 'front/partials/_delete_button.html.twig' with {
                        id: user.id,
                        path: path('app_admin_user_delete', {id: user.id}),
                        entity_type: 'utilisateur',
                        confirm_message: 'Êtes-vous sûr de vouloir supprimer cet utilisateur ?',
                        csrf_token: csrf_token('delete' ~ user.id)
                    } %}
                </td>
            </tr>
        {% else %}
            <tr><td colspan="6" class="text-center text-gm-muted py-4">Aucun utilisateur</td></tr>
        {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}