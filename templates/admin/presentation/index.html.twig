{% extends 'admin/base.html.twig' %}

{% block admin_content %}
    {% set page_title = 'Pages de présentation' %}
    
    <div class="p-4">
        {{ breadcrumb() }}
        
        <div class="d-flex justify-content-end mb-3">
            <a href="{{ path('app_admin_presentation_new') }}" class="btn btn-gm-green">
                <i class="bi bi-plus-circle"></i> Nouvelle page
            </a>
        </div>

        <div class="card shadow-sm">
            <div class="card-body">
                {% if pages is empty %}
                    <div class="text-center py-4">
                        <i class="bi bi-file-text fs-1 text-gm-muted"></i>
                        <p class="mt-2 text-gm-muted">Aucune page de présentation</p>
                        <a href="{{ path('app_admin_presentation_new') }}" class="btn btn-gm-green">
                            <i class="bi bi-plus-circle"></i> Créer la première page
                        </a>
                    </div>
                {% else %}
                    <div class="table-responsive">
                        <table class="table table-gm table-striped table-hover">
                            <thead>
                                <tr>
                                    <th>Position</th>
                                    <th>Titre</th>
                                    <th>Slug</th>
                                    <th>Image</th>
                                    <th>Visible</th>
                                    <th>Mise à jour</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for page in pages %}
                                    <tr>
                                        <td>{{ page.position }}</td>
                                        <td><strong>{{ page.title }}</strong></td>
                                        <td><code>{{ page.slug }}</code></td>
                                        <td>
                                            {% if page.galleryImage %}
                                                <span class="badge bg-{{ page.galleryImage.isPublished ? 'gm-green' : 'gm-gray-600' }} text-gm-white">
                                                    {{ page.galleryImage.isPublished ? 'Publiée' : 'En attente' }}
                                                </span>
                                            {% else %}
                                                <span class="text-gm-muted">—</span>
                                            {% endif %}
                                        </td>
                                        <td>
                                            <span class="badge bg-{{ page.isActive ? 'gm-green' : 'gm-gray-600' }} text-gm-white">
                                                {{ page.isActive ? 'Oui' : 'Brouillon' }}
                                            </span>
                                        </td>
                                        <td>{{ page.updatedAt ? page.updatedAt|date('d/m/Y H:i') : '—' }}</td>
                                        <td>
                                            <div class="d-flex gap-1">
                                                <a href="{{ path('app_presentation_show', {'slug': page.slug}) }}"
                                                   class="btn btn-sm btn-gm-surface" title="Voir" target="_blank">
                                                    <i class="bi bi-eye-fill"></i>
                                                </a>
                                                {% if is_granted('ENTITY_EDIT') %}
                                                    <a href="{{ path('app_admin_presentation_edit', {'id': page.id}) }}"
                                                       class="btn btn-sm btn-gm-yellow" title="Modifier">
                                                        <i class="bi bi-pencil-fill"></i>
                                                    </a>
                                                    <form method="post"
                                                          action="{{ path('app_admin_presentation_toggle_active', {'id': page.id}) }}"
                                                          class="d-inline">
                                                        <input type="hidden" name="_token"
                                                               value="{{ csrf_token('toggle' ~ page.id) }}">
                                                        <button class="btn btn-sm btn-{{ page.isActive ? 'outline-gm-gray' : 'outline-gm-green' }}"
                                                                type="submit"
                                                                title="{{ page.isActive ? 'Masquer' : 'Rendre visible' }}">
                                                            <i class="bi bi-{{ page.isActive ? 'eye-slash' : 'eye' }}-fill"></i>
                                                        </button>
                                                    </form>
                                                {% endif %}
                                                {% if is_granted('ENTITY_DELETE') %}
                                                    {{ include('admin/presentation/_delete_form.html.twig', {'page': page}) }}
                                                {% endif %}
                                            </div>
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
{% endblock %}