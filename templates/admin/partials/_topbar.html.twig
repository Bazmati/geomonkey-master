{# templates/admin/partials/_topbar.html.twig #}
{# Topbar sticky pour toutes les pages admin #}
{# Titres personnalisables via {% set page_title = 'Votre titre' %} dans les templates #}
{% set route = app.request.attributes.get('_route') %}
{% set page_title = page_title|default(null) %}

<div class="admin-topbar sticky-top">
    <div class="d-flex align-items-center justify-content-between p-3 w-100">
        {# gauche : titre + breadcrumb #}
        <div class="d-flex align-items-center gap-3">
            <button type="button" class="btn btn-outline-gm-yellow d-lg-none" onclick="document.querySelector('.admin-shell').classList.toggle('sidebar-open')" 
                    aria-label="Toggle sidebar" aria-expanded="false">
                <i class="bi bi-list"></i>
            </button>
            <div>
                {{ breadcrumb() }}
            </div>
        </div>
        
        {# droite : bouton retour + futur slot recherche #}
        <div class="d-flex align-items-center gap-2">
            {# Slot pour barre de recherche globale (Ctrl+K) #}
            <button type="button"
                    class="btn btn-outline-gm-yellow btn-sm d-none d-md-inline-flex align-items-center gap-2"
                    data-bs-toggle="modal"
                    data-bs-target="#gmSearchModal"
                    aria-label="Recherche globale (Ctrl+K)">
                <i class="bi bi-search"></i>
                <span class="d-none d-lg-inline">Rechercher</span>
                <kbd class="d-none d-lg-inline gm-kbd">Ctrl K</kbd>
            </button>
            <a href="{{ path('app_home') }}" class="btn btn-gm-yellow btn-sm" aria-label="Retour au site public">
                <i class="bi bi-arrow-left"></i> Site public
            </a>
        </div>
    </div>
</div>
{% include 'admin/partials/_search_modal.html.twig' %}