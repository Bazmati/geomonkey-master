{# templates/admin/partials/_topbar.html.twig #}
{# Topbar sticky pour toutes les pages admin #}
{# Titres personnalisables via {% set page_title = 'Votre titre' %} dans les templates #}

<div class="admin-topbar sticky-top">
    <div class="admin-topbar-inner d-flex align-items-center justify-content-between w-100">
        {# gauche : fil d'Ariane #}
        <div class="d-flex align-items-center gap-3 gm-minw-0">
            <div class="gm-minw-0">
                {{ breadcrumb() }}
            </div>
        </div>

        {# droite : recherche + site public + burger (drawer à droite) #}
        <div class="d-flex align-items-center gap-2">
            {# Slot pour barre de recherche globale (Ctrl+K) #}
            <button type="button"
                    class="btn btn-outline-gm-yellow btn-sm d-none d-md-inline-flex align-items-center gap-2"
                    data-bs-toggle="modal"
                    data-bs-target="#gmSearchModal"
                    aria-label="Recherche globale (Ctrl+K)">
                <i class="bi bi-search"></i>
                <span class="d-none d-lg-inline">Rechercher</span>
                <kbd class="d-none d-lg-inline gm-kbd">Ctrl K</kbd>
            </button>
            <a href="{{ path('app_home') }}" class="btn btn-gm-yellow btn-sm" aria-label="Retour au site public">
                <i class="bi bi-arrow-left"></i> <span class="d-none d-sm-inline">Site public</span>
            </a>
            {# Burger mobile : à droite, drawer latéral droit #}
            <button type="button"
                    class="btn btn-outline-gm-yellow d-lg-none"
                    data-action="admin-sidebar#toggle"
                    aria-label="Ouvrir le menu" aria-expanded="false">
                <i class="bi bi-list"></i>
            </button>
        </div>
    </div>
</div>
{# Backdrop du drawer (visible < lg quand la sidebar est ouverte) #}
<div class="admin-backdrop" data-admin-sidebar-target="backdrop" data-action="click->admin-sidebar#close"></div>
{% include 'admin/partials/_search_modal.html.twig' %}
