<div class="admin-nav">
    <a class="d-flex align-items-center mb-4 text-decoration-none" href="{{ path('app_admin_dashboard') }}">
        <span class="gm-nav-logo flex-shrink-0" style="width:40px;height:40px;">
            <img src="{{ asset('images/Logo_geomonkey.png') }}" alt="GéoMonkey"
                 onerror="this.onerror=null;this.src='{{ asset('images/logo.png') }}';this.classList.add('rounded-circle');">
        </span>
        <span class="fw-bold text-gm-warning">Admin Panel</span>
    </a>
    
    {# Menu dynamique - route courante #}
    {% set route = app.request.attributes.get('_route') %}
    {% set menu = [
        {label: 'Tableau de bord', icon: 'house', route: 'app_admin_dashboard', match: 'app_admin_dashboard'},
        {label: 'Présentation', icon: 'newspaper', route: 'app_admin_presentation_index', match: 'app_admin_presentation'},
        {label: 'Actualités', icon: 'newspaper', route: 'app_admin_blog_index', match: 'app_admin_blog'},
        {label: 'Catégories blog', icon: 'folder', route: 'admin_blog_category_index', match: 'admin_blog_category'},
        {label: 'Tags blog', icon: 'tag', route: 'admin_blog_tag_index', match: 'admin_blog_tag'},
        {label: 'Événements', icon: 'calendar', route: 'admin_events_index', match: 'admin_events'},
        {label: 'Galerie', icon: 'images', route: 'app_admin_gallery_image_index', match: 'app_admin_gallery_image'},
        {label: 'Projets', icon: 'kanban', route: 'admin_projects_index', match: 'admin_projects'},
        {label: 'Boutique', icon: 'shop', route: '#', match: 'app_admin_shop'},
        {label: 'Billetterie', icon: 'ticket-perforated', route: '#', match: 'app_admin_ticket'},
        {label: 'Utilisateurs', icon: 'people', route: 'app_admin_user_index', match: 'app_admin_user'},
        {label: 'Adhésions', icon: 'person-plus', route: 'app_admin_membership_requests', match: 'app_admin_membership'},
        {label: 'Tarif adhésion', icon: 'currency-euro', route: 'app_admin_membership_fee_index', match: 'app_admin_membership_fee'},
        {label: 'Messages', icon: 'envelope', route: '#', match: 'app_admin_message'},
        {label: 'Paramètres', icon: 'gear', route: '#', match: 'app_admin_settings'},
    ] %}
    {# Fin du menu - les entrées avec route='#' sont des placeholders pour modules futurs #}
    
    {% for item in menu %}
        {% if item.route != '#' %}
            <a class="nav-link {{ route starts with item.match ? 'active' : '' }}" 
               href="{{ path(item.route) }}">
                <i class="bi bi-{{ item.icon }}"></i> {{ item.label }}
            </a>
        {% else %}
            <a class="nav-link disabled" href="#">
                <i class="bi bi-{{ item.icon }}"></i> {{ item.label }}
            </a>
        {% endif %}
    {% endfor %}
</div>