{% set route = app.request.attributes.get('_route') %}

{# ============ Petits helpers (macros locaux) ============ #}
{% macro navItem(item, route) %}
    {% if item.route != '#' %}
        <a class="nav-link {{ route starts with item.match ? 'active' : '' }}"
           href="{{ path(item.route) }}">
            <i class="bi bi-{{ item.icon }}"></i> {{ item.label }}
        </a>
    {% else %}
        <a class="nav-link disabled" href="#" tabindex="-1" aria-disabled="true">
            <i class="bi bi-{{ item.icon }}"></i> {{ item.label }}
        </a>
    {% endif %}
{% endmacro %}

{% macro navSection(title) %}
    <div class="nav-section">{{ title }}</div>
{% endmacro %}

{# Groupe repliable (dropdown) avec détection d'activité sur les enfants #}
{% macro navGroup(id, icon, label, items, route) %}
    {% set groupActive = false %}
    {% for item in items %}
        {% if item.route != '#' and route starts with item.match %}{% set groupActive = true %}{% endif %}
    {% endfor %}
    <div class="nav-group {{ groupActive ? 'active-group' : '' }}">
        <button type="button"
                class="nav-link nav-group-toggle"
                data-bs-toggle="collapse"
                data-bs-target="#admin-nav-{{ id }}"
                aria-expanded="{{ groupActive ? 'true' : 'false' }}"
                aria-controls="admin-nav-{{ id }}">
            <i class="bi bi-{{ icon }}"></i> {{ label }}
            <i class="bi bi-chevron-down nav-group-chevron"></i>
        </button>
        <div class="collapse {{ groupActive ? 'show' : '' }}" id="admin-nav-{{ id }}">
            <div class="nav-group-items">
                {% for item in items %}
                    {{ _self.navItem(item, route) }}
                {% endfor %}
            </div>
        </div>
    </div>
{% endmacro %}

<div class="admin-nav">
    {# ============ Marque ============ #}
    <a class="admin-brand d-flex align-items-center gap-2 text-decoration-none" href="{{ path('app_admin_dashboard') }}">
        <span class="gm-nav-logo flex-shrink-0" style="width:40px;height:40px;">
            <img src="{{ asset('images/Logo_geomonkey.png') }}" alt="GéoMonkey"
                 onerror="this.onerror=null;this.src='{{ asset('images/logo.png') }}';this.classList.add('rounded-circle');">
        </span>
        <span class="admin-brand-text d-flex flex-column">
            <span class="fw-bold text-gm-warning">Monkey Admin</span>
            <span class="admin-brand-sub">GéoMonkey</span>
        </span>
    </a>

    {# ============ Pilotage ============ #}
    {{ _self.navSection('Pilotage') }}
    {{ _self.navItem({label: 'Tableau de bord', icon: 'speedometer2', route: 'app_admin_dashboard', match: 'app_admin_dashboard'}, route) }}
    {{ _self.navItem({label: 'Présentation', icon: 'newspaper', route: 'app_admin_presentation_index', match: 'app_admin_presentation'}, route) }}

    {# ============ Blog (dropdown) ============ #}
    {{ _self.navSection('Contenus') }}
    {{ _self.navGroup('blog', 'newspaper', 'Blog', [
        {label: 'Actualités', icon: 'journal-text', route: 'app_admin_blog_index', match: 'app_admin_blog'},
        {label: 'Catégories', icon: 'folder', route: 'admin_blog_category_index', match: 'admin_blog_category'},
        {label: 'Tags', icon: 'tag', route: 'admin_blog_tag_index', match: 'admin_blog_tag'},
    ], route) }}

    {# ============ Événements (dropdown) ============ #}
    {{ _self.navGroup('events', 'calendar-event', 'Événements', [
        {label: 'Tous les événements', icon: 'calendar2-week', route: 'admin_events_index', match: 'admin_events'},
        {label: 'Catégories', icon: 'folder', route: 'admin_event_category_index', match: 'admin_event_category'},
        {label: 'Tags', icon: 'tag', route: 'admin_event_tag_index', match: 'admin_event_tag'},
    ], route) }}

    {{ _self.navItem({label: 'Galerie', icon: 'images', route: 'app_admin_gallery_image_index', match: 'app_admin_gallery_image'}, route) }}
    {{ _self.navItem({label: 'Projets', icon: 'kanban', route: 'admin_projects_index', match: 'admin_projects'}, route) }}

    {# ============ Communauté ============ #}
    {{ _self.navSection('Communauté') }}
    {{ _self.navItem({label: 'Utilisateurs', icon: 'people', route: 'app_admin_user_index', match: 'app_admin_user'}, route) }}
    {# ============ Adhésions (dropdown si encaissement hors-ligne autorisé) ============ #}
    {# Le droplist « Encaisser hors-ligne » n'apparaît que pour qui peut encaisser
       (ENTITY_CASH : trésorier et président) ; le reste du bureau garde l'entrée simple. #}
    {% if is_granted('ENTITY_CASH') %}
        {{ _self.navGroup('membership', 'person-plus', 'Adhésions', [
            {label: 'Liste des adhésions', icon: 'list-ul', route: 'app_admin_membership_requests', match: 'app_admin_membership_re'},
            {label: 'Encaisser hors-ligne', icon: 'cash-coin', route: 'app_admin_membership_offline', match: 'app_admin_membership_offline'},
        ], route) }}
    {% else %}
        {{ _self.navItem({label: 'Adhésions', icon: 'person-plus', route: 'app_admin_membership_requests', match: 'app_admin_membership'}, route) }}
    {% endif %}
    {{ _self.navItem({label: 'Tarif adhésion', icon: 'currency-euro', route: 'app_admin_membership_fee_index', match: 'app_admin_membership_fee'}, route) }}
    {# Dons : dropdown si encaissement hors-ligne autorisé (ENTITY_CASH :
       trésorier et président) ; le reste du bureau garde l'entrée simple. #}
    {% if is_granted('ENTITY_CASH') %}
        {{ _self.navGroup('dons', 'heart', 'Dons', [
            {label: 'Liste des dons', icon: 'list-ul', route: 'app_admin_donation_index', match: 'app_admin_donation_index'},
            {label: 'Encaisser un don', icon: 'cash-coin', route: 'app_admin_donation_offline', match: 'app_admin_donation_offline'},
        ], route) }}
    {% else %}
        {{ _self.navItem({label: 'Dons', icon: 'heart', route: 'app_admin_donation_index', match: 'app_admin_donation'}, route) }}
    {% endif %}

    {# ============ Modules à venir (placeholders) ============ #}
    {{ _self.navSection('Modules') }}
    {{ _self.navItem({label: 'Boutique', icon: 'shop', route: '#', match: 'app_admin_shop'}, route) }}
    {{ _self.navItem({label: 'Billetterie', icon: 'ticket-perforated', route: '#', match: 'app_admin_ticket'}, route) }}
    {{ _self.navItem({label: 'Messages', icon: 'envelope', route: 'app_admin_message_index', match: 'app_admin_message'}, route) }}
    {{ _self.navItem({label: 'Paramètres', icon: 'gear', route: '#', match: 'app_admin_settings'}, route) }}
</div>
