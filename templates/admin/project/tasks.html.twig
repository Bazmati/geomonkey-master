{% extends 'admin/base.html.twig' %}

{% set page_title = 'Tâches : ' ~ project.title %}

{% block admin_content %}
    <div class="p-4">


        <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-4">
            <div>
                <h1 class="text-gm-green mb-1"><i class="bi bi-list-check"></i> Tâches du projet</h1>
                <p class="text-gm-muted small mb-2">
                    {{ project.title }} —
                    <span class="badge {{ project.status.badgeClass }}">{{ project.status.label }}</span>
                </p>
                <span class="text-gm-muted small">
                    Avancement : {{ project.progressPercent }} % ({{ project.doneTasksCount }} / {{ project.tasks|length }})
                </span>
            </div>
            <div class="d-flex flex-wrap gap-2">
                <a href="{{ path('admin_projects_index') }}" class="btn btn-outline-gm-gray">
                    <i class="bi bi-arrow-left"></i> Retour aux projets
                </a>
                <a href="{{ path('admin_projects_task_new', {id: project.id}) }}" class="btn btn-gm-green">
                    <i class="bi bi-plus-circle"></i> Nouvelle tâche
                </a>
            </div>
        </div>

        <div class="card shadow-sm">
            <div class="card-body">
                {% if project.tasks is empty %}
                    <div class="text-center py-4 text-gm-muted-light">
                        <i class="bi bi-list-check fs-1"></i>
                        <p class="mt-2">Aucune tâche pour le moment. Créez la première pour suivre l'avancement du projet.</p>
                    </div>
                {% else %}
                    <div class="table-responsive d-none d-md-block">
                        <table class="table table-gm table-striped table-hover gm-cards-table">
                            <thead>
                                <tr>
                                    <th>Tâche</th>
                                    <th>État</th>
                                    <th>Responsable</th>
                                    <th>Documents</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for task in project.tasks %}
                                    <tr>
                                        <td data-label="Tâche">
                                            <strong>{{ task.title }}</strong>
                                            {% if task.description %}
                                                <br><span class="text-gm-muted small">{{ task.description|striptags|slice(0, 80) }}{% if task.description|length > 80 %}…{% endif %}</span>
                                            {% endif %}
                                        </td>
                                        <td data-label="État">
                                            <span class="badge {{ task.state.badgeClass }}">
                                                <i class="bi {{ task.state.icon }}"></i> {{ task.state.label }}
                                            </span>
                                        </td>
                                        <td data-label="Responsable">
                                            {% if task.assignee %}
                                                {{ task.assignee.firstName }} {{ task.assignee.lastName }}
                                            {% else %}
                                                <span class="text-gm-muted">—</span>
                                            {% endif %}
                                        </td>
                                        <td data-label="Documents">
                                            {% if task.documents|length > 0 %}
                                                <ul class="list-unstyled mb-0 small">
                                                    {% for document in task.documents %}
                                                        <li class="d-flex align-items-center gap-1">
                                                            <a href="{{ path('admin_projects_task_document_download', {document: document.id}) }}">
                                                                <i class="bi {{ document.icon }}"></i> {{ document.originalName }}
                                                            </a>
                                                            {% include 'front/partials/_delete_button.html.twig' with {
                                                                id: document.id,
                                                                path: path('admin_projects_task_document_delete', {document: document.id}),
                                                                entity_type: 'document',
                                                                confirm_message: 'Retirer le document « ' ~ document.originalName ~ ' » de cette tâche ?',
                                                                csrf_token: csrf_token('task-doc-delete' ~ document.id)
                                                            } %}
                                                        </li>
                                                    {% endfor %}
                                                </ul>
                                            {% else %}
                                                <span class="text-gm-muted small">Aucun</span>
                                            {% endif %}
                                        </td>
                                        <td data-label="Actions">
                                            <div class="d-flex gap-1">
                                                <a href="{{ path('admin_projects_task_edit', {taskId: task.id}) }}" class="btn btn-sm btn-gm-yellow" title="Modifier">
                                                    <i class="bi bi-pencil-fill"></i>
                                                </a>
                                                {% include 'front/partials/_delete_button.html.twig' with {
                                                    id: task.id,
                                                    path: path('admin_projects_task_delete', {taskId: task.id}),
                                                    entity_type: 'tâche',
                                                    confirm_message: 'Êtes-vous sûr de vouloir supprimer la tâche « ' ~ task.title ~ ' » ?',
                                                    csrf_token: csrf_token('task-delete' ~ task.id)
                                                } %}
                                            </div>
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>

                    {# ============================================================
                       MOBILE : chaque tâche devient une carte complète
                       ============================================================ #}
                    <div class="d-md-none">
                        {% for task in project.tasks %}
                            <div class="card mb-3 gm-admin-card">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between align-items-start mb-2">
                                        <h6 class="mb-0 text-gm-text">{{ task.title }}</h6>
                                        <span class="badge {{ task.state.badgeClass }} ms-2 flex-shrink-0">{{ task.state.label }}</span>
                                    </div>
                                    {% if task.assignee %}
                                        <p class="mb-2 small text-gm-muted">
                                            <i class="bi bi-person me-1"></i> {{ task.assignee.firstName }} {{ task.assignee.lastName }}
                                        </p>
                                    {% endif %}
                                    {% for document in task.documents %}
                                        <p class="mb-1 small">
                                            <a href="{{ path('admin_projects_task_document_download', {document: document.id}) }}">
                                                <i class="bi {{ document.icon }}"></i> {{ document.originalName }}
                                            </a>
                                        </p>
                                    {% endfor %}
                                    <div class="d-flex flex-wrap gap-2 mt-2">
                                        <a href="{{ path('admin_projects_task_edit', {taskId: task.id}) }}" class="btn btn-sm btn-gm-yellow">
                                            <i class="bi bi-pencil-fill"></i> Modifier
                                        </a>
                                        {% include 'front/partials/_delete_button.html.twig' with {
                                            id: task.id,
                                            path: path('admin_projects_task_delete', {taskId: task.id}),
                                            entity_type: 'tâche',
                                            confirm_message: 'Êtes-vous sûr de vouloir supprimer la tâche « ' ~ task.title ~ ' » ?',
                                            csrf_token: csrf_token('task-delete' ~ task.id),
                                            suffix: 'm'
                                        } %}
                                    </div>
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
{% endblock %}
