{% extends 'admin/base.html.twig' %}

{% block admin_content %}
    {% set page_title = 'Modifier : ' ~ project.title %}
    
    <div class="p-4">
        {{ breadcrumb() }}
        
        <div class="card bg-gm-surface border-gm-yellow">
            <div class="card-header bg-gm-surface d-flex justify-content-end">
                <a href="{{ path('admin_projects_index') }}" class="btn btn-gm-surface btn-sm">
                    <i class="bi bi-arrow-left"></i> Retour à la liste
                </a>
            </div>

            <div class="card-body">
                <h1 class="text-gm-green mb-4">Modifier le projet « {{ project.title }} »</h1>
                {{ include('admin/project/_form.html.twig', {'button_label': 'Enregistrer'}) }}
            </div>

            <div class="card-footer bg-gm-surface d-flex justify-content-end">
                <button type="submit" form="project-form" class="btn btn-gm-green">
                    <i class="bi bi-check-circle"></i> Enregistrer
                </button>
            </div>
        </div>
    </div>
{% endblock %}
