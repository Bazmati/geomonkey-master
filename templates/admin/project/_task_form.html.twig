{{ form_start(form, {'attr': {'class': 'row g-3', 'id': 'project-task-form'}}) }}
    <div class="col-md-6">
        {{ form_row(form.title, {'attr': {'class': 'form-control'}}) }}
        {{ form_row(form.state, {'attr': {'class': 'form-select'}}) }}
        {{ form_row(form.assignee, {'attr': {'class': 'form-select'}}) }}
    </div>

    <div class="col-md-6">
        {{ form_row(form.description, {'attr': {'class': 'form-control', 'rows': 5}}) }}
        {{ form_row(form.galleryImages, {'attr': {'class': 'form-select', 'size': 5}}) }}
        {{ form_row(form.newDocuments, {'attr': {'class': 'form-control'}}) }}

        {% if task.documents|length > 0 %}
            <div class="mb-3">
                <label class="form-label">Documents actuels</label>
                <ul class="list-unstyled mb-0 small">
                    {% for document in task.documents %}
                        <li>
                            <a href="{{ asset(document.webPath) }}" target="_blank" rel="noopener">
                                <i class="bi {{ document.icon }}"></i> {{ document.originalName }}
                            </a>
                            <span class="text-gm-muted">({{ document.formattedSize }})</span>
                        </li>
                    {% endfor %}
                </ul>
                <div class="form-text">Les documents actuels se retirent depuis la liste des tâches.</div>
            </div>
        {% endif %}
    </div>
{{ form_end(form) }}
