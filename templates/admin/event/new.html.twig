{% extends 'admin/base.html.twig' %}

{% block admin_content %}
    {% set page_title = 'Créer un nouvel événement' %}
    
    <div class="p-4">
        {{ breadcrumb() }}
        
        <div class="card bg-gm-surface border-gm-yellow">
            {# === EN-TÊTE AVEC BOUTON RETOUR À DROITE === #}
            <div class="card-header bg-gm-surface d-flex justify-content-end">
                <a href="{{ path('admin_events_index') }}" class="btn btn-gm-surface btn-sm">
                    <i class="bi bi-arrow-left"></i> Retour à la liste
                </a>
            </div>

            {# === CORPS DE LA CARD === #}
            <div class="card-body">
                <h1 class="text-gm-green mb-4">Créer un nouvel événement</h1>
                {{ include('admin/event/_form.html.twig', {'button_label': 'Enregistrer'}) }}
            </div>

            {# === PIED DE CARD AVEC BOUTON VALIDER À DROITE === #}
            <div class="card-footer bg-gm-surface d-flex justify-content-end">
                <button type="submit" form="event-form" class="btn btn-gm-green">
                    <i class="bi bi-check-circle"></i> Enregistrer
                </button>
            </div>
        </div>
    </div>
{% endblock %}
