{% extends 'admin/base.html.twig' %}

{% block admin_content %}
    <div class="p-4">
        <h1 class="text-success mb-4">Modifier l'événement</h1>

        <div class="card shadow-sm">
            <div class="card-body">
                {{ include('admin/event/_form.html.twig', {'button_label': 'Mettre à jour'}) }}

                <div class="mt-4">
                    <div class="d-flex gap-2">
                        <a href="{{ path('admin_events_index') }}" class="btn btn-secondary">
                            <i class="bi bi-arrow-left"></i> Retour à la liste
                        </a>
                        {{ include('admin/event/_delete_form.html.twig') }}
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
