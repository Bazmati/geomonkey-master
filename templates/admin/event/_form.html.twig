{{ form_start(form, {'attr': {'class': 'row g-3', 'enctype': 'multipart/form-data', 'id': 'event-form'}}) }}
    {# Left column: title, startDate, endDate, location, isPublished #}
    <div class="col-md-6">
        {{ form_row(form.title, {'attr': {'class': 'form-control'}}) }}
        {{ form_row(form.startDate, {'attr': {'class': 'form-control'}}) }}
        {{ form_row(form.endDate, {'attr': {'class': 'form-control'}}) }}
        {{ form_row(form.location, {'attr': {'class': 'form-control'}}) }}
        {{ form_row(form.isPublished, {'attr': {'class': 'form-check-input'}}) }}
    </div>

    {# Right column: description and image #}
    <div class="col-md-6">
        {{ form_row(form.description, {'attr': {'class': 'form-control', 'rows': 8, 'style': 'min-height: 200px'}}) }}
        
        {# Image upload section #}
        <div class="mb-3">
            <label class="form-label">Image</label>
            {{ form_row(form.galleryImages, {'attr': {'class': 'form-select'}}) }}
            {{ form_row(form.newImageFile, {'attr': {'class': 'form-control'}}) }}
            {{ form_row(form.newImageAlt, {'attr': {'class': 'form-control'}}) }}
            {{ form_row(form.newImageConsent, {'attr': {'class': 'form-check-input'}}) }}
            <div class="form-text">Formats : JPG, PNG, GIF, WebP (max 5Mo)</div>
            
            {# Image preview - show under input if exists #}
            {% for img in event.galleryImages %}
                {% if img.isPublished %}
                    {{ image_tag(img, 'small', img.alt, 'img-thumbnail m-1') }}
                {% else %}
                    <span class="badge bg-warning">« {{ img.title }} » en attente de publication</span>
                {% endif %}
            {% endfor %}
        </div>
    </div>
{{ form_end(form) }}
