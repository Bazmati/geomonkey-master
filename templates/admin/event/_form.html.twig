{{ form_start(form, {'attr': {'class': 'row g-3', 'enctype': 'multipart/form-data', 'id': 'event-form'}}) }}
    {# Left column: title, startDate, endDate, location, isPublished #}
    <div class="col-md-6">
        {# Title #}
        <div class="mb-3">
            {{ form_label(form.title) }}
            {{ form_widget(form.title, {'attr': {'class': 'form-control'}}) }}
            {{ form_errors(form.title) }}
        </div>

        {# Start Date #}
        <div class="mb-3">
            {{ form_label(form.startDate) }}
            {{ form_widget(form.startDate, {'attr': {'class': 'form-control'}}) }}
            {{ form_errors(form.startDate) }}
        </div>

        {# End Date #}
        <div class="mb-3">
            {{ form_label(form.endDate) }}
            {{ form_widget(form.endDate, {'attr': {'class': 'form-control'}}) }}
            {{ form_errors(form.endDate) }}
        </div>

        {# Location #}
        <div class="mb-3">
            {{ form_label(form.location) }}
            {{ form_widget(form.location, {'attr': {'class': 'form-control'}}) }}
            {{ form_errors(form.location) }}
        </div>

        {# Is Published #}
        <div class="mb-3 form-check">
            {{ form_widget(form.isPublished, {'attr': {'class': 'form-check-input'}}) }}
            {{ form_label(form.isPublished, null, {'label_attr': {'class': 'form-check-label'}}) }}
            {{ form_errors(form.isPublished) }}
        </div>
    </div>

    {# Right column: description and image #}
    <div class="col-md-6">
        {# Description - give it more space #}
        <div class="mb-4">
            {{ form_label(form.description) }}
            {{ form_widget(form.description, {'attr': {'class': 'form-control', 'rows': 8, 'style': 'min-height: 200px'}}) }}
            {{ form_errors(form.description) }}
        </div>

        {# Image upload section #}
        <div class="mb-3">
            {{ form_label(form.imageFile) }}
            {{ form_widget(form.imageFile, {'attr': {'class': 'form-control'}}) }}
            <div class="form-text">Formats : JPG, PNG, GIF, WebP (max 5Mo)</div>
            {% if form.imageFile.vars.errors|length > 0 %}
                <div class="text-danger">
                    {{ form_errors(form.imageFile) }}
                </div>
            {% endif %}
            
            {# Image preview - show under input if exists #}
            {% if event.hasImage() %}
                <div class="mt-2">
                    <label class="form-label">Image actuelle</label>
                    <div class="border rounded p-2 image-preview-container" style="height: 200px; background-color: #2d2d2d;">
                        {{ image_tag(event, 'medium', event.title, 'w-100 h-100 rounded') }}
                    </div>
                    <div class="mt-2 form-check">
                        {{ form_widget(form.deleteImage, {'attr': {'class': 'form-check-input'}}) }}
                        {{ form_label(form.deleteImage, null, {'label_attr': {'class': 'form-check-label'}}) }}
                    </div>
                </div>
            {% endif %}
        </div>
    </div>
{{ form_end(form) }}
