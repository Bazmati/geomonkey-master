{# templates/admin/message/compose.html.twig — écrire / répondre #}
{% extends 'admin/base.html.twig' %}

{% block title %}{{ subject ? subject : 'Nouveau message' }} - Messages - GéoMonkey{% endblock %}

{% block admin_content %}
    {% set page_title = 'Nouveau message' %}

    <div class="p-4">

        <div class="d-flex justify-content-between align-items-start gap-3 mb-4 flex-wrap">
            <h1 class="text-gm-green mb-0">
                <i class="bi bi-pencil-square"></i>
                {{ subject starts with 'Re:' ? 'Répondre' : 'Nouveau message' }}
            </h1>
            <a href="{{ path('app_admin_message_index') }}" class="btn btn-gm-surface">
                <i class="bi bi-arrow-left me-1"></i> Retour à la boîte
            </a>
        </div>

        {% if error %}
            <div class="alert alert-danger">
                <i class="bi bi-exclamation-triangle me-2"></i> {{ error }}
            </div>
        {% endif %}

        <div class="card shadow-sm">
            <div class="card-header bg-gm-surface d-flex justify-content-between align-items-center">
                <span><i class="bi bi-envelope me-2"></i> De : <strong>{{ fromAddress }}</strong></span>
                <span class="small text-gm-muted">Une copie sera archivée dans « Envoyés »</span>
            </div>
            <div class="card-body">
                <form method="post" action="{{ path('app_admin_message_compose') }}">
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('mailbox_send') }}">

                    <div class="mb-3">
                        <label for="to" class="form-label">À <span class="text-gm-muted small">(sépare plusieurs adresses par des virgules)</span></label>
                        <input type="text" class="form-control" id="to" name="to" value="{{ to }}"
                               placeholder="prenom.nom@exemple.fr" required>
                    </div>

                    <div class="mb-3">
                        <label for="subject" class="form-label">Objet</label>
                        <input type="text" class="form-control" id="subject" name="subject" value="{{ subject }}"
                               placeholder="Objet du message" required>
                    </div>

                    <div class="mb-3">
                        <label for="body" class="form-label">Message</label>
                        <textarea class="form-control" id="body" name="body" rows="12"
                                  placeholder="Écris ton message…" required>{{ body }}</textarea>
                        <div class="form-text">Texte simple (pas de HTML) : la signature de l'asso est ajoutée automatiquement.</div>
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <a href="{{ path('app_admin_message_index') }}" class="btn btn-gm-surface">Annuler</a>
                        <button type="submit" class="btn btn-gm-green">
                            <i class="bi bi-send me-1"></i> Envoyer
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
{% endblock %}
