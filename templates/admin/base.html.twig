{% extends 'front/base.html.twig' %}

{% block body %}
<div class="admin-shell">
    <button class="btn btn-outline-warning d-lg-none mb-3" onclick="document.querySelector('.admin-shell').classList.toggle('sidebar-open')">
        <i class="bi bi-list"></i>
    </button>
    {# Sidebar : fixe, ne bouge jamais #}
    <aside class="admin-sidebar">
        {% include 'admin/partials/_sidebar.html.twig' %}
    </aside>

    {# Zone principale : scrolle SEULE, footer toujours visible en bas #}
    <div class="admin-main">
        <div class="admin-content">
            {% block admin_content %}{% endblock %}
        </div>
        {% include 'admin/partials/_footer.html.twig' %}
    </div>
</div>
{% endblock %}


