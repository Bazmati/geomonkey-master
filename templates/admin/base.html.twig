<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Admin - GéoMonkey{% endblock %}</title>
    
    {# Bootstrap Icons #}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.min.css">
    
    {# Favicon #}
    <link rel="icon" href="{{ asset('favicon.ico') }}">
    
    {% block stylesheets %}{% endblock %}
</head>
<body class="admin-body">
    {# Messages flash #}
    <div class="container mt-3">
        {% for type, messages in app.flashes %}
            {% for message in messages %}
                <div class="alert alert-{{ type }} alert-dismissible fade show" role="alert">
                    {{ message }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            {% endfor %}
        {% endfor %}
    </div>

    <div class="admin-shell">
        {# Sidebar : fixe, ne bouge jamais #}
        <aside class="admin-sidebar">
            {% include 'admin/partials/_sidebar.html.twig' %}
        </aside>

        {# Zone principale #}
        <div class="admin-main">
            {# Topbar sticky : titre + breadcrumb + bouton retour #}
            {% include 'admin/partials/_topbar.html.twig' %}
            
            {# Contenu principal : scrolle #}
            <div class="admin-content">
                {% block admin_content %}{% endblock %}
            </div>
            
            {# Footer #}
            {% include 'admin/partials/_footer.html.twig' %}
        </div>
    </div>

    {% block javascripts %}
        {% block importmap %}{{ importmap('app') }}{% endblock %}
    {% endblock %}
</body>
</html>


