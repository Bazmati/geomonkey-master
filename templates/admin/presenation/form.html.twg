{% extends 'admin/base.html.twig' %}

{% block admin_content %}
    <div class="p-4">
        <h1 class="text-success mb-4"><i class="bi bi-file-text"></i> {{ title }}</h1>

        <div class="card shadow-sm">
            <div class="card-body">
                {{ form_start(form, {'attr': {'class': 'row g-3', 'enctype': 'multipart/form-data'}}) }}

                <div class="col-md-6">
                    {{ form_row(form.title, {'attr': {'class': 'form-control'}}) }}
                    {{ form_row(form.position, {'attr': {'class': 'form-control'}}) }}
                    <div class="form-check form-switch mb-3">
                        {{ form_widget(form.isActive, {'attr': {'class': 'form-check-input'}}) }}
                        {{ form_label(form.isActive, null, {'label_attr': {'class': 'form-check-label ms-2'}}) }}
                        {{ form_errors(form.isActive) }}
                    </div>
                </div>

                <div class="col-md-6">
                    {{ form_row(form.content, {'attr': {'class': 'form-control', 'rows': 10}}) }}
                </div>

                {# Image : sélection galerie OU upload #}
                <div class="col-12">
                    <div class="card bg-light p-4 mb-4">
                        <h5 class="card-title text-primary mb-3">
                            <i class="bi bi-image"></i> Image de la page
                        </h5>

                        <div class="mb-3">
                            {{ form_row(form.galleryImage, {'attr': {'class': 'form-select'}}) }}
                        </div>

                        <hr>

                        {{ form_row(form.newImageFile, {'attr': {'class': 'form-control'}}) }}
                        {{ form_row(form.newImageAlt, {'attr': {'class': 'form-control'}}) }}

                        <div class="form-check mb-3">
                            {{ form_widget(form.newImageConsent, {'attr': {'class': 'form-check-input'}}) }}
                            {{ form_label(form.newImageConsent, null, {'label_attr': {'class': 'form-check-label ms-2'}}) }}
                            {{ form_errors(form.newImageConsent) }}
                        </div>

                        <div class="form-text">
                            L'image téléversée sera créée dans la galerie avec la visibilité « Publique »,
                            mais restera <strong>non publiée</strong> jusqu'à validation par un président
                            (Gestion de la galerie). Le consentement est obligatoire : cochez seulement
                            si les personnes identifiables ont donné leur accord.
                        </div>

                        {% if page.galleryImage %}
                            <div class="mt-3">
                                <span class="badge bg-{{ page.galleryImage.isPublished ? 'success' : 'secondary' }}">
                                    Image actuelle : {{ page.galleryImage.title }}
                                    {{ page.galleryImage.isPublished ? '(publiée)' : '(en attente de publication)' }}
                                </span>
                            </div>
                        {% endif %}
                    </div>
                </div>

                <div class="col-12">
                    <div class="d-flex justify-content-end gap-2">
                        <a href="{{ path('app_admin_presentation_index') }}" class="btn btn-secondary">
                            <i class="bi bi-arrow-left"></i> Annuler
                        </a>
                        <button type="submit" class="btn btn-success">
                            <i class="bi bi-check-lg"></i> {{ title == 'Nouvelle page' ? 'Créer' : 'Enregistrer' }}
                        </button>
                    </div>
                </div>

                {{ form_end(form) }}
            </div>
        </div>
    </div>
{% endblock %}