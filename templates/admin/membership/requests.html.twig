{# templates/admin/membership/requests.html.twig #}
{% extends 'admin/base.html.twig' %}

{% block title %}Demandes d'adhésion en attente - GéoMonkey{% endblock %}

{% block admin_content %}
    <div class="p-4">
        <h1 class="mb-4">
            <i class="bi bi-people me-2"></i>Demandes d'adhésion en attente
        </h1>

        {% if pendingUsers|length > 0 %}
            <div class="card shadow-sm">
                <div class="card-header bg-light d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">
                        <i class="bi bi-clock-history me-2"></i>
                        {{ pendingUsers|length }} demande(s) en attente de validation
                    </h5>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Nom</th>
                                    <th>Email</th>
                                    <th>Date d'inscription</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for user in pendingUsers %}
                                    <tr>
                                        <td>
                                            <strong>{{ user.firstName }} {{ user.lastName }}</strong>
                                        </td>
                                        <td>{{ user.email }}</td>
                                        <td>{{ user.createdAt|date('d/m/Y H:i') }}</td>
                                        <td>
                                            <form method="post" 
                                                  action="{{ path('app_admin_membership_validate', {'id': user.id}) }}"
                                                  class="d-inline">
                                                <input type="hidden" name="_token" value="{{ csrf_token('validate' ~ user.id) }}">
                                                <button type="submit" class="btn btn-sm btn-success" 
                                                        title="Valider la demande">
                                                    <i class="bi bi-check-lg me-1"></i> Valider
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        {% else %}
            <div class="alert alert-info">
                <i class="bi bi-check-circle me-2"></i>
                Aucune demande d'adhésion en attente de validation.
            </div>
        {% endif %}
    </div>
{% endblock %}
