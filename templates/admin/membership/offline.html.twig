{# templates/admin/membership/offline.html.twig #}
{% extends 'admin/base.html.twig' %}

{% block title %}Encaisser une cotisation hors-ligne - GéoMonkey{% endblock %}

{% block admin_content %}
    <div class="p-4">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
            <h1 class="text-gm-green mb-0"><i class="bi bi-cash-coin"></i> Encaisser une cotisation hors-ligne</h1>
            <a href="{{ path('app_admin_membership_list') }}" class="btn btn-gm-surface btn-sm">
                <i class="bi bi-arrow-left me-1"></i> Toutes les adhésions
            </a>
        </div>

        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="card shadow-sm">
                    <div class="card-body p-4">
                        <p class="text-gm-muted small mb-4">
                            <i class="bi bi-info-circle me-1"></i>
                            Pour un paiement en main propre (espèces, chèque, virement) :
                            l'adhésion est valable 1 an à partir d'aujourd'hui, l'ancienne adhésion
                            est désactivée, le membre reçoit le mail de confirmation et passe
                            membre actif s'il était simple visiteur.
                        </p>

                        <form method="post">
                            <input type="hidden" name="_token" value="{{ csrf_token('offline_payment') }}">

                            <div class="mb-3">
                                <label for="user_id" class="form-label">Membre <span class="text-danger">*</span></label>
                                <select class="form-select" id="user_id" name="user_id" required>
                                    <option value="" disabled selected>Choisir un membre…</option>
                                    {% for u in users %}
                                        <option value="{{ u.id }}">
                                            {{ u.lastName }} {{ u.firstName }} — {{ u.email }}
                                        </option>
                                    {% endfor %}
                                </select>
                            </div>

                            <div class="row g-3 mb-3">
                                <div class="col-sm-6">
                                    <label for="amount" class="form-label">Montant encaissé (€) <span class="text-danger">*</span></label>
                                    <input type="number" class="form-control" id="amount" name="amount"
                                           value="{{ default_amount|number_format(2, '.', '') }}"
                                           min="0.01" step="0.01" required>
                                    <div class="form-text">Saisir le montant réellement encaissé.</div>
                                </div>
                                <div class="col-sm-6">
                                    <label for="method" class="form-label">Moyen de paiement <span class="text-danger">*</span></label>
                                    <select class="form-select" id="method" name="method" required>
                                        <option value="especes" selected>Espèces</option>
                                        <option value="cheque">Chèque</option>
                                        <option value="virement">Virement</option>
                                    </select>
                                </div>
                            </div>

                            <div class="d-flex flex-wrap gap-2">
                                <button type="submit" class="btn btn-gm-green fw-semibold">
                                    <i class="bi bi-cash-stack me-1"></i> Encaisser
                                </button>
                                <a href="{{ path('app_admin_membership_list') }}" class="btn btn-gm-surface">Annuler</a>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
