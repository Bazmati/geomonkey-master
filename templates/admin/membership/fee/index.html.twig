{# templates/admin/membership/fee/index.html.twig #}
{% extends 'admin/base.html.twig' %}

{% block title %}Tarif d'adhésion - GéoMonkey{% endblock %}

{% block admin_content %}
    <div class="p-4">
        <h1 class="mb-4">
            <i class="bi bi-currency-euro me-2"></i>Tarif d'adhésion
        </h1>

        {% if currentFee %}
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">
                        <i class="bi bi-check-circle me-2"></i>Tarif actuel
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <h4>
                                <span class="badge bg-warning text-dark fs-5">
                                    {{ "%.2f"|format(currentFee.amount / 100) }} €
                                </span>
                            </h4>
                            <p class="text-muted">
                                <i class="bi bi-calendar me-1"></i>
                                Mis à jour le {{ currentFee.updatedAt|date('d/m/Y à H:i') }}
                            </p>
                            {% if currentFee.effectiveFrom %}
                                <p class="text-muted">
                                    <i class="bi bi-play-circle me-1"></i>
                                    En vigueur depuis le {{ currentFee.effectiveFrom|date('d/m/Y') }}
                                </p>
                            {% endif %}
                            {% if currentFee.notes %}
                                <p class="mb-0">
                                    <strong>Notes:</strong> {{ currentFee.notes }}
                                </p>
                            {% endif %}
                        </div>
                        <div class="col-md-6 text-end">
                            <a href="{{ path('app_admin_membership_fee_edit') }}" 
                               class="btn btn-warning">
                                <i class="bi bi-pencil me-1"></i> Modifier le tarif
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        {% else %}
            <div class="alert alert-warning mb-4">
                <i class="bi bi-exclamation-triangle me-2"></i>
                Aucun tarif d'adhésion n'a encore été défini.
                <a href="{{ path('app_admin_membership_fee_edit') }}" class="alert-link">
                    Définir le tarif maintenant
                </a>
            </div>
        {% endif %}

        {% if history|length > 1 %}
            <div class="card shadow-sm">
                <div class="card-header bg-light">
                    <h5 class="mb-0">
                        <i class="bi bi-clock-history me-2"></i>Historique des tarifs
                    </h5>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-striped mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Montant</th>
                                    <th>Date de mise à jour</th>
                                    <th>Date d'effet</th>
                                    <th>Notes</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for fee in history %}
                                    <tr class="{% if fee == currentFee %}table-active{% endif %}">
                                        <td>
                                            <strong>{{ "%.2f"|format(fee.amount / 100) }} €</strong>
                                        </td>
                                        <td>{{ fee.updatedAt|date('d/m/Y H:i') }}</td>
                                        <td>{{ fee.effectiveFrom ? fee.effectiveFrom|date('d/m/Y') : '-' }}</td>
                                        <td>{{ fee.notes ?: '-' }}</td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        {% endif %}
    </div>
{% endblock %}
