{% extends 'admin/base.html.twig' %}

{% block admin_content %}
    <div class="p-4">

        {{ breadcrumb() }}
        
        <h1 class="text-success mb-4"><i class="bi bi-newspaper"></i> Articles de blog</h1>

        <div class="d-flex justify-content-end mb-3">
            {% if is_granted('ENTITY_CREATE') %}
                <a href="{{ path('app_admin_blog_new') }}" class="btn btn-success">
                    <i class="bi bi-plus-circle"></i> Nouvel article
                </a>
            {% endif %}
        </div>

        <div class="card shadow-sm">
            <div class="card-body">
                {% if posts is empty %}
                    <div class="text-center py-4" style="color: #c0c0c0;">
                        <i class="bi bi-newspaper fs-1"></i>
                        <p class="mt-2 text-light">Aucun article</p>
                        {% if is_granted('ENTITY_CREATE') %}
                            <a href="{{ path('app_admin_blog_new') }}" class="btn btn-primary">
                                <i class="bi bi-plus-circle"></i> Créer le premier article
                            </a>
                        {% endif %}
                    </div>
                {% else %}
                    <div class="table-responsive">
                        <table class="table table-striped table-hover table-light">
                            <thead class="table-dark text-light">
                                <tr>
                                    <th>Titre</th>
                                    <th>Slug</th>
                                    <th>Auteur</th>
                                    <th>Statut</th>
                                    <th>Créé le</th>
                                    <th>Mise en ligne</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for post in posts %}
                                    <tr>
                                        <td><strong>{{ post.title }}</strong></td>
                                        <td><code>{{ post.slug }}</code></td>
                                        <td>{{ post.author ? (post.author.firstName ~ ' ' ~ post.author.lastName) : '—' }}</td>
                                        <td>
                                            <span class="badge bg-{{ post.isPublished ? 'success' : 'secondary' }}">
                                                {{ post.isPublished ? 'En ligne' : 'Brouillon' }}
                                            </span>
                                        </td>
                                        <td>{{ post.createdAt|date('d/m/Y H:i') }}</td>
                                        <td>{{ post.publishedAt ? post.publishedAt|date('d/m/Y H:i') : '—' }}</td>
                                        <td>
                                            <div class="d-flex gap-1">
                                                {% if post.isPublished %}
                                                    <a href="{{ path('app_blog_show', {'slug': post.slug}) }}"
                                                       class="btn btn-sm btn-light" title="Voir sur le site" target="_blank">
                                                        <i class="bi bi-eye-fill"></i>
                                                    </a>
                                                {% endif %}
                                                {% if is_granted('ENTITY_EDIT') %}
                                                    <a href="{{ path('app_admin_blog_edit', {'id': post.id}) }}"
                                                       class="btn btn-sm btn-warning" title="Modifier">
                                                        <i class="bi bi-pencil-fill"></i>
                                                    </a>
                                                {% endif %}
                                                {# Publication : président uniquement (sécurité côté serveur,
                                                   le is_granted ici ne fait que masquer le bouton) #}
                                                {% if is_granted('ENTITY_PUBLISH') %}
                                                    <form method="post"
                                                          action="{{ path('app_admin_blog_toggle_publish', {'id': post.id}) }}"
                                                          class="d-inline">
                                                        <input type="hidden" name="_token"
                                                               value="{{ csrf_token('publish' ~ post.id) }}">
                                                        <button class="btn btn-sm btn-{{ post.isPublished ? 'outline-secondary' : 'outline-success' }}"
                                                                type="submit"
                                                                title="{{ post.isPublished ? 'Retirer de la ligne' : 'Mettre en ligne' }}"
                                                                {% if not post.isPublished %}data-bs-toggle="tooltip" data-bs-title="Visibilité publique immédiate"{% endif %}>
                                                            <i class="bi bi-{{ post.isPublished ? 'eye-slash' : 'rocket-takeoff' }}-fill"></i>
                                                        </button>
                                                    </form>
                                                {% endif %}
                                                {% if is_granted('ENTITY_DELETE') %}
                                                    {{ include('admin/blog/_delete_form.html.twig', {'post': post}) }}
                                                {% endif %}
                                            </div>
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
{% endblock %}