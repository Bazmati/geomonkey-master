{% extends 'admin/base.html.twig' %}

{% block admin_content %}
    <div class="p-4">
        <h1 class="text-success mb-4"><i class="bi bi-images"></i> Gestion de la galerie</h1>

        <div class="d-flex justify-content-end mb-3">
            <a href="{{ path('app_admin_gallery_image_new') }}" class="btn btn-success">
                <i class="bi bi-plus-circle"></i> Nouvelle image
            </a>
        </div>

        <div class="card shadow-sm">
            <div class="card-body">
                {% if gallery_images is empty %}
                    <div class="text-center py-4" style="color: #c0c0c0;">
                        <i class="bi bi-image fs-1"></i>
                        <p class="mt-2 text-light">Aucune image dans la galerie</p>
                        <a href="{{ path('app_admin_gallery_image_new') }}" class="btn btn-primary">
                            <i class="bi bi-upload"></i> Ajouter votre première image
                        </a>
                    </div>
                {% else %}
                    <div class="table-responsive">
                        <table class="table table-striped table-hover table-light">
                            <thead class="table-dark text-light">
                                <tr>
                                    <th>ID</th>
                                    <th>Titre</th>
                                    <th>Visibilité</th>
                                    <th>Consentement RGPD</th>
                                    <th>Publiée</th>
                                    <th>Téléchargée par</th>
                                    <th>Date</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for image in gallery_images %}
                                    <tr class="text-light">
                                        <td>{{ image.id }}</td>
                                        <td>
                                            <strong>{{ image.title }}</strong>
                                            {% if image.description %}
                                                <br><small class="text-muted">{{ image.description|truncate(50) }}</small>
                                            {% endif %}
                                        </td>
                                        <td>
                                            {% set visibilityValue = image.visibility.value %}
                                            <span class="badge bg-{{
                                                visibilityValue == 'public' ? 'primary' :
                                                visibilityValue == 'membres' ? 'info' :
                                                visibilityValue == 'participants' ? 'warning' :
                                                'secondary'
                                            }}">
                                                {{ {'public': 'Publique', 'membres': 'Membres', 'participants': 'Participants', 'bureau': 'Bureau'}[visibilityValue] }}
                                            </span>
                                        </td>
                                        <td>
                                            {% if image.hasValidConsent() %}
                                                <i class="bi bi-check-circle-fill text-success" title="Consentement valide et daté"></i>
                                            {% elseif image.rgpdConsent %}
                                                <i class="bi bi-exclamation-circle-fill text-warning" title="Consentement coché mais non daté"></i>
                                            {% else %}
                                                <i class="bi bi-x-circle-fill text-danger" title="Pas de consentement"></i>
                                            {% endif %}
                                        </td>
                                        <td>
                                            <span class="badge bg-{{ image.isPublished ? 'success' : 'secondary' }}">
                                                {{ image.isPublished ? 'Oui' : 'Non' }}
                                            </span>
                                        </td>
                                        <td>
                                            {% if image.uploadedBy %}
                                                {{ image.uploadedBy.email }}
                                            {% else %}
                                                <span class="text-muted">Inconnu</span>
                                            {% endif %}
                                        </td>
                                        <td>{{ image.createdAt|date('d/m/Y H:i') }}</td>
                                        <td>
                                            <div class="d-flex gap-1">
                                                {# Lien vers l'image (si publiée) #}
                                                {% if image.isPublished %}
                                                    <a href="{{ path('app_gallery_index') }}" class="btn btn-sm btn-light" title="Voir">
                                                        <i class="bi bi-eye-fill"></i>
                                                    </a>
                                                {% endif %}
                                                {# Éditer #}
                                                {% if is_granted('GALLERY_IMAGE_EDIT', image) %}
                                                    <a href="{{ path('app_admin_gallery_image_edit', {'id': image.id}) }}" class="btn btn-sm btn-warning" title="Modifier">
                                                        <i class="bi bi-pencil-fill"></i>
                                                    </a>
                                                {% endif %}
                                                {# Publier/Dépublier #}
                                                {% if is_granted('GALLERY_IMAGE_PUBLISH', image) %}
                                                    <form method="post" action="{{ path('app_admin_gallery_image_publish', {'id': image.id}) }}" class="d-inline">
                                                        <input type="hidden" name="_token" value="{{ csrf_token('publish' ~ image.id) }}">
                                                        <button class="btn btn-sm btn-{{ image.isPublished ? 'outline-secondary' : 'outline-primary' }}" type="submit" title="{{ image.isPublished ? 'Dépublier' : 'Publier' }}">
                                                            <i class="bi bi-{{ image.isPublished ? 'eye-slash' : 'eye' }}-fill"></i>
                                                        </button>
                                                    </form>
                                                {% endif %}
                                                {# Retirer consentement #}
                                                {% if is_granted('GALLERY_IMAGE_EDIT', image) %}
                                                    <form method="post" action="{{ path('app_admin_gallery_image_withdraw_consent', {'id': image.id}) }}" class="d-inline" onsubmit="return confirm('Êtes-vous sûr de vouloir retirer le consentement RGPD ? L\\'image sera rétrogradée.');">
                                                        <input type="hidden" name="_token" value="{{ csrf_token('withdraw_consent' ~ image.id) }}">
                                                        <button class="btn btn-sm btn-outline-danger" type="submit" title="Retirer consentement">
                                                            <i class="bi bi-shield-slash-fill"></i>
                                                        </button>
                                                    </form>
                                                {% endif %}
                                                {# Supprimer #}
                                                {% if is_granted('GALLERY_IMAGE_DELETE', image) %}
                                                    {{ include('admin/gallery_image/_delete_form.html.twig', {'id': image.id}) }}
                                                {% endif %}
                                            </div>
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
{% endblock %}
