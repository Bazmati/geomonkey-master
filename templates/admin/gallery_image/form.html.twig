{% extends 'admin/base.html.twig' %}

{% block admin_content %}
    <div class="p-4">
        <h1 class="text-success mb-4"><i class="bi bi-images"></i> {{ title }}</h1>

        <div class="card shadow-sm">
            <div class="card-body">
                {{ form_start(form, {'attr': {'class': 'row g-3', 'enctype': 'multipart/form-data'}}) }}
                
                {# Left column: Basic info #}
                <div class="col-md-6">
                    {{ form_row(form.title, {'attr': {'class': 'form-control'}}) }}
                    {{ form_row(form.alt, {'attr': {'class': 'form-control'}}) }}
                    {{ form_row(form.description, {'attr': {'class': 'form-control', 'rows': 4}}) }}
                </div>

                {# Right column: Metadata and settings #}
                <div class="col-md-6">
                    {# Visibility with dynamic choices based on consent #}
                    <div class="mb-3">
                        <label class="form-label">Visibilité</label>
                        {{ form_widget(form.visibility, {'attr': {'class': 'form-select'}}) }}
                        <div class="form-text">
                            {% if not gallery_image.hasRgpdConsent() %}
                                <div class="alert alert-warning mt-2 p-2">
                                    <i class="bi bi-exclamation-triangle-fill"></i> 
                                    Pour choisir "Publique", vous devez d'abord cocher le consentement RGPD.
                                </div>
                            {% endif %}
                        </div>
                        {{ form_errors(form.visibility) }}
                    </div>

                    {# RGPD Consent Section #}
                    <div class="card bg-light p-3 mb-3">
                        <h5 class="card-title text-primary mb-3">
                            <i class="bi bi-shield-check"></i> Consentement RGPD
                        </h5>
                        {{ form_row(form.rgpdConsent, {'attr': {'class': 'form-check-input'}}) }}
                        {{ form_row(form.consentDetail, {'attr': {'class': 'form-control', 'rows': 2}}) }}
                        
                        <div class="form-text">
                            <strong>Obligatoire pour les images publiques.</strong> 
                            Conservez une trace de qui a consenti, quand et dans quel contexte.
                            {% if gallery_image.consentedAt %}
                                <br><small>Dernière date: {{ gallery_image.consentedAt|date('d/m/Y H:i') }}</small>
                            {% endif %}
                        </div>
                    </div>

                    {# Publish toggle #}
                    <div class="mb-3 form-check form-switch">
                        {{ form_widget(form.isPublished, {'attr': {'class': 'form-check-input'}}) }}
                        <label class="form-check-label" for="{{ form.isPublished.vars.id }}">
                            Publier l'image
                        </label>
                        <div class="form-text">
                            Seules les images publiées seront visibles dans la galerie publique.
                            {% if gallery_image.visibility.value == 'public' and not gallery_image.hasValidConsent() %}
                                <br><span class="text-danger">⚠️ Impossible de publier : consentement RGPD manquant pour une image publique.</span>
                            {% endif %}
                        </div>
                    </div>
                </div>

                {# Image upload section - Full width #}
                <div class="col-12">
                    <div class="card bg-light p-4 mb-4">
                        <h5 class="card-title text-primary mb-3">
                            <i class="bi bi-image"></i> Image
                        </h5>
                        {{ form_row(form.imageFile, {'attr': {'class': 'form-control'}}) }}
                        
                        <div class="form-text">
                            Formats autorisés: JPG, PNG, GIF, WebP (max 5Mo). 
                            Les métadonnées EXIF (GPS, etc.) seront automatiquement supprimées pour la conformité RGPD.
                        </div>

                        {# Image preview #}
                        {% if gallery_image.hasImage() %}
                            <div class="mt-3">
                                <label class="form-label">Image actuelle</label>
                                <div class="border rounded p-3 bg-white" style="max-height: 400px; overflow: hidden;">
                                    {% include 'admin/gallery_image/_picture.html.twig' with {
                                        image: gallery_image,
                                        size: 'medium',
                                        alt: gallery_image.alt
                                    } %}
                                </div>
                            </div>
                        {% endif %}
                    </div>
                </div>

                {# Submit button #}
                <div class="col-12">
                    <div class="d-flex justify-content-end gap-2">
                        <a href="{{ path('app_admin_gallery_image_index') }}" class="btn btn-secondary">
                            <i class="bi bi-arrow-left"></i> Annuler
                        </a>
                        <button type="submit" class="btn btn-success">
                            <i class="bi bi-check-lg"></i> {{ title == 'Nouvelle image' ? 'Créer' : 'Enregistrer' }}
                        </button>
                    </div>
                </div>
                
                {{ form_end(form) }}
            </div>
        </div>
    </div>
{% endblock %}
