{% extends 'front/base.html.twig' %}

{% block title %}Erreur — {{ parent() }}{% endblock %}

{% block body %}
    <div class="container py-5 text-center" style="min-height: 50vh;">
        <div class="row justify-content-center">
            <div class="col-md-6">
                <img src="{{ asset('images/Logo_geomonkey.png') }}" alt="Logo GéoMonkey"
                     class="mx-auto d-block mb-3 rounded-circle" width="64" height="64">
                <div class="fs-5 fw-bold mb-3">
                    Géo<span class="text-gm-yellow">Monkey</span>
                </div>
                <h1 class="display-1 fw-bold text-gm-danger">500</h1>
                <h2 class="h4 mb-3">Une erreur inattendue est survenue 🙊</h2>
                <p class="text-gm-muted mb-4">
                    Notre équipe a été notifiée. Réessaie dans quelques instants.
                </p>
                <div class="d-flex justify-content-center gap-2 flex-wrap">
                    <a href="{{ path('app_home') }}" class="btn btn-gm-green">
                        <i class="bi bi-house-fill me-1"></i> Retour à l'accueil
                    </a>
                    {% if app.user and is_granted('ROLE_ADMIN') %}
                        <a href="{{ path('app_admin_dashboard') }}" class="btn btn-outline-gm-gray">
                            <i class="bi bi-speedometer2 me-1"></i> Retour au backoffice
                        </a>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
{% endblock %}
