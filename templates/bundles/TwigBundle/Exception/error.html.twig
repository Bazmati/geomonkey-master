{% extends 'front/base.html.twig' %}

{% block title %}Erreur — {{ parent() }}{% endblock %}

{% block body %}
    <div class="container py-5 text-center" style="min-height: 50vh;">
        <div class="row justify-content-center">
            <div class="col-md-6">
                <h1 class="display-1 fw-bold text-gm-warning">Oups</h1>
                <h2 class="h4 mb-3">Une erreur est survenue 🙈</h2>
                <p class="text-gm-muted mb-4">
                    Quelque chose s'est mal passé. Réessaie dans quelques instants.
                </p>
                <a href="{{ path('app_home') }}" class="btn btn-gm-green">
                    <i class="bi bi-house-fill me-1"></i> Retour à l'accueil
                </a>
            </div>
        </div>
    </div>
{% endblock %}
