{% extends 'front/base.html.twig' %}

{% block title %}Page introuvable — {{ parent() }}{% endblock %}

{% block body %}
    <div class="container py-5 text-center" style="min-height: 50vh;">
        <div class="row justify-content-center">
            <div class="col-md-6">
                <h1 class="display-1 fw-bold text-gm-green">404</h1>
                <h2 class="h4 mb-3">Oups, cette page est partie se cacher 🙈</h2>
                <p class="text-gm-muted mb-4">
                    La page que tu cherches n'existe pas ou a été déplacée.
                </p>
                <div class="d-flex justify-content-center gap-2">
                    <a href="{{ path('app_home') }}" class="btn btn-gm-green">
                        <i class="bi bi-house-fill me-1"></i> Retour à l'accueil
                    </a>
                    <a href="{{ path('app_event_index') }}" class="btn btn-outline-gm-gray">
                        Voir les événements
                    </a>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
