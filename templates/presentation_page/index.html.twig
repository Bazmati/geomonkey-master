<!DOCTYPE html>

<title>PresentationPage index</title>

{% block body %}
    <h1>PresentationPage index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Title</th>
                <th>Slug</th>
                <th>Content</th>
                <th>Position</th>
                <th>IsActive</th>
                <th>UpdatedAt</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for presentation_page in presentation_pages %}
            <tr>
                <td>{{ presentation_page.id }}</td>
                <td>{{ presentation_page.title }}</td>
                <td>{{ presentation_page.slug }}</td>
                <td>{{ presentation_page.content }}</td>
                <td>{{ presentation_page.position }}</td>
                <td>{{ presentation_page.isActive ? 'Yes' : 'No' }}</td>
                <td>{{ presentation_page.updatedAt ? presentation_page.updatedAt|date('Y-m-d H:i:s') : '' }}</td>
                <td>
                    <a href="{{ path('app_presentation_page_show', {'id': presentation_page.id}) }}">show</a>
                    <a href="{{ path('app_presentation_page_edit', {'id': presentation_page.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="8">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_presentation_page_new') }}">Create new</a>
{% endblock %}
