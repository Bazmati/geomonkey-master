{# Messages flash : juste sous la navbar, sur toutes les pages #}
{% include 'partials/_flash.html.twig' %}

<script>
    // Ombre + opacité renforcée dès qu'on quitte le haut de page
    (function () {
        var nav = document.getElementById('gm-nav');
        if (!nav) { return; }
        function onScroll() {
            nav.classList.toggle('gm-nav-scrolled', window.scrollY > 10);
        }
        window.addEventListener('scroll', onScroll, { passive: true });
        onScroll();
    })();
</script>
