<nav class="navbar navbar-expand-lg navbar-dark sticky-top gm-nav" id="gm-nav" data-controller="navbar-scroll">
    <div class="container">

        {# ===== Marque : logo sans fond sur pastille anthracite ===== #}
        <a class="navbar-brand d-flex align-items-center gap-2 pe-2" href="{{ path('app_home') }}" aria-label="{{ 'nav.brand_aria'|trans }}">
            <span class="gm-nav-logo">
                <img src="{{ asset('images/Logo_geomonkey.png') }}" alt="Logo GéoMonkey"
                     onerror="this.onerror=null;this.src='{{ asset('images/logo.png') }}';this.classList.add('rounded-circle')">
            </span>
            <span class="gm-nav-brand fw-bold">Géo<span class="text-gm-yellow">Monkey</span></span>
        </a>

        <button class="navbar-toggler border-gm-yellow" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar"
                aria-controls="mainNavbar" aria-expanded="false" aria-label="{{ 'nav.toggle'|trans }}">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="mainNavbar">
            <ul class="navbar-nav ms-auto mb-2 mb-lg-0 align-items-lg-center">

                <li class="nav-item">
                    <a class="nav-link gm-nav-link {{ app.request.attributes.get('_route') == 'app_home' ? 'active' : '' }}"
                       href="{{ path('app_home') }}">{{ 'nav.home'|trans }}</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link gm-nav-link {{ app.request.attributes.get('_route') starts with 'app_presentation' ? 'active' : '' }}"
                       href="{{ path('app_presentation_index') }}">{{ 'nav.presentation'|trans }}</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link gm-nav-link {{ app.request.attributes.get('_route') starts with 'app_project' ? 'active' : '' }}"
                       href="{{ path('app_project_index') }}">{{ 'nav.projects'|trans }}</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link gm-nav-link {{ app.request.attributes.get('_route') starts with 'app_blog' ? 'active' : '' }}"
                       href="{{ path('app_blog_index') }}">{{ 'nav.blog'|trans }}</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link gm-nav-link {{ app.request.attributes.get('_route') starts with 'app_event' ? 'active' : '' }}"
                       href="{{ path('app_event_index') }}">{{ 'nav.events'|trans }}</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link gm-nav-link {{ app.request.attributes.get('_route') starts with 'app_gallery' ? 'active' : '' }}"
                       href="{{ path('app_gallery_index') }}">{{ 'nav.gallery'|trans }}</a>
                </li>

                {# ===== Actions ===== #}
                {% if not app.user %}
                    <li class="nav-item ms-lg-2">
                        <a class="btn btn-outline-gm-green btn-sm" href="{{ path('app_membership_register') }}">
                            <i class="bi bi-person-plus me-1"></i> {{ 'nav.join'|trans }}
                        </a>
                    </li>
                {% endif %}
                <li class="nav-item ms-lg-1">
                    <a class="btn btn-gm-yellow btn-sm" href="#newsletter">
                        <i class="bi bi-envelope-heart me-1"></i> {{ 'nav.newsletter'|trans }}
                    </a>
                </li>
                <li class="nav-item ms-lg-1">
                    <a class="btn btn-sm gm-nav-don" href="{{ path('app_donation') }}"
                       title="{{ 'nav.don_title'|trans }}">
                        <i class="bi bi-heart-fill me-1"></i> {{ 'nav.don'|trans }}
                    </a>
                </li>

                {# ===== Sélecteur de langue FR/EN ===== #}
                <li class="nav-item dropdown ms-lg-1">
                    <a class="nav-link dropdown-toggle d-flex align-items-center" href="#"
                       id="localeDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false"
                       aria-label="{{ 'nav.language'|trans }}" title="{{ 'nav.language'|trans }}">
                        <i class="bi bi-translate"></i>
                        <span class="text-uppercase fw-bold ms-1">{{ app.request.locale }}</span>
                    </a>
                    <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="localeDropdown">
                        <li>
                            <a class="dropdown-item {{ app.request.locale == 'fr' ? 'active' : '' }}"
                               href="{{ path('app_locale', { locale: 'fr' }) }}">
                                <i class="bi bi-check-lg {{ app.request.locale == 'fr' ? '' : 'invisible' }}"></i> {{ 'nav.language_fr'|trans }}
                            </a>
                        </li>
                        <li>
                            <a class="dropdown-item {{ app.request.locale == 'en' ? 'active' : '' }}"
                               href="{{ path('app_locale', { locale: 'en' }) }}">
                                <i class="bi bi-check-lg {{ app.request.locale == 'en' ? '' : 'invisible' }}"></i> {{ 'nav.language_en'|trans }}
                            </a>
                        </li>
                    </ul>
                </li>

                {# ===== Zone utilisateur ===== #}
                {% if app.user %}
                    <li class="nav-item dropdown ms-lg-2">
                        <a class="nav-link dropdown-toggle d-flex align-items-center gap-1" href="#"
                           id="userDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="bi bi-person-circle"></i>
                            {{ app.user.firstName ?? app.user.email }}
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userDropdown">
                            {% if is_granted('ROLE_ADMIN') %}
                                <li>
                                    <a class="dropdown-item" href="{{ path('app_admin_dashboard') }}">
                                        <i class="bi bi-speedometer2 me-2"></i>{{ 'nav.backoffice'|trans }}
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider"></li>
                            {% endif %}
                            <li>
                                <a class="dropdown-item" href="{{ path('app_profile') }}">
                                    <i class="bi bi-person-vcard me-2"></i>{{ 'nav.profile'|trans }}
                                </a>
                            </li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <a class="dropdown-item" href="{{ path('app_logout') }}">
                                    <i class="bi bi-box-arrow-right me-2"></i>{{ 'nav.logout'|trans }}
                                </a>
                            </li>
                        </ul>
                    </li>
                {% else %}
                    <li class="nav-item ms-lg-1">
                        <a class="btn btn-outline-gm-yellow btn-sm" href="{{ path('app_login') }}">
                            <i class="bi bi-box-arrow-in-right"></i> {{ 'nav.login'|trans }}
                        </a>
                    </li>
                {% endif %}
            </ul>
        </div>
    </div>
</nav>

{# Messages flash : juste sous la navbar, sur toutes les pages #}
