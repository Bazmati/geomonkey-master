{# templates/security/access_denied.html.twig #}
{% extends 'front/base.html.twig' %}

{% block title %}Accès réservé{% endblock %}

{% block body %}
    {% include 'partials/_navbar.html.twig' %}
    
    <div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h2 class="mb-0">
                        <i class="bi bi-exclamation-triangle-fill"></i> 
                        Accès réservé
                    </h2>
                </div>
                <div class="card-body">
                    <div class="text-center">
                        <p class="lead mb-4">
                            Votre compte n'a pas les droits nécessaires pour accéder à cette section.
                        </p>
                        
                        {% if app.user and app.user.officeFunction == constant('App\\Enum\\OfficeFunction::None') %}
                            <div class="alert alert-info">
                                <p class="mb-0">
                                    Vous êtes connecté en tant que visiteur inscrit. 
                                    Pour accéder aux fonctionnalités de gestion, 
                                    <strong>contactez le bureau de l'association</strong>.
                                </p>
                            </div>
                            <a href="{{ path('app_home') }}" class="btn btn-outline-primary">
                                <i class="bi bi-house"></i> Retour à l'accueil
                            </a>
                        {% else %}
                            <div class="alert alert-warning">
                                <p class="mb-0">
                                    Vous n'avez pas les permissions requises pour cette action.
                                </p>
                            </div>
                            <a href="{{ path('app_home') }}" class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-left"></i> Retour à l'accueil
                            </a>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}