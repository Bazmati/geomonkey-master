# ============================================================
# Fichier .env VERSIONNÉ : valeurs par défaut, NON secrètes.
# Les vraies valeurs de chaque machine (prod CT 202, dev local)
# vivent dans .env.local (gitignore), qui SURCHARGE ce fichier.
# Priorité : variables d'environnement réelles > .env.local > .env
# ATTENTION CT 202 : APP_SECRET et DATABASE_URL doivent être
# redéfinis dans le .env.local du serveur.
# ============================================================

APP_ENV=prod
APP_DEBUG=0
APP_SECRET=EZA3sp2JZbfCzhkicqJDszAlmbM0lrkCkNxCRV6COtw=

# Base de données : placeholder, la vraie URL est dans .env.local
DATABASE_URL="postgresql://app:!ChangeMe!@127.0.0.1:5432/app?serverVersion=15&charset=utf8"

# Messenger : sync par défaut, prod redéfinit dans .env.local
MESSENGER_TRANSPORT_DSN=sync://

# Mail : null par défaut, prod redéfinit (SMTP/GMX) dans .env.local
MAILER_DSN=null://default

# URI de base pour les URLs absolues (config/packages/framework.yaml)
DEFAULT_URI='https://geomonkey.fr'

# Stripe : placeholders non secrètes, vraies clés dans .env.local
STRIPE_SECRET_KEY=sk_test_remplacer
STRIPE_WEBHOOK_SECRET=whsec_remplacer
STRIPE_SUCCESS_URL='https://geomonkey.fr/inscription/success'
STRIPE_CANCEL_URL='https://geomonkey.fr/inscription/cancel'
STRIPE_DONATION_SUCCESS_URL='https://geomonkey.fr/don/success'
STRIPE_DONATION_CANCEL_URL='https://geomonkey.fr/don/cancel'

# Divers : valeurs par défaut du site
CONTACT_EMAIL=contact@geomonkey.fr
MAIL_FROM_ADDRESS=noreply@geomonkey.fr
WHATSAPP_GROUP_LINK=https://example.invalid

# Messagerie GMX : host/port/encryption non secrètes par défaut,
# identifiants réels dans .env.local
MAILBOX_HOST=mail.gmx.net
MAILBOX_PORT=993
MAILBOX_USER=
MAILBOX_PASSWORD=
MAILBOX_ENCRYPTION=ssl
