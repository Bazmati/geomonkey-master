###> symfony/framework-bundle ###
APP_ENV=dev
APP_DEBUG=1
# Valeur factice : la vraie clé de prod est dans le .env.local du CT 202
APP_SECRET=remplacer_par_une_vrai_cle_local
###< symfony/framework-bundle ###

###> doctrine (défaut dev local ; la prod a le sien dans .env.local) ###
DATABASE_URL=postgresql://app:!ChangeMe!@127.0.0.1:5432/db?serverVersion=15&charset=utf8
###< doctrine ###

###> symfony/messenger ###
# dev = sync par défaut (aucune table messenger nécessaire)
MESSENGER_TRANSPORT_DSN=sync://
###< symfony/messenger ###

###> symfony/mailer ###
MAILER_DSN=null://default
###< symfony/mailer ###