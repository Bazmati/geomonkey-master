# Exemple de fichier .env.local pour le développement
# Copier ce fichier en .env.local et adapter les valeurs

###> stripe ###
# Clé secrète Stripe (mode test)
STRIPE_SECRET_KEY=sk_test_your_stripe_test_key

# URLs de redirection après paiement
STRIPE_SUCCESS_URL=http://localhost:8000/inscription/success
STRIPE_CANCEL_URL=http://localhost:8000/inscription/cancel
STRIPE_DONATION_SUCCESS_URL=http://localhost:8000/don/success
STRIPE_DONATION_CANCEL_URL=http://localhost:8000/don/cancel
# (en production : https://www.geomonkey.fr/don/success et /don/cancel)

# Secret du webhook (à récupérer depuis le tableau de bord Stripe)
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
###< stripe ###

###> application ###
# Email de contact pour les alertes (ex: nouvelle demande d'adhésion)
CONTACT_EMAIL=test@local.fr

# Lien du groupe WhatsApp pour les membres
WHATSAPP_GROUP_LINK=https://chat.whatsapp.com/your-group-invite-link

# Pour le développement avec Mailer (optionnel)
# MAILER_DSN=smtp://user:pass@smtp.example.com:587
###< application ###

APP_DEBUG=true
###> production ###
# --- En production (VPS) ---
# APP_ENV=prod
# APP_DEBUG=0
#
# MAILER_DSN=smtp://user:pass@smtp.tonfournisseur.fr:587
#   (ou gmail://... / sendmail://default — indispensable pour les mails
#    d'adhésion, de don et de newsletter)
#
# Sauvegardes : voir scripts/backup.sh (cron quotidien recommandé)
###< production ###
